import "./schedule_kernels";
import "@arena";
import "@process";
import "@std";
import "@strings";

def evaluate32(mode: string, value: f32) -> f32 {
    if strings.equal(mode, "overlap_eight") { return schedule_kernels.overlap_eight32(value, 2.0, 8, 0); }
    if strings.equal(mode, "eight") { return schedule_kernels.eight32(value, 2.0, 8, 7); }
    if strings.equal(mode, "eight_first") { return schedule_kernels.eight32(value, 2.0, 8, 0); }
    if strings.equal(mode, "fixed16") { return schedule_kernels.fixed1632(value, 2.0, 16, 15); }
    if strings.equal(mode, "fixed17") { return schedule_kernels.fixed1732(value, 2.0, 17, 16); }
    if strings.equal(mode, "fixed32") { return schedule_kernels.fixed3232(value, 2.0, 32, 31); }
    if strings.equal(mode, "small") { return schedule_kernels.small32(value, 2.0, 4, 3); }
    if strings.equal(mode, "large") { return schedule_kernels.large32(value, 2.0, 64, 63); }
    if strings.equal(mode, "dynamic") { return schedule_kernels.dynamic32(value, 2.0, 32, 31); }
    if strings.equal(mode, "heavy") { return schedule_kernels.heavy32(value, 2.0, 32, 31); }
    if strings.equal(mode, "first") { return schedule_kernels.fixed1632(value, 2.0, 16, 0); }
    if strings.equal(mode, "overlap_fixed") { return schedule_kernels.overlap_fixed32(value, 2.0, 16, 0); }
    if strings.equal(mode, "signedzero") { return schedule_kernels.fixed1632(value, 1.0, 16, 15); }
    if strings.equal(mode, "underflow") { return schedule_kernels.fixed1632(value, 0.5, 16, 15); }
    if strings.equal(mode, "rounding") { return schedule_kernels.rounding32(value, 0.9999998807907104); }

    return value * 2.0;
}

def evaluate64(mode: string, value: f64) -> f64 {
    if strings.equal(mode, "overlap_eight") { return schedule_kernels.overlap_eight64(value, 2.0, 8, 0); }
    if strings.equal(mode, "eight") { return schedule_kernels.eight64(value, 2.0, 8, 7); }
    if strings.equal(mode, "eight_first") { return schedule_kernels.eight64(value, 2.0, 8, 0); }
    if strings.equal(mode, "fixed16") { return schedule_kernels.fixed1664(value, 2.0, 16, 15); }
    if strings.equal(mode, "fixed17") { return schedule_kernels.fixed1764(value, 2.0, 17, 16); }
    if strings.equal(mode, "fixed32") { return schedule_kernels.fixed3264(value, 2.0, 32, 31); }
    if strings.equal(mode, "small") { return schedule_kernels.small64(value, 2.0, 4, 3); }
    if strings.equal(mode, "large") { return schedule_kernels.large64(value, 2.0, 64, 63); }
    if strings.equal(mode, "dynamic") { return schedule_kernels.dynamic64(value, 2.0, 32, 31); }
    if strings.equal(mode, "heavy") { return schedule_kernels.heavy64(value, 2.0, 32, 31); }
    if strings.equal(mode, "first") { return schedule_kernels.fixed1664(value, 2.0, 16, 0); }
    if strings.equal(mode, "overlap_fixed") { return schedule_kernels.overlap_fixed64(value, 2.0, 16, 0); }
    if strings.equal(mode, "signedzero") { return schedule_kernels.fixed1664(value, 1.0, 16, 15); }
    if strings.equal(mode, "underflow") { return schedule_kernels.fixed1664(value, 0.5, 16, 15); }
    if strings.equal(mode, "rounding") { return schedule_kernels.rounding64(value, 0.9999999999999998); }

    return value * 2.0;
}

def main() -> i32 {
    if process.arg_count() != 4 { return 2; }

    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def width: result<string> = process.arg(&owner, 1);
    if width.erroneous { return 2; }

    def mode: result<string> = process.arg(&owner, 2);
    if mode.erroneous { return 2; }

    def text: result<string> = process.arg(&owner, 3);
    if text.erroneous { return 2; }

    if strings.equal(width.value, "64") {
        def parsed: result<f64> = std.parse_f64(text.value);
        if parsed.erroneous { return 2; }

        def computed: f64             = evaluate64(mode.value, parsed.value);
        def formatted: result<string> = std.format_f64(&owner, computed);

        if formatted.erroneous { return 1; }

        std.println(formatted.value);
    } else {
        def parsed: result<f32> = std.parse_f32(text.value);
        if parsed.erroneous { return 2; }

        def computed: f32             = evaluate32(mode.value, parsed.value);
        def formatted: result<string> = std.format_f32(&owner, computed);

        if formatted.erroneous { return 1; }

        std.println(formatted.value);
    }

    return 0;
}
