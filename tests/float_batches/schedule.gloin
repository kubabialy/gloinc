import "@arena";
import "@process";
import "@std";
import "@strings";
import "@time";

def cleanup_child(child: &process.Child) -> void {
    def closed: result<void> = child.close();
    if closed.erroneous { std.println(closed.error.message); }
}

def reference_trap(executable: string, fixture: string, width: string, value: string) -> i32 {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def native_args: [string; 3] = {width, "control", value};
    def jit_args: [string; 6]    = {"--jit", fixture, "--", width, "control", value};
    def mut args: [const string] = native_args[..];

    if !strings.is_empty(fixture) { args = jit_args[..]; }

    def started: result<process.Child> = process.start_piped(&owner, executable, args);

    if started.erroneous { std.println(started.error.message); return 0; }

    def mut child: process.Child = started.value;
    defer cleanup_child(&child);

    def input: [u8; 0]                   = zeroed;
    def mut output: [u8; 1024]           = zeroed;
    def mut errors: [u8; 4096]           = zeroed;
    def captured: result<process.Output> = child.communicate(input[..], output[..], errors[..], time.Duration {nanoseconds: 10000000000});

    if captured.erroneous { std.println(captured.error.message); return 0; }

    def outcome: process.Output = captured.value;
    def zero: u64               = 0;

    if outcome.status.exited || outcome.status.signal == 0 || outcome.stdout.len != zero || outcome.stderr.len != zero { return 0; }

    return outcome.status.signal;
}

def invoke_finite(executable: string, fixture: string, width: string, mode: string, value: string, expected: string, trap: bool) -> bool {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def native_args: [string; 3] = {width, mode, value};
    def jit_args: [string; 6]    = {"--jit", fixture, "--", width, mode, value};
    def mut args: [const string] = native_args[..];

    if !strings.is_empty(fixture) { args = jit_args[..]; }

    def started: result<process.Child> = process.start_piped(&owner, executable, args);

    if started.erroneous { std.println(started.error.message); return false; }

    def mut child: process.Child = started.value;
    defer cleanup_child(&child);

    def input: [u8; 0]                   = zeroed;
    def mut output: [u8; 1024]           = zeroed;
    def mut errors: [u8; 4096]           = zeroed;
    def captured: result<process.Output> = child.communicate(input[..], output[..], errors[..], time.Duration {nanoseconds: 10000000000});

    if captured.erroneous { std.println(captured.error.message); return false; }

    def outcome: process.Output = captured.value;
    def zero: u64               = 0;

    if trap {
        def signal: i32 = reference_trap(executable, fixture, width, value);

        return signal != 0 && !outcome.status.exited && outcome.status.signal == signal && strings.equal(strings.view_bytes(outcome.stdout), expected) && outcome.stderr.len == zero;
    }

    def ok: bool = outcome.status.success() && strings.equal(strings.view_bytes(outcome.stdout), expected) && outcome.stderr.len == zero;
    if !ok { std.println(width); std.println(mode); std.println(value); std.println(strings.view_bytes(outcome.stdout)); std.println(expected); }

    return ok;
}

def suite(executable: string, fixture: string) -> bool {
    def widths: [string; 2]    = {"32", "64"};
    def modes: [string; 13]    = {"fixed16", "fixed17", "fixed32", "small", "large", "dynamic", "heavy", "overlap_fixed", "first", "signedzero", "eight", "eight_first", "overlap_eight"};
    def expected: [string; 13] = {"6\n", "6\n", "6\n", "6\n", "6\n", "6\n", "1024\n", "196608\n", "6\n", "3\n", "6\n", "6\n", "768\n"};

    for def mut w: u64 = 0; w < 2; w = w + 1 {
        def mut huge: string = "1e308";
        if w == 0 { huge = "3e38"; }

        for def mut i: u64 = 0; i < 13; i = i + 1 {
            if !invoke_finite(executable, fixture, widths[w], modes[i], "3", expected[i], false) { return false; }
            if i != 9 && !invoke_finite(executable, fixture, widths[w], modes[i], huge, "", true) { return false; }
        }

        if !invoke_finite(executable, fixture, widths[w], "signedzero", "-0", "-0\n", false)
            || !invoke_finite(executable, fixture, widths[w], "signedzero", "0", "0\n", false)
            || !invoke_finite(executable, fixture, widths[w], "fixed16", "2000", "1024\n", false)
            || !invoke_finite(executable, fixture, widths[w], "fixed16", "-2000", "-1024\n", false) { return false; }
    }

    if !invoke_finite(executable, fixture, "32", "rounding", "1.0000001192092896", "0\n", false)
        || !invoke_finite(executable, fixture, "64", "rounding", "1.0000000000000002", "0\n", false)
        || !invoke_finite(executable, fixture, "32", "underflow", "1.401298464324817e-45", "0\n", false)
        || !invoke_finite(executable, fixture, "64", "underflow", "4.9406564584124654e-324", "0\n", false) { return false; }

    std.println("62 scheduling execution cases passed"); return true;
}

def occurrences(text: string, needle: string) -> u64 {
    def mut rest: string              = text;
    def mut count: u64                = 0;
    def mut found: strings.FindResult = strings.find(rest, needle);

    while found.found {
        count = count + 1;

        def start: u64           = found.offset + strings.byte_length(needle);
        def next: result<string> = strings.slice_bytes(rest, start, strings.byte_length(rest) - start);

        if next.erroneous { return 999; }

        rest  = next.value;
        found = strings.find(rest, needle);
    }

    return count;
}

def structure(compiler: string, source: string) -> bool {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def args: [string; 2]              = {"--emit-llvm", source};
    def started: result<process.Child> = process.start_piped(&owner, compiler, args[..]);

    if started.erroneous { return false; }

    def mut child: process.Child = started.value;
    defer cleanup_child(&child);

    def input: [u8; 0]                   = zeroed;
    def mut output: [u8; 1048576]        = zeroed;
    def mut errors: [u8; 4096]           = zeroed;
    def captured: result<process.Output> = child.communicate(input[..], output[..], errors[..], time.Duration {nanoseconds: 30000000000});

    if captured.erroneous { std.println(captured.error.message); return false; }

    def outcome: process.Output = captured.value;
    if !outcome.status.success() { std.println(strings.view_bytes(outcome.stderr)); return false; }

    def ir: string           = strings.view_bytes(outcome.stdout);
    def names: [string; 12]  = {"fixed16", "fixed17", "fixed32", "small", "large", "dynamic", "overlap_fixed", "heavy", "eight", "seven", "nine", "overlap_eight"};
    def expected: [bool; 12] = {true, true, true, false, false, false, true, false, true, false, false, true};
    def widths: [string; 2]  = {"32(", "64("};

    for def mut w: u64 = 0; w < 2; w = w + 1 {
        for def mut i: u64 = 0; i < 12; i = i + 1 {
            def name: result<string> = strings.concat(&owner, names[i], widths[w], 128);
            if name.erroneous { return false; }

            def marker: result<string> = strings.concat(&owner, "llvm.func @", name.value, 128);
            if marker.erroneous { return false; }

            def start: strings.FindResult = strings.find(ir, marker.value);
            if !start.found { std.println(marker.value); return false; }

            def tail: result<string> = strings.slice_bytes(ir, start.offset, strings.byte_length(ir) - start.offset);
            if tail.erroneous { return false; }

            def end: strings.FindResult = strings.find(tail.value, "\n  }");
            if !end.found { return false; }

            def body: result<string> = strings.slice_bytes(tail.value, 0, end.offset);
            if body.erroneous { return false; }

            def has_batch: bool = occurrences(body.value, "loop_annotation =") == 1;
            if has_batch != expected[i] { std.println(name.value); std.println(body.value); return false; }

        }
    }

    std.println("24 scheduling structure cases passed");

    return true;
}

def main() -> i32 {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def executable: result<string> = process.arg(&owner, 1);
    if executable.erroneous { return 2; }

    if strings.equal(executable.value, "--structure") {
        def compiler: result<string> = process.arg(&owner, 2);
        if compiler.erroneous { return 2; }

        def source: result<string> = process.arg(&owner, 3);
        if source.erroneous { return 2; }
        if !structure(compiler.value, source.value) { return 1; }

        return 0;
    }

    def mut fixture: string = "";

    if process.arg_count() == 3 {
        def path: result<string> = process.arg(&owner, 2);
        if path.erroneous { return 2; }

        fixture = path.value;
    }

    if !suite(executable.value, fixture) { std.println("finite arithmetic fixtures failed"); return 1; }

    std.println("finite arithmetic fixtures passed");

    return 0;
}
