def pub fixed1632(value: f32, scale: f32, n: u64, lane: u64) -> f32 {
    def mut data: [f32; 16] = zeroed;
    data[lane] = value;

    for def mut i: u64 = 0; i < 16; i = i + 1 {
        def mut x: f32 = data[i] * scale;

        if x > 1024.0 { x = 1024.0; }
        else if x < -1024.0 { x = -1024.0; }

        data[i] = x;
    }

    return data[lane];
}

