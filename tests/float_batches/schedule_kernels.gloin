        data[i] = x; x = data[i] * scale;
        data[i] = x; x = data[i] * scale;
        data[i] = x; x = data[i] * scale;

        if x > 1024.0 { x = 1024.0; }
        else if x < -1024.0 { x = -1024.0; }

        data[i] = x;
    }

    return data[lane];
}

def pub overlap_fixed32(value: f32, scale: f32, n: u64, lane: u64) -> f32 {
    def mut data: [f32; 17] = zeroed; data[0] = value;

    def input: [const f32] = data[0..16]; def output: [f32] = data[1..17];

    for def mut i: u64 = 0; i < 16; i = i + 1 { output[i] = input[i] * scale; }

    return data[16];
}

def pub rounding32(value: f32, factor: f32) -> f32 {
    def mut data: [f32; 16] = zeroed;

    for def mut i: u64 = 0; i < 16; i = i + 1 { data[i] = value * factor - 1.0; }

    return data[15];
}

