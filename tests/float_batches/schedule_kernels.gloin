def pub heavy32(value: f32, scale: f32, n: u64, lane: u64) -> f32 {
    def mut data: [f32; 32] = zeroed;
    data[lane] = value;

    for def mut i: u64 = 0; i < 32; i = i + 1 {
        def mut x: f32 = data[i] * scale;
        data[i] = x; x = data[i] * scale;
        data[i] = x; x = data[i] * scale;
