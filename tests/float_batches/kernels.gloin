}

def pub integer64(value: f64, addend: u64, n: u64) -> f64 {
    def mut data: [f64; 16] = zeroed;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        data[i] = value * 2.0;

        def checked: u64 = i + addend;
    }

    return data[0];
}

// Combining moves the producer check onto its formerly safe consumer.
def pub anchored32(value: f32, n: u64) -> f32 {
    def mut data: [f32; 16] = zeroed;
    def two: f32            = 2.0;
    def half: f32           = 0.5;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        if value > 0.0 { data[i] = (value * two) * half; }
    }

    return 0.0;
}

// Combining moves the producer check onto its formerly safe consumer.
def pub anchored64(value: f64, n: u64) -> f64 {
    def mut data: [f64; 16] = zeroed;
    def two: f64            = 2.0;
    def half: f64           = 0.5;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        if value > 0.0 { data[i] = (value * two) * half; }
    }

    return 0.0;
}

def pub combined32(value: f32, other: f32, n: u64) -> f32 {
    def mut data: [f32; 16] = zeroed;
    def mut copy: [f32; 16] = zeroed;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        def p: f32 = value * 2.0;
        data[i] = p;

        def q: f32 = p + other;
        copy[i] = p;
        data[i] = q;
    }

    return data[0];
}

def pub zero_sink32(value: f32, other: f32, n: u64) -> f32 {
    def mut data: [f32; 16] = zeroed;
    def mut copy: [f32; 16] = zeroed;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        def p: f32 = value * 2.0;
        data[i] = p;
        data[i] = p * other;
    }

    return data[0];
}

def pub masked32(value: f32, other: f32, n: u64) -> f32 {
    def mut data: [f32; 16] = zeroed;
    def mut copy: [f32; 16] = zeroed;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        def mut p: f32 = value * 2.0;
        data[i] = p;
        if p > 1024.0 { p = 0.0; }

        data[i] = p + other;
    }

    return data[0];
}

def pub independent32(value: f32, other: f32, n: u64) -> f32 {
    def mut data: [f32; 16] = zeroed;
    def mut copy: [f32; 16] = zeroed;

    for def mut i: u64 = 0; i < n; i = i + 1 {
        def p: f32 = value * 2.0;
        data[i] = p;

        def q: f32 = other * 3.0;
        data[i] = q;
    }

    return data[0];
}

