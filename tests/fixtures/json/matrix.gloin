// Fixed independent JSON/UTF-8 corpus; see README.md for provenance.
import "@json"; import "@strings"; import "@std";

def document_0() -> bool {
    def bytes: [u8; 4] = {110, 117, 108, 108};

    def text: string          = strings.view_bytes(bytes[..]);
    def checked: result<void> = json.validate(text, 16384, 64);

    if checked.erroneous { return false; }

    return true;
}

