def identity(x: u64) -> u64 { return x; }
def arithmetic(x: u64, y: u64) -> bool {
    if x + y != 10 || x - y != 4 || x * y != 21 { return false; }
    if x / y != 2 || x % y != 1 { return false; }
    if !(x > y) || !(x >= y) || !(y < x) || !(y <= x) { return false; }
    if x == y || x != x || !(x >= x) || !(y <= y) { return false; }
    return true;
}
def main() -> i32 {
    def low: u64 = identity(0);
    def high: u64 = identity(18446744073709551615);
    if low != 0 || high != 18446744073709551615 || !(low < high) { return -1; }
    if !arithmetic(7, 3) { return -2; }
    return 42;
}
