def identity(x: u8) -> u8 { return x; }
def arithmetic(x: u8, y: u8) -> bool {
    if x + y != 10 || x - y != 4 || x * y != 21 { return false; }
    if x / y != 2 || x % y != 1 { return false; }
    if !(x > y) || !(x >= y) || !(y < x) || !(y <= x) { return false; }
    if x == y || x != x || !(x >= x) || !(y <= y) { return false; }
    return true;
}
def main() -> i32 {
    def low: u8 = identity(0);
    def high: u8 = identity(255);
    if low != 0 || high != 255 || !(low < high) { return -1; }
    if !arithmetic(7, 3) { return -2; }
    return 42;
}
