def identity(x: i8) -> i8 {
    return x;
}

def arithmetic(x: i8, y: i8) -> bool {
    if x + y != 10 || x - y != 4 || x * y != 21 { return false; }
    if x / y != 2 || x % y != 1 { return false; }
    if !(x > y) || !(x >= y) || !(y < x) || !(y <= x) { return false; }
    if x == y || x != x || !(x >= x) || !(y <= y) { return false; }
    if -x != -7 || -x / y != -2 || -x % y != -1 { return false; }
    return true;
}

def main() -> i32 {
    def low: i8 = identity(-128);
    def high: i8 = identity(127);
    if low != -128 || high != 127 || !(low < high) { return -1; }
    if !arithmetic(7, 3) { return -2; }
    return 42;
}
