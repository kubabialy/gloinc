def main() -> i32 {
    def mut count: i32 = 0;
    def enabled: bool = true;
    if enabled {
        for def mut i: i32 = 0; i < 3; i = i + 1 {
            count = count + 1;
        }
    } else {
        return -1;
    }
    unless count == 3 {
        return -1;
    }
    while count > 3 {
        count = count - 1;
    }
    return count;
}
