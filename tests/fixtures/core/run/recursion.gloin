def factorial(n: i32) -> i32 {
    if n <= 1 { return 1; }
    return n * factorial(n - 1);
}
def even(n: i32) -> bool { if n == 0 { return true; } return odd(n - 1); }
def odd(n: i32) -> bool { if n == 0 { return false; } return even(n - 1); }
def main() -> i32 {
    if even(10) && odd(9) { return factorial(5); }
    return -1;
}
