def packed struct(msb_first) Word {
    def value: be_u16,
}

def add_one(value: &i32) -> void { *value = *value + 1; }

def identity<T>(value: T) -> T { return value; }

def triangular(x: i32) -> i32 {
    if x == 0 { return 0; }

    return x + triangular(x - 1);
}

def spawnable work(word: Word, n: i32) -> result<i32> {
    if word.value != 0x0102 { return error("unexpected word", 37, 9); }

    def mut answer: i32 = identity<i32>(triangular(n));

    add_one(&answer);

    return answer;
}

def main() -> i32 {
    def good: result<i32> = work(Word { value: 0x0102 }, 3);
    if good.erroneous { return 1; }
    if good.value != 7 { return 2; }

    def bad: result<i32> = work(Word { value: 0 }, 3);
    if !bad.erroneous { return 3; }
    if bad.error.code != 37 || bad.error.os_error != 9 { return 4; }

    return 42;
}
