import "@std";
import "@arena";

def main() -> i32 {
    def mut memory: arena.GeneralArena = arena.GeneralArena.create();
    defer memory.free();

    def number: result<i32> = std.to_int("+00042");
    if number.erroneous { return 1; }

    def text: result<string> = std.to_string(&memory, number.value);
    if text.erroneous { return 2; }

    std.println(text.value);

    return 0;
}
