def trap() -> void { def x: i32 = 1 / 0; }
def omitted() -> i32 { for ;; { return 42; } return -1; }
def early() -> i32 { for ;; trap() { return 7; } return -1; }
def main() -> i32 {
    def mut i: i32 = 0;
    def mut total: i32 = 0;
    for ; i < 3; { total = total + i; i = i + 1; }
    for i = 0; i < 3; i = i + 1 { total = total + i; }
    for def mut i: i32 = 0; false; i = i + 1 { trap(); }
    if i != 3 || total != 6 || early() != 7 { return -1; }
    return omitted();
}
