def identity(x: i64) -> i64 { return x; }
def arithmetic(x: i64, y: i64) -> bool {
    if x + y != 10 || x - y != 4 || x * y != 21 { return false; }
    if x / y != 2 || x % y != 1 { return false; }
    if !(x > y) || !(x >= y) || !(y < x) || !(y <= x) { return false; }
    if x == y || x != x || !(x >= x) || !(y <= y) { return false; }
    if -x != -7 || -x / y != -2 || -x % y != -1 { return false; }
    return true;
}
def main() -> i32 {
    def low: i64 = identity(-9223372036854775808);
    def high: i64 = identity(9223372036854775807);
    if low != -9223372036854775808 || high != 9223372036854775807 || !(low < high) { return -1; }
    if !arithmetic(7, 3) { return -2; }
    return 42;
}
