import "@arena";
import "@process";
import "@status";
import "@std";
import "@strings";

def main() -> i32 {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def mode: result<string> = process.arg(&owner, 1);
    if mode.erroneous { return 80; }

    if strings.equal(mode.value, "descendant") {
        def args: [string; 1]              = {"30"};
        def started: result<process.Child> = process.start(&owner, "/bin/sleep", args[..]);

        if started.erroneous { return 81; }

        // Intentionally leave a descendant holding inherited output pipes.
        // The parent fixture owns this entire process group and must clean it up.
        std.print("held");

        return 37;
    }

    def cwd: result<string> = process.cwd(&owner, 4096);
    if cwd.erroneous { return 82; }

    def value: result<string> = process.env(&owner, "GLOIN_VALUE");
    if value.erroneous { return 82; }

    def empty: result<string> = process.env(&owner, "GLOIN_EMPTY");
    if empty.erroneous { return 82; }

    def absent: result<string> = process.env(&owner, "GLOIN_PARENT_ONLY");

    if !absent.erroneous { return 83; }
    if absent.error.code != status.NOT_FOUND { return 83; }
    if !strings.equal(value.value, "hello = café") || !strings.is_empty(empty.value) { return 84; }

    std.print(cwd.value);

    return 37;
}
