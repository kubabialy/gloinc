import "@arena";
import "@process";
import "@status";
import "@strings";
import "@time";

def cleanup(child: &process.Child) -> void {
    def closed: result<void> = child.close();
    if closed.erroneous { return; }
}

def main() -> i32 {
    def mut memory: arena.GeneralArena = arena.GeneralArena.create();
    defer memory.free();

    def peer: process.TextResult = process.arg(&memory, 1);
    def hard: process.TextResult = process.arg(&memory, 2);

    if peer.status != status.OK || hard.status != status.OK { return 1; }

    def args: [string; 5]            = {"limits", "2097152", hard.value, "-1", "1"};
    def mut options: process.Options = process.Options.defaults();
    options.piped             = true;
    options.new_process_group = true;
    options.stack_limit_bytes = 2097152;

    def started: result<process.Child> = process.start_with(&memory, peer.value, args[..], options);
    if started.erroneous { return 2; }

    def mut child: process.Child = started.value;
    defer cleanup(&child);

    def input: [u8; 0]                   = zeroed;
    def mut output: [u8; 32]             = zeroed;
    def mut errors: [u8; 32]             = zeroed;
    def captured: result<process.Output> = child.communicate(input[..], output[..], errors[..], time.Duration { nanoseconds: 5000000000 });

    if captured.erroneous { return 3; }
    if !captured.value.status.exited || captured.value.status.code != 37 { return 4; }
    if !strings.equal(strings.view_bytes(captured.value.stdout), "limits verified\n") { return 5; }
    if !strings.is_empty(strings.view_bytes(captured.value.stderr)) { return 6; }

    return 0;
}
