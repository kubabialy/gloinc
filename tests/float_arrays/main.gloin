        Case { name: "poison-select", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n%condition = llvm.mlir.poison : i1\n%selected = arith.select %condition, %unit, %z : $F\n\"gloin.store\"(%selected, %p) <{source_type = $F}> : ($F, !llvm.ptr) -> ()\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant 4.0 : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 1, trap: false, execute: false },
        Case { name: "frozen-select", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n%condition = llvm.mlir.poison : i1\n%stable = llvm.freeze %condition : i1\n%selected = arith.select %stable, %unit, %z : $F\n\"gloin.store\"(%selected, %p) <{source_type = $F}> : ($F, !llvm.ptr) -> ()\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant 4.0 : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 0, trap: false, execute: false }
    };
    def widths: [string; 2]     = {"f32", "f64"};
    def integers: [string; 2]   = {"i32", "i64"};
    def extremes: [string; 2]   = {"3.0e38", "1.0e308"};
    def nans: [string; 2]       = {"0x7FC00000", "0x7FF8000000000000"};
    def infinities: [string; 2] = {"0x7F800000", "0x7FF0000000000000"};

    for def mut w: u64 = 0; w < 2; w = w + 1 {
        for def mut i: u64 = 0; i < 32; i = i + 1 {
            def item: Case                = cases[i];
            def replacements: [string; 5] = {"$HUGE", "$NAN", "$INF", "$F", "$I"};
            def values: [string; 5]       = {extremes[w], nans[w], infinities[w], widths[w], integers[w]};
            def mut text: string          = item.body;

            for def mut j: u64 = 0; j < 5; j = j + 1 {
                def replaced: result<string> = strings.replace_all(memory, text, replacements[j], values[j], 65536);
                if replaced.erroneous { return false; }

                text = replaced.value;
            }

            def name: result<string> = strings.concat(memory, item.name, widths[w], 256);
            if name.erroneous { return false; }

            def recorded: result<void> = tool_runner.record(memory, work, name.value, ".mlir", text);
            if recorded.erroneous { std.println(recorded.error.message); return false; }

            def leaf: result<string> = strings.concat(memory, name.value, ".mlir", 256);
            if leaf.erroneous { return false; }

            def input: result<string> = tool_runner.joined(memory, work, leaf.value);
            if input.erroneous { return false; }

            def output_leaf: result<string> = strings.concat(memory, name.value, ".lowered", 256);
            if output_leaf.erroneous { return false; }

            def output: result<string> = tool_runner.joined(memory, work, output_leaf.value);
            if output.erroneous { return false; }

            def emit_args: [string; 3]    = {"emit", input.value, output.value};
            def emitted: result<Captured> = capture(memory, bridge, emit_args[..]);

            if emitted.erroneous { std.println(emitted.error.message); return false; }
            if !emitted.value.success { std.println(name.value); return false; }

            def lowered: result<string> = common.read(memory, output.value, 262144);
            if lowered.erroneous { return false; }

            if occurrences(lowered.value, "llvm.fcmp \"oge\"") != item.predicates { std.println(name.value); std.println(lowered.value); return false; }

            if item.execute {
                def program: result<string> = tool_runner.joined(memory, work, name.value);
                if program.erroneous { return false; }

                def args: [string; 3]          = {mode, input.value, program.value};
                def compiled: result<Captured> = capture(memory, bridge, args[..]);

                if compiled.erroneous { std.println(compiled.error.message); return false; }
                if !compiled.value.success { std.println(name.value); return false; }

                def executed: result<Captured> = capture(memory, program.value, empty[..]);
                if executed.erroneous { return false; }

                def outcome: Captured = executed.value;
                if !strings.is_empty(outcome.text) { return false; }

                if item.trap { if outcome.signal != expected_signal { std.println(name.value); return false; } }
                else { if !outcome.success { std.println(name.value); return false; } }
            }
        }
    }

    std.println("64 array-range structure cases and supported execution cases passed");

    return true;
}

def main() -> i32 {
    def mut memory: arena.GeneralArena = arena.GeneralArena.create();
    defer memory.free();

    def bridge: result<string> = process.arg(&memory, 1);
    if bridge.erroneous { return 2; }

    def mode: result<string> = process.arg(&memory, 2);
    if mode.erroneous { return 2; }

    def parent: result<string> = process.arg(&memory, 3);
    if parent.erroneous { return 2; }

    def created: result<string> = fs.temp_dir(&memory, parent.value, "float-array-ranges", 65536);
    if created.erroneous { std.println(created.error.message); return 2; }

    def work: string = created.value;
    defer cleanup_tree(work);

    if !suite(&memory, bridge.value, mode.value, work) { return 1; }

    return 0;
}
