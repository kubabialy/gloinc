import "@arena";
import "@fs";
import "@process";
import "@std";
import "@strings";
import "@time";
import "../support/tool_runner";
import "../../tools/checks/common";

// Exercise interval proofs, joins through private storage, and conservative rejection.
def struct Case { def name: string, def body: string, def predicates: u64, def trap: bool, def execute: bool, }

def struct Captured { def success: bool, def signal: i32, def text: string, }

def cleanup_child(child: &process.Child) -> void {
    def closed: result<void> = child.close();
    if closed.erroneous { std.println(closed.error.message); }
}

def capture(memory: &arena.GeneralArena, executable: string, args: [const string]) -> result<Captured> {
    def started: result<process.Child> = process.start_piped(memory, executable, args);
    if started.erroneous { return started.error; }

    def mut child: process.Child = started.value;
    defer cleanup_child(&child);

    def input: [u8; 0]                   = zeroed;
    def mut output: [u8; 1024]           = zeroed;
    def mut errors: [u8; 8192]           = zeroed;
    def captured: result<process.Output> = child.communicate(input[..], output[..], errors[..], time.Duration {nanoseconds: 30000000000});

    if captured.erroneous { return captured.error; }

    def outcome: process.Output = captured.value;
    def zero: u64               = 0;

    if outcome.stderr.len > zero { std.println(strings.view_bytes(outcome.stderr)); }

    def text: result<string> = strings.concat(memory, strings.view_bytes(outcome.stdout), "", 1024);
    if text.erroneous { return text.error; }

    return Captured { success: outcome.status.success(), signal: outcome.status.signal, text: text.value };
}

def cleanup_tree(path: string) -> void {
    def removed: result<void> = tool_runner.remove_fixture_tree(path, 8);
    if removed.erroneous { std.println(removed.error.message); }
}

def occurrences(text: string, needle: string) -> u64 {
    def mut rest: string              = text;
    def mut count: u64                = 0;
    def mut found: strings.FindResult = strings.find(rest, needle);

    while found.found {
        count = count + 1;

        def start: u64           = found.offset + strings.byte_length(needle);
        def next: result<string> = strings.slice_bytes(rest, start, strings.byte_length(rest) - start);

        if next.erroneous { return 999; }

        rest  = next.value;
        found = strings.find(rest, needle);
    }

    return count;
}

def suite(memory: &arena.GeneralArena, bridge: string, mode: string, work: string) -> bool {
    def control: string     = "module { func.func @main() -> i32 { \"llvm.intr.trap\"() : () -> () llvm.unreachable } }";
    def saved: result<void> = tool_runner.record(memory, work, "control", ".mlir", control);

    if saved.erroneous { std.println(saved.error.message); return false; }

    def source: result<string> = tool_runner.joined(memory, work, "control.mlir");
    if source.erroneous { return false; }

    def binary: result<string> = tool_runner.joined(memory, work, "control");
    if binary.erroneous { return false; }

    def build_control: [string; 3] = {mode, source.value, binary.value};
    def built: result<Captured>    = capture(memory, bridge, build_control[..]);

    if built.erroneous { std.println(built.error.message); return false; }
    if !built.value.success { return false; }

    def empty: [string; 0]    = {};
    def ran: result<Captured> = capture(memory, binary.value, empty[..]);

    if ran.erroneous { return false; }

    def expected_signal: i32 = ran.value.signal;
    if expected_signal == 0 { return false; }

    def cases: [Case; 32] = {
        Case { name: "zero", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant 4.0 : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 0, trap: false, execute: true },
        Case { name: "literal", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = \"gloin.array_literal\"(%unit, %unit, %unit, %unit) <{source_type = !gloin.array<$F, 4>, layout_type = !llvm.array<4 x $F>}> : ($F, $F, $F, $F) -> !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant 4.0 : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 2.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 0, trap: false, execute: true },
        Case { name: "fill", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n\"gloin.array_fill\"(%a, %unit) <{source_type = !gloin.array<$F, 4>, layout_type = !llvm.array<4 x $F>, element_type = $F, element_source_type = $F}> : (!llvm.ptr, $F) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant 4.0 : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 2.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 0, trap: false, execute: true },
        Case { name: "unknown-write", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n\"gloin.store\"(%input, %p) <{source_type = $F}> : ($F, !llvm.ptr) -> ()\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant $HUGE : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 1, trap: true, execute: true },
        Case { name: "raw-store", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\nllvm.store %input, %p : $F, !llvm.ptr\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant $HUGE : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 1, trap: true, execute: true },
        Case { name: "alias-write", body: "module  {\n\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n%alias = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\n\"gloin.store\"(%input, %alias) <{source_type = $F}> : ($F, !llvm.ptr) -> ()\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant $HUGE : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 1, trap: true, execute: true },
        Case { name: "escape", body: "module  {\nfunc.func @mutate(%p: !llvm.ptr, %x: $F) { llvm.store %x, %p : $F, !llvm.ptr return }\nfunc.func @kernel(%input: $F) -> $F {\n%a = \"gloin.stack_alloc\"() <{element_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : () -> !llvm.ptr\n%zero = arith.constant 0 : i64\n%one = arith.constant 1 : i64\n%limit = arith.constant 8 : i64\n%z = arith.constant 0.0 : $F\n%unit = arith.constant 1.0 : $F\n%two = arith.constant 2.0 : $F\n%half = arith.constant 0.5 : $F\n%negative = arith.constant -1.0 : $F\n%huge = arith.constant $HUGE : $F\n%init = llvm.mlir.zero : !llvm.array<4 x $F>\n\"gloin.store\"(%init, %a) <{source_type = !gloin.array<$F, 4>}> : (!llvm.array<4 x $F>, !llvm.ptr) -> ()\n%p = \"gloin.array_element_address\"(%a, %zero) <{array_type = !llvm.array<4 x $F>, source_type = !gloin.array<$F, 4>}> : (!llvm.ptr, i64) -> !llvm.ptr\nfunc.call @mutate(%p, %input) : (!llvm.ptr, $F) -> ()\n%x = \"gloin.load\"(%p) <{source_type = $F, layout_type = $F}> : (!llvm.ptr) -> $F\n%result = \"gloin.checked_float_binary\"(%x, %two) <{kind = \"*\"}> : ($F, $F) -> $F\nreturn %result : $F\n}\nfunc.func @main() -> i32 {\n%in = arith.constant $HUGE : $F\n%out = func.call @kernel(%in) : ($F) -> $F\n%expected = arith.constant 0.0 : $F\n%bits = arith.bitcast %out : $F to $I\n%expectedbits = arith.bitcast %expected : $F to $I\n%ok = arith.cmpi eq, %bits, %expectedbits : $I\n%zero = arith.constant 0 : i32\n%one = arith.constant 1 : i32\n%exit = arith.select %ok, %zero, %one : i32\nreturn %exit : i32\n}\n}", predicates: 1, trap: true, execute: true },
