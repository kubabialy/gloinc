// Lexical paths and explicit filesystem operations. See docs/filesystem-process.md.
import "@strings";
import "@arena";
import "@status";

def pub const FILE: i32      = 1;
def pub const DIRECTORY: i32 = 2;
def pub const SYMLINK: i32   = 3;
def pub const OTHER: i32     = 4;

// Successful lstat data: final symlinks are not followed.
// size is logical file bytes or symlink target-text bytes, zero for directory/other.
def pub struct Metadata {
    def pub kind: i32,
    def pub size: u64,
}

// Copies of a Directory share this state; closing one invalidates all aliases.
def struct DirectoryState {
    def mut handle: *u8,
}

// A successful read either has a nonempty entry name or end=true and static empty text.
// The compiler checks result success; callers inspect end to distinguish normal exhaustion.
def pub struct DirectoryRead {
    def pub end: bool,
    def pub name: string,
}

// Explicit native directory cursor. Close before resetting or freeing owner.
// The source arena owns only the shared metadata, not the native cursor.
def pub struct Directory {
    def state: *DirectoryState,

    def pub static open(owner: &arena.GeneralArena, path: string) -> result<Directory> {
        if strings.is_empty(path) || !valid(path) {
            return error("directory path must be nonempty and contain no NUL", status.INVALID, 0);
        }

        def state: *DirectoryState = owner.try_alloc(DirectoryState {
            handle: null
        });
        if state == null { return error("directory state allocation failed", status.NO_MEMORY, 0); }

        def mut handle: *u8  = null;
        def mut failure: i32 = 0;
        def code: i32        = __fs_dir_open(path, &handle, &failure);

        if code != status.OK { return error("cannot open directory", code, failure); }

        state.handle = handle;

        return Directory { state: state };
    }

    def pub is_open(self: &const Directory) -> bool {
        return self.state != null && self.state.handle != null;
    }

    // Names are copied into memory and survive later reads until its arena is reset.
    // End is successful and allocates nothing. A copy failure can consume an entry.
    def pub next(self: &Directory, memory: &arena.GeneralArena) -> result<DirectoryRead> {
        if !self.is_open() { return error("directory is closed", status.CLOSED, 0); }

        def mut length: u64  = 0;
        def mut code: i32    = 0;
        def mut failure: i32 = 0;
        def bytes: *u8       = __fs_dir_next(self.state.handle, &length, &code, &failure);

        if code == status.END { return DirectoryRead { end: true, name: "" }; }
        if code != status.OK { return error("cannot read directory", code, failure); }

        def copied: result<string> = strings.copy(memory, __fs_string_view(bytes, length));
        if copied.erroneous { return error("cannot copy directory entry", copied.error.code, 0); }

        return DirectoryRead { end: false, name: copied.value };
    }

    // A close consumes the native handle even when the OS reports an error.
    // Failures retain @status in error.code and captured errno in error.os_error.
    def pub close(self: &Directory) -> result<void> {
        if !self.is_open() {
            return error("directory is closed", status.CLOSED, 0);
        }

        def handle: *u8 = self.state.handle;
        self.state.handle = null;

        def mut failure: i32 = 0;
        def code: i32        = __fs_dir_close(handle, &failure);

        if code != status.OK { return error("cannot close directory", code, failure); }

        return;
    }

}

def valid(path: string) -> bool {
    return !strings.contains(path, "\0");
}

def trimmed_end(path: string) -> u64 {
    def mut end: u64 = strings.byte_length(path);

    while end > 1 && byte_or_zero(path, end - 1) == 47 {
        end = end - 1;
    }

    return end;
}

// Example: fs.basename("/work/report.txt/") -> "report.txt"; empty -> ".", all slashes -> "/".
// O(path bytes), no allocation; success borrows input (or static . or /). NUL -> INVALID.
// Only '/' separates; . and .. are literal components; no filesystem lookup or normalization.
def pub basename(path: string) -> result<string> {
    if !valid(path) { return error("path must not contain NUL", status.INVALID, 0); }

    def end: u64 = trimmed_end(path);
    if end == 0 { return "."; }
    if end == 1 && byte_or_zero(path, 0) == 47 { return "/"; }

    def mut start: u64 = end;

    while start > 0 && byte_or_zero(path, start - 1) != 47 {
        start = start - 1;
    }

    return slice_or_empty(path, start, end - start);
}

// Example: fs.dirname("/work/report.txt/") -> "/work"; no slash/empty -> "."; root -> "/".
// O(path bytes), no allocation; borrowed/static success. NUL -> INVALID.
// Ignores trailing separators, trims the separator run before basename, preserves interior runs/dots.
def pub dirname(path: string) -> result<string> {
    if !valid(path) { return error("path must not contain NUL", status.INVALID, 0); }

    def mut end: u64 = trimmed_end(path);

    while end > 0 && byte_or_zero(path, end - 1) != 47 {
        end = end - 1;
    }

    if end == 0 { return "."; }

    while end > 1 && byte_or_zero(path, end - 1) == 47 {
        end = end - 1;
    }

    return slice_or_empty(path, 0, end);
}

def copied(memory: &arena.GeneralArena, text: string, max_bytes: u64) -> result<string> {
    if strings.byte_length(text) > max_bytes {
        return error("joined path exceeds byte limit", status.TOO_LONG, 0);
    }

    def outcome: result<string> = strings.copy(memory, text);
    if outcome.erroneous { return error("cannot copy path", outcome.error.code, 0); }

    return outcome.value;
}

// Example: fs.join(&memory, "/work/", "report.txt", 1024) -> "/work/report.txt".
// Absolute child replaces base; empty side copies the other; both empty -> static empty.
// NUL in either input -> INVALID; final bound/overflow -> TOO_LONG before allocation.
// O(base+child+output bytes), up to TWO arena byte requests (prefix then final), both retained;
// empty result allocates nothing. NO_MEMORY is recoverable. Success expires on memory reset/free.
// Strips trailing base separators at the join only; does not resolve . or .. or access the filesystem.
def pub join(memory: &arena.GeneralArena, base: string, child: string, max_bytes: u64) -> result<string> {
    if !valid(base) || !valid(child) { return error("path must not contain NUL", status.INVALID, 0); }

    if strings.is_empty(base) || strings.is_empty(child) || strings.starts_with(child, "/") {
        def mut text: string = child;
        if strings.is_empty(child) { text = base; }

        def outcome: result<string> = copied(memory, text, max_bytes);
        if outcome.erroneous { return outcome.error; }

        return outcome.value;
    }

    def end: u64        = trimmed_end(base);
    def left: string    = slice_or_empty(base, 0, end);
    def right_size: u64 = strings.byte_length(child);

    if end > max_bytes { return error("joined path exceeds byte limit", status.TOO_LONG, 0); }
    if right_size > max_bytes - end { return error("joined path exceeds byte limit", status.TOO_LONG, 0); }

    if byte_or_zero(left, end - 1) == 47 {
        def made: result<string> = strings.concat(memory, left, child, max_bytes);
        if made.erroneous { return error("cannot join path", made.error.code, 0); }

        return made.value;
    }

    if right_size == max_bytes - end { return error("joined path exceeds byte limit", status.TOO_LONG, 0); }

    def prefix: result<string> = strings.concat(memory, left, "/", max_bytes);
    if prefix.erroneous { return error("cannot join path", prefix.error.code, 0); }

    def outcome: result<string> = strings.concat(memory, prefix.value, child, max_bytes);
    if outcome.erroneous { return error("cannot join path", outcome.error.code, 0); }

    return outcome.value;
}

// Example: fs.metadata("report.bin"); prove success, then read kind/size.
// Missing -> NOT_FOUND; access -> PERMISSION_DENIED. Errors retain native errno.
// O(path bytes) plus native lstat; temporary native path length+1 allocation, freed before return.
// Empty/NUL -> INVALID; no retained path/storage. Final symlinks are reported, not followed.
def pub metadata(path: string) -> result<Metadata> {
    def mut kind: i32         = 0;
    def mut size: u64         = 0;
    def mut failure_code: i32 = 0;
    def code: i32             = __fs_metadata(path, &kind, &size, &failure_code);

    if code != status.OK { return error("cannot inspect path", code, failure_code); }

    return Metadata { kind: kind, size: size };
}

// Example: fs.mkdir("output"). Create ONE directory, mode 0777 filtered by host umask; no parent creation.
// O(path bytes) plus blocking native mkdir; temporary native length+1 path bytes, freed on return.
// Existing entry -> ALREADY_EXISTS (not proof of a directory); empty/NUL -> INVALID; errno retained.
// Check the result before reading error.code (@status) or error.os_error (native errno).
def pub mkdir(path: string) -> result<void> {
    def mut failure_code: i32 = 0;
    def code: i32             = __fs_mkdir(path, &failure_code);

    if code != status.OK { return error("cannot create directory", code, failure_code); }

    return;
}

// Example: fs.remove_file("old.bin"). Unlink one file or symlink itself; never remove a directory or recurse.
// O(path bytes) plus native unlink; temporary native length+1 path bytes, freed on return.
// Missing -> NOT_FOUND; empty/NUL -> INVALID; other failures preserve errno. No retained input reference.
def pub remove_file(path: string) -> result<void> {
    def mut failure_code: i32 = 0;
    def code: i32             = __fs_remove_file(path, &failure_code);

    if code != status.OK { return error("cannot remove file", code, failure_code); }

    return;
}

// Example: fs.rename_replace("draft.txt", "report.txt"). Explicit POSIX replacement of a compatible target.
// O(from+to bytes) plus native rename; two temporary terminated native path copies, freed on return.
// Both paths validate before allocation/mutation. Cross-filesystem rename fails (IO_ERROR/EXDEV); no copy fallback.
// Existing regular file or empty compatible directory can be replaced; symlinks themselves are renamed.
def pub rename_replace(from: string, to: string) -> result<void> {
    def mut failure_code: i32 = 0;
    def code: i32             = __fs_rename_replace(from, to, &failure_code);

    if code != status.OK { return error("cannot rename path", code, failure_code); }

    return;
}

// Store target text verbatim at link_path. Relative targets resolve from the link's parent.
// Target need not exist; existing destinations are never replaced. Empty/NUL inputs fail.
// O(target+path bytes) preparation, two temporary native copies, no retained allocation.
def pub symlink(target: string, link_path: string) -> result<void> {
    def mut failure: i32 = 0;
    def code: i32        = __fs_symlink(target, link_path, &failure);

    if code == status.OK { return; }
    if code == status.INVALID { return error("symlink target and path must be nonempty and contain no NUL", code, failure); }
    if code == status.ALREADY_EXISTS { return error("symlink destination already exists", code, failure); }
    if code == status.NOT_FOUND { return error("symlink parent path was not found", code, failure); }
    if code == status.PERMISSION_DENIED { return error("symlink creation permission denied", code, failure); }
    if code == status.NO_MEMORY { return error("symlink creation allocation failed", code, failure); }

    return error("symlink creation failed", code, failure);
}

// Read the final link's stored text, including broken/cyclic links; no recursive resolution.
// One max_bytes+1 zeroed arena request (extra byte detects overflow), retained even on host error.
// Exact max_bytes succeeds; larger text fails, never truncates. No trailing NUL is promised.
// O(max_bytes+path+target bytes) plus host readlink. Bytes expire on arena reset/free.
def pub read_link(memory: &arena.GeneralArena, path: string, max_bytes: u64) -> result<string> {
    if strings.is_empty(path) || !valid(path) {
        return error("symlink path must be nonempty and contain no NUL", status.INVALID, 0);
    }
    if max_bytes > 9223372036854775806 { return error("symlink target limit is too large", status.TOO_LONG, 0); }

    def bytes: *u8 = memory.try_alloc_bytes(max_bytes + 1);
    if bytes == null { return error("symlink target allocation failed", status.NO_MEMORY, 0); }

    def mut length: u64  = 0;
    def mut failure: i32 = 0;
    def code: i32        = __fs_read_link(path, &*bytes, max_bytes + 1, &length, &failure);

    if code == status.OK { return __fs_string_view(bytes, length); }
    if code == status.TOO_LONG { return error("symlink target exceeds byte limit", code, failure); }
    if code == status.INVALID { return error("path is not a symbolic link", code, failure); }
    if code == status.NOT_FOUND { return error("symlink path was not found", code, failure); }
    if code == status.PERMISSION_DENIED { return error("symlink read permission denied", code, failure); }
    if code == status.NO_MEMORY { return error("symlink read allocation failed", code, failure); }

    return error("symlink read failed", code, failure);
}

// Resolve an EXISTING path to absolute text; follow links and resolve dot components.
// One max_bytes+1 zeroed arena request retained even on host error; native path/result copies freed.
// Exact max_bytes succeeds; no truncation. Result expires on arena reset/free.
// This is a filesystem snapshot, not a containment check or a reserved path.
def pub canonical_path(memory: &arena.GeneralArena, path: string, max_bytes: u64) -> result<string> {
    if strings.is_empty(path) || !valid(path) { return error("canonical path must be nonempty and contain no NUL", status.INVALID, 0); }
    if max_bytes > 9223372036854775806 { return error("canonical path limit is too large", status.TOO_LONG, 0); }

    def bytes: *u8 = memory.try_alloc_bytes(max_bytes + 1);
    if bytes == null { return error("canonical path allocation failed", status.NO_MEMORY, 0); }

    def mut length: u64  = 0;
    def mut failure: i32 = 0;
    def code: i32        = __fs_canonical_path(path, &*bytes, max_bytes + 1, &length, &failure);

    if code == status.OK { return __fs_string_view(bytes, length); }
    if code == status.TOO_LONG { return error("canonical path exceeds byte limit", code, failure); }
    if code == status.NOT_FOUND { return error("canonical path was not found", code, failure); }
    if code == status.PERMISSION_DENIED { return error("canonical path permission denied", code, failure); }
    if code == status.NO_MEMORY { return error("canonical path allocation failed", code, failure); }

    return error("canonical path resolution failed", code, failure);
}

// Exclusively create parent/prefix-XXXXXX, mode 0700 restricted by umask.
// Parent is canonicalized first; return an absolute path owned by memory.
// Prefix must be nonempty and contain neither '/' nor NUL. Parent must exist.
// All bounds/copies/arena requests precede mkdir; no fallible work after creation.
// Intermediate arena strings remain on failure. Freeing memory DOES NOT remove the directory.
def pub temp_dir(memory: &arena.GeneralArena, parent: string, prefix: string, max_bytes: u64) -> result<string> {
    if strings.is_empty(parent) || !valid(parent) { return error("temporary directory parent must be nonempty and contain no NUL", status.INVALID, 0); }
    if strings.is_empty(prefix) || !valid(prefix) || strings.contains(prefix, "/") {
        return error("temporary directory prefix must be nonempty and contain neither slash nor NUL", status.INVALID, 0);
    }
    if max_bytes > 9223372036854775806 { return error("temporary directory path limit is too large", status.TOO_LONG, 0); }

    def name: result<string> = strings.concat(memory, prefix, "-XXXXXX", max_bytes);

    if name.erroneous {
        if name.error.code == status.TOO_LONG { return error("temporary directory path exceeds byte limit", name.error.code, 0); }

        return error("temporary directory path allocation failed", name.error.code, 0);
    }

    def resolved: result<string> = canonical_path(memory, parent, max_bytes);
    if resolved.erroneous { return resolved.error; }

    def pattern: result<string> = join(memory, resolved.value, name.value, max_bytes);

    if pattern.erroneous {
        if pattern.error.code == status.TOO_LONG { return error("temporary directory path exceeds byte limit", pattern.error.code, pattern.error.os_error); }

        return error("temporary directory path allocation failed", pattern.error.code, pattern.error.os_error);
    }

    def capacity: u64 = strings.byte_length(pattern.value) + 1;
    def bytes: *u8    = memory.try_alloc_bytes(capacity);

    if bytes == null { return error("temporary directory path allocation failed", status.NO_MEMORY, 0); }

    def mut length: u64  = 0;
    def mut failure: i32 = 0;
    def code: i32        = __fs_temp_dir(pattern.value, &*bytes, capacity, &length, &failure);

    if code == status.OK { return __fs_string_view(bytes, length); }
    if code == status.NOT_FOUND { return error("temporary directory parent was not found or is not a directory", code, failure); }
    if code == status.PERMISSION_DENIED { return error("temporary directory creation permission denied", code, failure); }
    if code == status.NO_MEMORY { return error("temporary directory creation allocation failed", code, failure); }

    return error("temporary directory creation failed", code, failure);
}

// Remove ONE empty directory. No recursion; a final symlink is rejected.
// Trailing slashes are stripped. Root and final . or .. are rejected.
// O(path bytes) plus rmdir; one temporary native path copy, no retained allocation.
def pub remove_dir(path: string) -> result<void> {
    def mut failure: i32 = 0;
    def code: i32        = __fs_remove_dir(path, &failure);

    if code == status.OK { return; }
    if code == status.INVALID { return error("invalid directory removal path", code, failure); }
    if code == status.ALREADY_EXISTS { return error("directory is not empty", code, failure); }
    if code == status.NOT_FOUND { return error("directory was not found or path is not a directory", code, failure); }
    if code == status.PERMISSION_DENIED { return error("directory removal permission denied", code, failure); }
    if code == status.NO_MEMORY { return error("directory removal allocation failed", code, failure); }

    return error("directory removal failed", code, failure);
}

// Checked replacement of an existing regular file; expected is the previously read content.
// No source arena allocation. Host staging/copying is O(path+expected+replacement bytes).
// Rejects final symlinks, hard links, non-owner files and special mode bits.
// Preserves uid/gid and ordinary permissions; ACLs/xattrs/timestamps are not copied.
// Caller requires exclusive editing: the last check and rename are not atomic together.
// Before rename, errors preserve the original; temporary cleanup is best effort on host errors.
def pub replace_file(path: string, expected: string, replacement: string) -> result<void> {
    def mut failure: i32 = 0;
    def code: i32        = __fs_replace_file(path, expected, replacement, &failure);

    if code == status.OK { return; }
    if code == status.INVALID { return error("file replacement rejected or source changed", code, failure); }
    if code == status.NOT_FOUND { return error("file replacement path was not found", code, failure); }
    if code == status.PERMISSION_DENIED { return error("file replacement permission denied", code, failure); }
    if code == status.NO_MEMORY { return error("file replacement allocation failed", code, failure); }

    return error("file replacement failed", code, failure);
}

// Parser/lookahead policy: an out-of-range byte is the zero sentinel.
// Preserve this caller policy explicitly; public string access returns a result.
def byte_or_zero(text: string, index: u64) -> u8 {
    def byte: result<u8> = strings.byte_at(text, index);
    if byte.erroneous { return 0; }

    return byte.value;
}

// A failed range produces empty text under this caller's existing policy.
// The returned view still borrows the source bytes.
def slice_or_empty(text: string, start: u64, length: u64) -> string {
    def view: result<string> = strings.slice_bytes(text, start, length);
    if view.erroneous { return ""; }

    return view.value;
}
