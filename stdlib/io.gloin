// Streams and files. See docs/io.md for ownership, progress, errors, and costs.
import "@arena";
import "@status";
import "@strings";

// Per-call output, including a valid partial prefix on chunk/all failure.
// Each read resets both fields before validation. Bytes borrow the read arena.
// end means an empty EOF from read_line/read_chunk; read_all completes with end=false.
def pub struct ReadState {
    def pub mut value: string,
    def pub mut end: bool,

    def pub static empty() -> ReadState {
        return ReadState { value: "", end: false };
    }
}

// Per-call direct-read progress. Only destination[..read] was received.
// Reset before validation; end means an empty EOF. No buffer is retained.
def pub struct ByteReadState {
    def pub mut read: u64,
    def pub mut end: bool,

    def pub static empty() -> ByteReadState {
        return ByteReadState { read: 0, end: false };
    }
}

// Bytes accepted during this call, including any prefix before failure.
// Reset before validation. write_line includes its LF if accepted.
def pub struct WriteState {
    def pub mut written: u64,

    def pub static empty() -> WriteState {
        return WriteState { written: 0 };
    }
}

def struct FileState {
    def mut handle: *u8,
}

// Borrowed handle; copies share position/buffering and cannot close the resource.
// File-derived streams borrow shared metadata until its owner arena expires.
// Mutating I/O requires a mutable handle. State/buffers must not overlap each other.
def pub struct Stream {
    def state: *FileState,
    def standard: i32,
    def readable: bool,

    def handle(self: &const Stream) -> *u8 {
        if self.standard != 0 { return __io_standard(self.standard); }
        if self.state == null { return null; }

        return self.state.handle;
    }

    // O(1), no allocation; observes alias close, not native descriptor validity.
    def pub is_open(self: &const Stream) -> bool {
        return self.handle() != null;
    }

    def read(self: &Stream, memory: &arena.GeneralArena, max_bytes: u64, mode: i32, progress: &ReadState) -> result<void> {
        *progress = ReadState.empty();

        def handle: *u8 = self.handle();
        if handle == null { return error("stream is closed", status.CLOSED, 0); }
        if !self.readable { return error("stream is not readable", status.INVALID, 0); }
        if mode == 1 && max_bytes == 0 { return error("chunk read requires a nonzero limit", status.INVALID, 0); }
        if max_bytes > 9223372036854775806 { return error("read allocation exceeds addressable storage", status.NO_MEMORY, 0); }

        def bytes: *u8 = memory.try_alloc_bytes(max_bytes + 1);
        if bytes == null { return error("read allocation failed", status.NO_MEMORY, 0); }

        def mut length: u64       = 0;
        def mut failure_code: i32 = 0;
        def code: i32             = __io_read(handle, &*bytes, max_bytes, mode, &length, &failure_code);
        progress.value = __io_string_view(bytes, length);
        progress.end   = code == status.END;

        if code != status.OK && code != status.END { return error("stream read failed", code, failure_code); }

        return;
    }

    // Strips LF/CRLF; final unterminated line succeeds, then a later call reports end.
    // TOO_LONG drains the line; any failure leaves empty text, possibly after consuming input.
    // O(consumed bytes + max_bytes zeroing), blocking I/O, one max_bytes+1 arena request.
    // Allocation failure consumes nothing. Text expires on arena reset/free.
    def pub read_line(self: &Stream, memory: &arena.GeneralArena, max_bytes: u64, progress: &ReadState) -> result<void> {
        def outcome: result<void> = self.read(memory, max_bytes, 0, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Nonzero bound; binary bytes unchanged. Partial EOF succeeds with end=false;
    // the subsequent empty EOF succeeds with end=true. Errors retain the received prefix.
    // O(max_bytes) work/zeroing plus blocking I/O; one max_bytes+1 arena request.
    def pub read_chunk(self: &Stream, memory: &arena.GeneralArena, max_bytes: u64, progress: &ReadState) -> result<void> {
        def outcome: result<void> = self.read(memory, max_bytes, 1, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Direct read into nonempty caller storage. Partial bytes remain on failure.
    // No allocation/terminator/retained view. Empty EOF succeeds with end=true.
    def pub read_into(self: &Stream, destination: [u8], progress: &ByteReadState) -> result<void> {
        *progress = ByteReadState.empty();

        def handle: *u8 = self.handle();
        if handle == null { return error("stream is closed", status.CLOSED, 0); }

        def zero: u64 = 0;
        if !self.readable || destination.len == zero { return error("invalid direct read", status.INVALID, 0); }

        def mut received: u64     = 0;
        def mut failure_code: i32 = 0;
        def code: i32             = __io_read_bytes(handle, &destination[0], destination.len, &received, &failure_code);
        progress.read = received;
        progress.end  = code == status.END;

        if code != status.OK && code != status.END { return error("stream read failed", code, failure_code); }

        return;
    }

    // EOF completes normally, including an empty file; end stays false for this operation.
    // TOO_LONG retains the bound-sized prefix and leaves the next byte unread.
    // Errors retain progress. O(max_bytes) work/zeroing, blocking I/O plus one-byte probe;
    // one max_bytes+1 arena request. Never drains unbounded input on overflow.
    def pub read_all(self: &Stream, memory: &arena.GeneralArena, max_bytes: u64, progress: &ReadState) -> result<void> {
        def outcome: result<void> = self.read(memory, max_bytes, 2, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    def write_mode(self: &Stream, text: string, all: i32, progress: &WriteState) -> result<void> {
        *progress = WriteState.empty();

        def handle: *u8 = self.handle();
        if handle == null { return error("stream is closed", status.CLOSED, 0); }
        if self.readable { return error("stream is not writable", status.INVALID, 0); }

        def mut written: u64      = 0;
        def mut failure_code: i32 = 0;
        def code: i32             = __io_write(handle, text, all, &written, &failure_code);
        progress.written = written;

        if code != status.OK { return error("stream write failed", code, failure_code); }

        return;
    }

    // One native fwrite; inspect progress.written even on success (short writes possible).
    // Empty text succeeds on a live writable stream. No allocation, flush or retained view.
    def pub write(self: &Stream, text: string, progress: &WriteState) -> result<void> {
        def outcome: result<void> = self.write_mode(text, 0, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Retry short writes until all bytes accepted or error/no progress. O(text bytes)
    // plus blocking I/O; no allocation/implicit flush. Failure retains accepted prefix count.
    def pub write_all(self: &Stream, text: string, progress: &WriteState) -> result<void> {
        def outcome: result<void> = self.write_mode(text, 1, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    def write_bytes_mode(self: &Stream, bytes: [const u8], all: i32, progress: &WriteState) -> result<void> {
        *progress = WriteState.empty();

        def handle: *u8 = self.handle();
        if handle == null { return error("stream is closed", status.CLOSED, 0); }
        if self.readable { return error("stream is not writable", status.INVALID, 0); }

        def zero: u64 = 0;
        if bytes.len == zero { return; }

        def mut written: u64      = 0;
        def mut failure_code: i32 = 0;
        def code: i32             = __io_write_bytes(handle, &bytes[0], bytes.len, all, &written, &failure_code);
        progress.written = written;

        if code != status.OK { return error("stream write failed", code, failure_code); }

        return;
    }

    // Counted binary counterpart of write; no allocation or retained input view.
    def pub write_bytes(self: &Stream, bytes: [const u8], progress: &WriteState) -> result<void> {
        def outcome: result<void> = self.write_bytes_mode(bytes, 0, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Counted binary counterpart of write_all; partial count survives failure.
    def pub write_all_bytes(self: &Stream, bytes: [const u8], progress: &WriteState) -> result<void> {
        def outcome: result<void> = self.write_bytes_mode(bytes, 1, progress);
        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Write all text, then LF; not atomic. Counts both stages, including on LF failure.
    // A failed text write suppresses LF. No allocation/implicit flush; O(text bytes+1).
    def pub write_line(self: &Stream, text: string, progress: &WriteState) -> result<void> {
        def first: result<void> = self.write_all(text, progress);
        if first.erroneous { return first.error; }

        def prefix: u64        = progress.written;
        def last: result<void> = self.write_all("\n", progress);
        progress.written = prefix + progress.written;

        if last.erroneous { return last.error; }

        return;
    }

    // Explicit delivery of buffered output, not disk durability. INVALID on read streams.
    // O(pending bytes) plus blocking I/O; no allocation. Does not close the stream.
    def pub flush(self: &Stream) -> result<void> {
        def handle: *u8 = self.handle();
        if handle == null { return error("stream is closed", status.CLOSED, 0); }
        if self.readable { return error("stream is not writable", status.INVALID, 0); }

        def mut failure_code: i32 = 0;
        def code: i32             = __io_flush(handle, &failure_code);

        if code != status.OK { return error("stream flush failed", code, failure_code); }

        return;
    }
}

// Owned native resource with shared arena metadata. Close before resetting/freeing
// owner. Copies alias position and close state. Scratch must not invalidate metadata.
def pub struct File {
    def state: *FileState,
    def readable: bool,

    // Open existing bytes; missing path is NOT_FOUND.
    // Reject empty/NUL paths before allocation. Allocate metadata before native open.
    // O(path bytes) plus OS work, one retained FileState arena request (even on failure),
    // temporary native path copy and native FILE storage until close; no byte buffer.
    def pub static open_read(owner: &arena.GeneralArena, path: string) -> result<File> {
        def opened: result<File> = open_file(owner, path, 0);
        if opened.erroneous { return opened.error; }

        return opened.value;
    }

    // Exclusive create; existing path is ALREADY_EXISTS, never truncated.
    // Reject empty/NUL paths before allocation. Allocate metadata before native open.
    // O(path bytes) plus OS work, one retained FileState arena request (even on failure),
    // temporary native path copy and native FILE storage until close; no byte buffer.
    def pub static create_new(owner: &arena.GeneralArena, path: string) -> result<File> {
        def opened: result<File> = open_file(owner, path, 1);
        if opened.erroneous { return opened.error; }

        return opened.value;
    }

    // Explicitly truncate or create a writable file.
    // Reject empty/NUL paths before allocation. Allocate metadata before native open.
    // O(path bytes) plus OS work, one retained FileState arena request (even on failure),
    // temporary native path copy and native FILE storage until close; no byte buffer.
    def pub static open_truncate(owner: &arena.GeneralArena, path: string) -> result<File> {
        def opened: result<File> = open_file(owner, path, 2);
        if opened.erroneous { return opened.error; }

        return opened.value;
    }

    // Open/create writable append stream; writes target the current end.
    // Reject empty/NUL paths before allocation. Allocate metadata before native open.
    // O(path bytes) plus OS work, one retained FileState arena request (even on failure),
    // temporary native path copy and native FILE storage until close; no byte buffer.
    def pub static open_append(owner: &arena.GeneralArena, path: string) -> result<File> {
        def opened: result<File> = open_file(owner, path, 3);
        if opened.erroneous { return opened.error; }

        return opened.value;
    }

    // O(1), no allocation; borrows shared metadata and cannot close its owner.
    def pub stream(self: &const File) -> Stream {
        return Stream { state: self.state, standard: 0, readable: self.readable };
    }

    // O(1), no allocation; false after any alias closes, even on close failure.
    def pub is_open(self: &const File) -> bool {
        return self.state != null && self.state.handle != null;
    }

    // Consumes once even on failure; aliases immediately become CLOSED.
    // Bind/check the result, including in deferred cleanup helpers. Never retry native close.
    // O(1) cleanup plus blocking close; arena metadata remains until owner reset/free.
    def pub close(self: &File) -> result<void> {
        if !self.is_open() { return error("file is closed", status.CLOSED, 0); }

        def handle: *u8 = self.state.handle;
        self.state.handle = null;

        def mut failure_code: i32 = 0;
        def code: i32             = __io_close(handle, &failure_code);

        if code != status.OK { return error("file close failed", code, failure_code); }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.read_line.
    def pub read_line(self: &File, memory: &arena.GeneralArena, max_bytes: u64, progress: &ReadState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.read_line(memory, max_bytes, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.read_chunk.
    def pub read_chunk(self: &File, memory: &arena.GeneralArena, max_bytes: u64, progress: &ReadState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.read_chunk(memory, max_bytes, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.read_all.
    def pub read_all(self: &File, memory: &arena.GeneralArena, max_bytes: u64, progress: &ReadState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.read_all(memory, max_bytes, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.read_into.
    def pub read_into(self: &File, destination: [u8], progress: &ByteReadState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.read_into(destination, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.write.
    def pub write(self: &File, text: string, progress: &WriteState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.write(text, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.write_all.
    def pub write_all(self: &File, text: string, progress: &WriteState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.write_all(text, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.write_line.
    def pub write_line(self: &File, text: string, progress: &WriteState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.write_line(text, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.write_bytes.
    def pub write_bytes(self: &File, bytes: [const u8], progress: &WriteState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.write_bytes(bytes, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.write_all_bytes.
    def pub write_all_bytes(self: &File, bytes: [const u8], progress: &WriteState) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.write_all_bytes(bytes, progress);

        if outcome.erroneous { return outcome.error; }

        return;
    }

    // Same state, ownership, failure effects and costs as Stream.flush.
    def pub flush(self: &File) -> result<void> {
        def mut stream: Stream    = self.stream();
        def outcome: result<void> = stream.flush();

        if outcome.erroneous { return outcome.error; }

        return;
    }
}

def open_file(owner: &arena.GeneralArena, path: string, mode: i32) -> result<File> {
    if strings.is_empty(path) || strings.contains(path, "\0") {
        return error("file path must be nonempty and contain no NUL", status.INVALID, 0);
    }

    // Metadata failure must precede creation/truncation.
    def state: *FileState = owner.try_alloc(FileState { handle: null });
    if state == null { return error("file state allocation failed", status.NO_MEMORY, 0); }

    def mut code: i32         = 0;
    def mut failure_code: i32 = 0;
    def handle: *u8           = __io_open(path, mode, &code, &failure_code);

    if handle == null { return error("cannot open file", code, failure_code); }

    state.handle = handle;

    return File { state: state, readable: mode == 0 };
}

// Example: def mut input: io.Stream = io.stdin(); O(1), no allocation.
// Borrows process stdin, shares buffering/position with std.input; no close capability.
def pub stdin() -> Stream {
    return Stream {
        state: null,
        standard: 1,
        readable: true
    };
}

// Example: def mut output: io.Stream = io.stdout(); O(1), no allocation.
// Borrows process stdout; host buffering is preserved; explicitly flush to observe pending errors.
def pub stdout() -> Stream {
    return Stream {
        state: null,
        standard: 2,
        readable: false
    };
}

// Example: def mut errors: io.Stream = io.stderr(); O(1), no allocation.
// Borrows process stderr independently of stdout; no close capability, host buffering preserved.
def pub stderr() -> Stream {
    return Stream {
        state: null,
        standard: 3,
        readable: false
    };
}

// O(256) bounded work plus host lookup and one 256-byte arena request.
// Zero returns static text without allocation; negative code is INVALID.
// Bytes expire on arena reset/free. Error codes describe THIS lookup, not its input errno.
def pub error_message(memory: &arena.GeneralArena, os_error: i32) -> result<string> {
    if os_error == 0 { return "no OS error"; }
    if os_error < 0 { return error("invalid OS error code", status.INVALID, 0); }

    def bytes: *u8 = memory.try_alloc_bytes(256);
    if bytes == null { return error("error message allocation failed", status.NO_MEMORY, 0); }

    def mut length: u64 = 0;
    def code: i32       = __io_error_message(os_error, &*bytes, &length);

    if code != status.OK { return error("cannot format OS error", code, 0); }

    return __io_string_view(bytes, length);
}
