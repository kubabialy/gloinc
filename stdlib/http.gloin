// Bounded HTTP/1.1 formatting and incremental response decoding. No I/O.
// All returned views borrow caller storage; see docs/networking.md.
import "@arena";
import "@status";
import "@std";
import "@strings";

def struct HeadResult {
    def pub status: i32,
    def pub header_bytes: u64,
    def pub content_length: u64,
    def pub has_content_length: bool,
    def pub chunked: bool,
    def pub start_line: string,
    def pub host: string,
}

def pub struct RequestHead {
    def pub complete: bool,
    def pub header_bytes: u64,
    def pub content_length: u64,
    def pub method: string,
    def pub target: string,
    def pub host: string,
}

def pub struct ResponseHead {
    def pub complete: bool,
    def pub header_bytes: u64,
    def pub content_length: u64,
    def pub has_content_length: bool,
    def pub chunked: bool,
    def pub code: i32,
}

// A complete fixed-length message borrows body bytes from the input buffer.
// consumed marks the first byte of a possible following message.
def pub struct Frame {
    def pub complete: bool,
    def pub consumed: u64,
    def pub body: string,
}

def incomplete_frame() -> Frame {
    return Frame {
        complete: false,
        consumed: 0,
        body: ""
    };
}

def body_frame(bytes: string, header_bytes: u64, content_length: u64,
    max_body_bytes: u64) -> result<Frame> {
    if content_length > max_body_bytes { return error("HTTP body exceeds limit"); }

    def available: u64 = strings.byte_length(bytes) - header_bytes;
    if content_length > available { return incomplete_frame(); }

    return Frame {
        complete: true,
        consumed: header_bytes + content_length,
        body: slice_or_empty(bytes, header_bytes, content_length)
    };
}

def empty_head(code: i32) -> HeadResult {
    return HeadResult {
        status: code,
        header_bytes: 0,
        content_length: 0,
        has_content_length: false,
        chunked: false,
        start_line: "",
        host: ""
    };
}

def ascii_lower(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32; }

    return byte;
}

def equals_header_name(name: string, expected: string) -> bool {
    def count: u64 = strings.byte_length(name);
    if count != strings.byte_length(expected) { return false; }

    for def mut index: u64 = 0; index < count; index = index + 1 {
        if ascii_lower(byte_or_zero(name, index)) !=
        ascii_lower(byte_or_zero(expected, index)) {
            return false;
        }
    }

    return true;
}

def token(text: string) -> bool {
    if strings.is_empty(text) { return false; }

    for def mut index: u64 = 0; index < strings.byte_length(text); index = index + 1 {
        def byte: u8 = byte_or_zero(text, index);
        if !((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
                || (byte >= 48 && byte <= 57) || byte == 33 || byte == 35 || byte == 36
                || byte == 37 || byte == 38 || byte == 39 || byte == 42 || byte == 43
                || byte == 45 || byte == 46 || byte == 94 || byte == 95 || byte == 96
                || byte == 124 || byte == 126) {
            return false;
        }
    }

    return true;
}

def header_value(text: string) -> bool {
    for def mut index: u64 = 0; index < strings.byte_length(text); index = index + 1 {
        def byte: u8 = byte_or_zero(text, index);
        if byte != 9 && (byte < 32 || byte == 127) { return false; }
    }

    return true;
}

def request_target(text: string) -> bool {
    if !strings.starts_with(text, "/") { return false; }

    for def mut index: u64 = 0; index < strings.byte_length(text); index = index + 1 {
        def byte: u8 = byte_or_zero(text, index);
        if byte < 33 || byte > 126 || byte == 35 { return false; }
    }

    return true;
}

// IN_PROGRESS means the caller should append more bytes. TOO_LONG means the
// complete head exceeds max_header_bytes. On OK views borrow the input bytes.
// Only the single chunked transfer coding is accepted; TE plus CL is rejected.
def parse_head(bytes: string, max_header_bytes: u64) -> HeadResult {
    def mut inspected: u64 = strings.byte_length(bytes);
    if inspected > max_header_bytes { inspected = max_header_bytes; }

    def marker: strings.FindResult = strings.find(
        slice_or_empty(bytes, 0, inspected), "\r\n\r\n");

    if !marker.found {
        if strings.byte_length(bytes) > max_header_bytes {
            return empty_head(status.TOO_LONG);
        }

        return empty_head(status.IN_PROGRESS);
    }

    def end: u64 = marker.offset + 4;
    if end > max_header_bytes { return empty_head(status.TOO_LONG); }

    // Reject lone line breaks, NUL, and other control bytes in the head.
    for def mut i: u64 = 0; i < end; i = i + 1 {
        def byte: u8 = byte_or_zero(bytes, i);

        if byte == 13 {
            if i + 1 >= end || byte_or_zero(bytes, i + 1) != 10 {
                return empty_head(status.INVALID);
            }
        } else if byte == 10 {
            if i == 0 || byte_or_zero(bytes, i - 1) != 13 {
                return empty_head(status.INVALID);
            }
        } else if byte != 9 && (byte < 32 || byte == 127) {
            return empty_head(status.INVALID);
        }
    }

    def first_end: strings.FindResult = strings.find(
        slice_or_empty(bytes, 0, end), "\r\n");
    if !first_end.found || first_end.offset == 0 { return empty_head(status.INVALID); }

    def first: string        = slice_or_empty(bytes, 0, first_end.offset);
    def mut cursor: u64      = first_end.offset + 2;
    def mut length: u64      = 0;
    def mut has_length: bool = false;
    def mut chunked: bool    = false;
    def mut host: string     = "";

    while cursor < marker.offset + 2 {
        def remaining: string            = slice_or_empty(bytes, cursor, end - cursor);
        def line_end: strings.FindResult = strings.find(remaining, "\r\n");

        if !line_end.found || line_end.offset == 0 { return empty_head(status.INVALID); }

        def line: string              = slice_or_empty(remaining, 0, line_end.offset);
        def colon: strings.FindResult = strings.find(line, ":");

        if !colon.found { return empty_head(status.INVALID); }

        def name: string = slice_or_empty(line, 0, colon.offset);
        def value: string = strings.trim_ascii(slice_or_empty(
            line, colon.offset + 1, strings.byte_length(line) - colon.offset - 1));

        if !token(name) || !header_value(value) { return empty_head(status.INVALID); }

        if equals_header_name(name, "Transfer-Encoding") {
            if chunked || !equals_header_name(value, "chunked") {
                return empty_head(status.INVALID);
            }

            chunked = true;
        }

        if equals_header_name(name, "Content-Length") {
            if strings.is_empty(value) { return empty_head(status.INVALID); }

            for def mut digit: u64 = 0; digit < strings.byte_length(value); digit = digit + 1 {
                def byte: u8 = byte_or_zero(value, digit);
                if byte < 48 || byte > 57 { return empty_head(status.INVALID); }
            }

            def parsed: result<u64> = std.parse_u64(value);
            if parsed.erroneous { return empty_head(parsed.error.code); }
            if has_length && length != parsed.value { return empty_head(status.INVALID); }

            length     = parsed.value;
            has_length = true;
        }

        if equals_header_name(name, "Host") {
            if !strings.is_empty(host) || strings.is_empty(value) {
                return empty_head(status.INVALID);
            }

            host = value;
        }

        cursor = cursor + line_end.offset + 2;
    }

    if chunked && has_length { return empty_head(status.INVALID); }

    return HeadResult {
        status: status.OK,
        header_bytes: end,
        content_length: length,
        has_content_length: has_length,
        chunked: chunked,
        start_line: first,
        host: host
    };
}

def incomplete_request() -> RequestHead {
    return RequestHead {
        complete: false,
        header_bytes: 0,
        content_length: 0,
        method: "",
        target: "",
        host: ""
    };
}

// Parses one request head. The caller must retain the input buffer until all
// returned views have been consumed and then read content_length body bytes.
// HTTP/1.1 Host is required; absolute-form targets and upgrades are not parsed.
def pub parse_request(bytes: string, max_header_bytes: u64) -> result<RequestHead> {
    def head: HeadResult = parse_head(bytes, max_header_bytes);
    if head.status == status.IN_PROGRESS { return incomplete_request(); }
    if head.status == status.TOO_LONG { return error("HTTP request head exceeds limit"); }
    if head.status != status.OK || head.chunked { return error("invalid or unsupported HTTP request head"); }

    def first_space: strings.FindResult = strings.find(head.start_line, " ");
    if !first_space.found { return error("invalid HTTP request line"); }

    def method: string = slice_or_empty(head.start_line, 0, first_space.offset);
    def rest: string = slice_or_empty(head.start_line, first_space.offset + 1,
        strings.byte_length(head.start_line) - first_space.offset - 1);
    def second_space: strings.FindResult = strings.find(rest, " ");

    if !second_space.found { return error("invalid HTTP request line"); }

    def target: string = slice_or_empty(rest, 0, second_space.offset);
    def version: string = slice_or_empty(rest, second_space.offset + 1,
        strings.byte_length(rest) - second_space.offset - 1);

    if !token(method) || !request_target(target) || !strings.equal(version, "HTTP/1.1")
        || strings.is_empty(head.host) {
        return error("invalid HTTP request line or Host");
    }

    return RequestHead {
        complete: true,
        header_bytes: head.header_bytes,
        content_length: head.content_length,
        method: method,
        target: target,
        host: head.host
    };
}

def incomplete_response() -> ResponseHead {
    return ResponseHead {
        complete: false,
        header_bytes: 0,
        content_length: 0,
        has_content_length: false,
        chunked: false,
        code: 0
    };
}

// ResponseReader applies method/status/body framing to this parsed head.
def pub parse_response(bytes: string, max_header_bytes: u64) -> result<ResponseHead> {
    def head: HeadResult = parse_head(bytes, max_header_bytes);
    if head.status == status.IN_PROGRESS { return incomplete_response(); }
    if head.status == status.TOO_LONG { return error("HTTP response head exceeds limit"); }
    if head.status != status.OK { return error("invalid HTTP response head"); }
    if !strings.starts_with(head.start_line, "HTTP/1.1 ") {
        return error("invalid HTTP response line");
    }

    def rest: string = slice_or_empty(head.start_line, 9,
        strings.byte_length(head.start_line) - 9);
    if strings.byte_length(rest) < 3 { return error("invalid HTTP response code"); }

    def digits: string = slice_or_empty(rest, 0, 3);

    for def mut index: u64 = 0; index < 3; index = index + 1 {
        def digit: u8 = byte_or_zero(digits, index);
        if digit < 48 || digit > 57 { return error("invalid HTTP response code"); }
    }

    def parsed: result<i32> = std.parse_i32(digits);
    if parsed.erroneous { return error("invalid HTTP response code"); }
    if parsed.value < 100 || parsed.value > 599 {
        return error("invalid HTTP response code");
    }
    if (parsed.value < 200 || parsed.value == 204)
        && (head.has_content_length || head.chunked) {
        return error("body framing is forbidden for this HTTP response code");
    }
    if strings.byte_length(rest) < 4 { return error("invalid HTTP response reason separator"); }

    if strings.byte_length(rest) > 3 {
        if byte_or_zero(rest, 3) != 32
            || !header_value(slice_or_empty(rest, 4, strings.byte_length(rest) - 4)) {
            return error("invalid HTTP response reason");
        }
    }

    return ResponseHead {
        complete: true,
        header_bytes: head.header_bytes,
        content_length: head.content_length,
        has_content_length: head.has_content_length,
        chunked: head.chunked,
        code: parsed.value
    };
}

// Full fixed-length request framing. A missing Content-Length means an empty
// body. complete=false asks the caller to append more bytes and parse again.
def pub frame_request(bytes: string, max_header_bytes: u64,
    max_body_bytes: u64) -> result<Frame> {
    def parsed: result<RequestHead> = parse_request(bytes, max_header_bytes);
    if parsed.erroneous { return parsed.error; }
    if !parsed.value.complete { return incomplete_frame(); }

    def framed: result<Frame> = body_frame(bytes, parsed.value.header_bytes,
        parsed.value.content_length, max_body_bytes);
    if framed.erroneous { return framed.error; }

    return framed.value;
}

// Full fixed-length response framing. Responses without Content-Length need
// separate EOF framing and therefore return an error here.
def pub frame_response(bytes: string, max_header_bytes: u64,
    max_body_bytes: u64) -> result<Frame> {
    def parsed: result<ResponseHead> = parse_response(bytes, max_header_bytes);
    if parsed.erroneous { return parsed.error; }
    if !parsed.value.complete { return incomplete_frame(); }
    if parsed.value.code < 200 || parsed.value.code == 204 || parsed.value.code == 304 {
        return Frame {
            complete: true,
            consumed: parsed.value.header_bytes,
            body: ""
        };
    }
    if parsed.value.chunked || !parsed.value.has_content_length {
        return error("HTTP response needs Content-Length for fixed framing");
    }

    def zero: u64 = 0;
    if parsed.value.code == 205 && parsed.value.content_length != zero {
        return error("HTTP 205 response cannot contain content");
    }

    def framed: result<Frame> = body_frame(bytes, parsed.value.header_bytes,
        parsed.value.content_length, max_body_bytes);
    if framed.erroneous { return framed.error; }

    return framed.value;
}

def valid_field(text: string) -> bool {
    return !strings.is_empty(text) && !strings.contains(text, "\r")
        && !strings.contains(text, "\n") && header_value(text);
}

def valid_host(text: string) -> bool {
    if !valid_field(text) { return false; }

    for def mut index: u64 = 0; index < strings.byte_length(text); index = index + 1 {
        def byte: u8 = byte_or_zero(text, index);
        if byte <= 32 || byte == 127 { return false; }
    }

    return true;
}

// Creates a complete GET head; caller sends it using Socket.write_text and
// advances on short sends. No implicit network I/O or body allocation.
def pub format_get(memory: &arena.GeneralArena, host: string,
    target: string,
    max_bytes: u64) -> result<string> {
    if !valid_host(host) || !request_target(target) {
        return error("invalid HTTP host or request target");
    }

    def fixed: u64 = strings.byte_length("GET ") +
    strings.byte_length(" HTTP/1.1\r\nHost: ") +
    strings.byte_length("\r\nConnection: close\r\n\r\n");
    if fixed > max_bytes { return error("HTTP request head exceeds output limit"); }

    def mut remaining: u64 = max_bytes - fixed;
    def host_bytes: u64    = strings.byte_length(host);

    if host_bytes > remaining { return error("HTTP request head exceeds output limit"); }

    remaining = remaining - host_bytes;

    def target_bytes: u64 = strings.byte_length(target);
    if target_bytes > remaining { return error("HTTP request head exceeds output limit"); }

    remaining = remaining - target_bytes;

    def made: result<strings.StringBuilder> = strings.StringBuilder.create(memory, max_bytes - remaining);
    if made.erroneous { return error("HTTP request buffer allocation failed"); }

    def mut builder: strings.StringBuilder = made.value;
    if !append_succeeded(builder.append("GET ")) || !append_succeeded(builder.append(target))
        || !append_succeeded(builder.append(" HTTP/1.1\r\nHost: "))
        || !append_succeeded(builder.append(host))
        || !append_succeeded(builder.append("\r\nConnection: close\r\n\r\n")) {
        return error("HTTP request head exceeds output limit");
    }

    def completed: result<string> = builder.to_string(memory);
    if completed.erroneous { return error("HTTP request copy failed"); }

    return completed.value;
}

// Fixed-length response head. Body bytes are sent separately and must match
// content_length. This helper uses Connection: close to avoid reuse ambiguity.
def pub format_response(memory: &arena.GeneralArena, code: i32, reason: string,
    content_type: string,
    content_length: u64,
    max_bytes: u64) -> result<string> {
    if code < 200 || code > 599 || code == 204 || code == 205
        || code == 304 || !valid_field(reason)
        || !valid_field(content_type) {
        return error("invalid HTTP response fields");
    }

    def number: result<string> = std.format_i32(memory, code);
    if number.erroneous { return error("HTTP status formatting failed"); }

    def size: result<string> = std.format_u64(memory, content_length);
    if size.erroneous { return error("HTTP body length formatting failed"); }

    def fixed: u64 = strings.byte_length("HTTP/1.1 ") + strings.byte_length(" ") +
    strings.byte_length("\r\nContent-Type: ") +
    strings.byte_length("\r\nContent-Length: ") +
    strings.byte_length("\r\nConnection: close\r\n\r\n");
    if fixed > max_bytes { return error("HTTP response head exceeds output limit"); }

    def mut remaining: u64 = max_bytes - fixed;
    def number_bytes: u64  = strings.byte_length(number.value);

    if number_bytes > remaining { return error("HTTP response head exceeds output limit"); }

    remaining = remaining - number_bytes;

    def reason_bytes: u64 = strings.byte_length(reason);
    if reason_bytes > remaining { return error("HTTP response head exceeds output limit"); }

    remaining = remaining - reason_bytes;

    def type_bytes: u64 = strings.byte_length(content_type);
    if type_bytes > remaining { return error("HTTP response head exceeds output limit"); }

    remaining = remaining - type_bytes;

    def size_bytes: u64 = strings.byte_length(size.value);
    if size_bytes > remaining { return error("HTTP response head exceeds output limit"); }

    remaining = remaining - size_bytes;

    def made: result<strings.StringBuilder> = strings.StringBuilder.create(memory, max_bytes - remaining);
    if made.erroneous { return error("HTTP response buffer allocation failed"); }

    def mut builder: strings.StringBuilder = made.value;
    if !append_succeeded(builder.append("HTTP/1.1 "))
        || !append_succeeded(builder.append(number.value)) || !append_succeeded(builder.append(" "))
        || !append_succeeded(builder.append(reason))
        || !append_succeeded(builder.append("\r\nContent-Type: "))
        || !append_succeeded(builder.append(content_type))
        || !append_succeeded(builder.append("\r\nContent-Length: "))
        || !append_succeeded(builder.append(size.value))
        || !append_succeeded(builder.append("\r\nConnection: close\r\n\r\n")) {
        return error("HTTP response head exceeds output limit");
    }

    def completed: result<string> = builder.to_string(memory);
    if completed.erroneous { return error("HTTP response copy failed"); }

    return completed.value;
}

// Header names are case-insensitive. Values may contain counted non-ASCII bytes,
// but never CR, LF, NUL, or other controls except horizontal tab.
def pub struct Header {
    def pub name: string,
    def pub value: string,
}

// A validated request head. The body is sent separately and must have exactly
// content_length bytes. Framing, authority, and connection headers are owned here.
def pub format_request(memory: &arena.GeneralArena, method: string, host: string,
    target: string,
    headers: [const Header],
    content_length: u64,
    max_bytes: u64) -> result<string> {
    if !token(method) || strings.equal(method, "CONNECT")
        || !valid_host(host) || !request_target(target) {
        return error("invalid HTTP request fields");
    }
    if (strings.equal(method, "GET") || strings.equal(method, "HEAD")) && content_length != 0 {
        return error("GET and HEAD request bodies are unsupported");
    }

    def size: result<string> = std.to_string_u64(memory, content_length);
    if size.erroneous { return size.error; }

    def size_text: string = size.value;
    def fixed: u64        = strings.byte_length("  HTTP/1.1\r\nHost: \r\nContent-Length: \r\nConnection: close\r\n\r\n");

    if fixed > max_bytes { return error("HTTP request head exceeds output limit"); }

    def mut remaining: u64  = max_bytes - fixed;
    def fields: [string; 4] = {method, host, target, size_text};

    for def mut i: u64 = 0; i < 4; i = i + 1 {
        def count: u64 = strings.byte_length(fields[i]);
        if count > remaining { return error("HTTP request head exceeds output limit"); }

        remaining = remaining - count;
    }

    for def mut i: u64 = 0; i < headers.len; i = i + 1 {
        def field: Header = headers[i];
        if !token(field.name) || !header_value(field.value)
            || equals_header_name(field.name, "Host")
            || equals_header_name(field.name, "Content-Length")
            || equals_header_name(field.name, "Transfer-Encoding")
            || equals_header_name(field.name, "Connection")
            || equals_header_name(field.name, "Trailer")
            || equals_header_name(field.name, "TE")
            || equals_header_name(field.name, "Upgrade")
            || equals_header_name(field.name, "Expect") {
            return error("invalid or reserved HTTP request header");
        }
        if remaining < 4 { return error("HTTP request head exceeds output limit"); }

        remaining = remaining - 4;

        def name_bytes: u64  = strings.byte_length(field.name);
        def value_bytes: u64 = strings.byte_length(field.value);

        if name_bytes > remaining { return error("HTTP request head exceeds output limit"); }

        remaining = remaining - name_bytes;

        if value_bytes > remaining { return error("HTTP request head exceeds output limit"); }

        remaining = remaining - value_bytes;
    }

    def made: result<strings.StringBuilder> = strings.StringBuilder.create(memory, max_bytes - remaining);
    if made.erroneous { return error("HTTP request buffer allocation failed"); }

    def mut builder: strings.StringBuilder = made.value;
    if !append_succeeded(builder.append(method)) || !append_succeeded(builder.append(" "))
        || !append_succeeded(builder.append(target)) || !append_succeeded(builder.append(" HTTP/1.1\r\nHost: "))
        || !append_succeeded(builder.append(host)) || !append_succeeded(builder.append("\r\nContent-Length: "))
        || !append_succeeded(builder.append(size_text)) || !append_succeeded(builder.append("\r\nConnection: close\r\n")) {
        return error("HTTP request formatting failed");
    }

    for def mut i: u64 = 0; i < headers.len; i = i + 1 {
        if !append_succeeded(builder.append(headers[i].name)) || !append_succeeded(builder.append(": "))
            || !append_succeeded(builder.append(headers[i].value)) || !append_succeeded(builder.append("\r\n")) {
            return error("HTTP request formatting failed");
        }
    }

    if !append_succeeded(builder.append("\r\n")) { return error("HTTP request formatting failed"); }

    def completed: result<string> = builder.to_string(memory);
    if completed.erroneous { return error("HTTP request copy failed"); }

    return completed.value;
}

def pub struct HeaderItem {
    def pub available: bool,
    def pub field: Header,
}

// Copies have independent cursors; field views borrow the complete head.
def pub struct Headers {
    def text: string,
    def mut offset: u64,

    def pub next(self: &Headers) -> HeaderItem {
        def rest: string = slice_or_empty(self.text, self.offset,
            strings.byte_length(self.text) - self.offset);
        def line_end: strings.FindResult = strings.find(rest, "\r\n");

        if !line_end.found || line_end.offset == 0 {
            return HeaderItem {
                available: false,
                field: Header {
                    name: "",
                    value: ""
                }
            };
        }

        def line: string              = slice_or_empty(rest, 0, line_end.offset);
        def colon: strings.FindResult = strings.find(line, ":");
        self.offset = self.offset + line_end.offset + 2;

        return HeaderItem {
            available: true,
            field: Header {
                name: slice_or_empty(line, 0, colon.offset),
                value: strings.trim_ascii(slice_or_empty(line, colon.offset + 1,
                    strings.byte_length(line) - colon.offset - 1))
            }
        };
    }

}

// Validates a complete head before exposing field views, including duplicates
// in wire order. Callers decide the semantics of non-framing duplicate fields.
def pub headers(bytes: string, max_header_bytes: u64) -> result<Headers> {
    def parsed: HeadResult = parse_head(bytes, max_header_bytes);
    if parsed.status != status.OK { return error("HTTP headers require a valid complete head"); }

    return Headers {
        text: slice_or_empty(bytes, 0, parsed.header_bytes),
        offset: strings.byte_length(parsed.start_line) + 2
    };
}

def pub header_name_equal(name: string, expected: string) -> bool {
    return equals_header_name(name, expected);
}

// Response views remain valid while the supplied head/body buffers are live
// and unchanged. Content-Encoding (e.g. gzip) is never decoded implicitly.
def pub struct Response {
    def pub code: i32,
    def pub head: string,
    def pub body: string,
}

def pub struct ResponseProgress {
    def pub complete: bool,
    def pub consumed: u64,
}

def const READ_HEAD: i32     = 0;
def const READ_FIXED: i32    = 1;
def const READ_CLOSE: i32    = 2;
def const READ_SIZE: i32     = 3;
def const READ_DATA: i32     = 4;
def const READ_DATA_CR: i32  = 5;
def const READ_DATA_LF: i32  = 6;
def const READ_TRAILERS: i32 = 7;
def const READ_DONE: i32     = 8;
def const READ_FAILED: i32   = 9;

def const CR: u8    = 13;
def const LF: u8    = 10;
def const ZERO: u64 = 0;

def hex_digit(byte: u8) -> u64 {
    for def mut digit: u64 = 0; digit < 16; digit = digit + 1 {
        if ascii_lower(byte) == byte_or_zero("0123456789abcdef", digit) { return digit; }
    }

    return 16;
}

def space(byte: u8) -> bool { return byte == 32 || byte == 9; }

def chunk_length(line: string) -> result<u64> {
    def length: u64     = strings.byte_length(line);
    def mut cursor: u64 = 0;
    def mut value: u64  = 0;

    while cursor < length && hex_digit(byte_or_zero(line, cursor)) < 16 {
        def number: u64 = hex_digit(byte_or_zero(line, cursor));
        if value > (18446744073709551615 - number) / 16 {
            return error("HTTP chunk size overflows u64");
        }

        value  = value * 16 + number;
        cursor = cursor + 1;
    }

    if cursor == 0 { return error("invalid HTTP chunk size"); }

    // Validate extensions, including quoted strings, before ignoring their values.
    while cursor < length {
        while cursor < length && space(byte_or_zero(line, cursor)) { cursor = cursor + 1; }
        if cursor == length || byte_or_zero(line, cursor) != 59 {
            return error("invalid HTTP chunk extension");
        }

        cursor = cursor + 1;
        while cursor < length && space(byte_or_zero(line, cursor)) { cursor = cursor + 1; }

        def start: u64 = cursor;

        while cursor < length && token(slice_or_empty(line, cursor, 1)) { cursor = cursor + 1; }
        if cursor == start { return error("invalid HTTP chunk extension name"); }

        while cursor < length && space(byte_or_zero(line, cursor)) { cursor = cursor + 1; }
        if cursor < length && byte_or_zero(line, cursor) == 61 {
            cursor = cursor + 1;
            while cursor < length && space(byte_or_zero(line, cursor)) { cursor = cursor + 1; }
            if cursor == length { return error("missing HTTP chunk extension value"); }

            if byte_or_zero(line, cursor) == 34 {
                cursor = cursor + 1;

                def mut closed: bool = false;

                while cursor < length && !closed {
                    def byte: u8 = byte_or_zero(line, cursor);
                    cursor = cursor + 1;

                    if byte == 34 {
                        closed = true;
                    } else if byte == 92 {
                        if cursor == length { return error("invalid HTTP chunk quoted escape"); }

                        def escaped: u8 = byte_or_zero(line, cursor);
                        if escaped != 9 && (escaped < 32 || escaped == 127) {
                            return error("invalid HTTP chunk quoted escape");
                        }

                        cursor = cursor + 1;
                    } else if byte != 9 && (byte < 32 || byte == 127) {
                        return error("invalid HTTP chunk quoted value");
                    }
                }

                if !closed { return error("unterminated HTTP chunk extension"); }
            } else {
                def start_value: u64 = cursor;

                while cursor < length && token(slice_or_empty(line, cursor, 1)) { cursor = cursor + 1; }
                if cursor == start_value { return error("invalid HTTP chunk extension value"); }
            }
        }
    }

    return value;
}

// A validated final head. Its view borrows the decoder's head storage.
def pub struct ResponseInfo {
    def pub code: i32,
    def pub head: string,
}

def pub struct StreamProgress {
    def pub complete: bool,
    def pub consumed: u64,
    def pub produced: u64,
    def pub head_ready: bool,
}

// Incremental decoding with reusable output storage and a total body limit.
// Stops at the final head boundary and when output fills; retain unconsumed input.
// Each input byte is consumed once. Chunk-size/trailer lines are capped at 1024 bytes each;
// max_metadata_bytes bounds all heads, chunk syntax, and trailers together.
// Copies alias the buffers: use one reader at a time for a given storage pair.
def pub struct ResponseDecoder {
    def head_storage: [u8],
    def body_limit: u64,
    def method: string,
    def metadata_limit: u64,
    def mut metadata_used: u64,
    def mut head_used: u64,
    def mut body_used: u64,
    def mut remaining: u64,
    def mut state: i32,
    def mut code: i32,
    def mut line: [u8; 1024],
    def mut line_used: u64,

    def pub static create(head_storage: [u8], max_body_bytes: u64, method: string,
        max_metadata_bytes: u64) -> result<ResponseDecoder> {
        if head_storage.len == ZERO || max_metadata_bytes == 0 || !token(method)
            || strings.equal(method, "CONNECT") {
            return error("invalid HTTP response reader configuration");
        }

        def empty: [u8; 1024] = zeroed;

        return ResponseDecoder {
            head_storage: head_storage,
            body_limit: max_body_bytes,
            method: method,
            metadata_limit: max_metadata_bytes,
            metadata_used: 0,
            head_used: 0,
            body_used: 0,
            remaining: 0,
            state: READ_HEAD,
            code: 0,
            line: empty,
            line_used: 0
        };
    }

    def consume(self: &ResponseDecoder, bytes: string, output: [u8]) -> result<StreamProgress> {
        def mut produced: u64 = 0;
        def mut cursor: u64   = 0;

        while cursor < strings.byte_length(bytes) && self.state != READ_DONE {
            def byte: u8 = byte_or_zero(bytes, cursor);

            if self.state == READ_FIXED || self.state == READ_CLOSE || self.state == READ_DATA {
                if self.body_used == self.body_limit || self.code == 205 {
                    return error("HTTP response body exceeds limit");
                }
                if produced == output.len {
                    return StreamProgress {
                        complete: false,
                        consumed: cursor,
                        produced: produced,
                        head_ready: true
                    };
                }

                output[produced] = byte;
                produced = produced + 1;
                self.body_used = self.body_used + 1;

                if self.state != READ_CLOSE {
                    self.remaining = self.remaining - 1;

                    if self.remaining == 0 {
                        if self.state == READ_FIXED {
                            self.state = READ_DONE;
                        } else { self.state = READ_DATA_CR; }
                    }
                }
            } else {
                if self.metadata_used == self.metadata_limit {
                    return error("HTTP response metadata exceeds limit");
                }

                self.metadata_used = self.metadata_used + 1;

                if self.state == READ_HEAD {
                    if self.head_used == self.head_storage.len {
                        return error("HTTP response head exceeds limit");
                    }

                    self.head_storage[self.head_used] = byte;
                    self.head_used                    = self.head_used + 1;

                    if self.head_used >= 4 && byte == 10
                        && self.head_storage[self.head_used - 2] == CR
                        && self.head_storage[self.head_used - 3] == LF
                        && self.head_storage[self.head_used - 4] == CR {
                        def parsed: result<ResponseHead> = parse_response(
                            strings.view_bytes(self.head_storage[0..self.head_used]), self.head_storage.len);
                        if parsed.erroneous { return parsed.error; }

                        def head: ResponseHead = parsed.value;
                        self.code = head.code;

                        if head.code == 101 { return error("HTTP protocol upgrades are unsupported"); }

                        if head.code < 200 {
                            self.head_used = 0;
                        } else if strings.equal(self.method, "HEAD") || head.code == 204 || head.code == 304 {
                            self.state = READ_DONE;
                        } else if head.chunked {
                            self.state = READ_SIZE;
                        } else if head.has_content_length {
                            if head.content_length > self.body_limit
                                || (head.code == 205 && head.content_length != 0) {
                                return error("HTTP response body exceeds limit");
                            }

                            self.remaining = head.content_length;
                            self.state     = READ_FIXED;
                            if self.remaining == 0 { self.state = READ_DONE; }
                        } else { self.state = READ_CLOSE; }

                        if self.code >= 200 {
                            return StreamProgress {
                                complete: self.state == READ_DONE,
                                consumed: cursor + 1,
                                produced: produced,
                                head_ready: true
                            };
                        }
                    }
                } else if self.state == READ_DATA_CR {
                    if byte != 13 { return error("HTTP chunk data needs CRLF"); }

                    self.state = READ_DATA_LF;
                } else if self.state == READ_DATA_LF {
                    if byte != 10 { return error("HTTP chunk data needs CRLF"); }

                    self.state = READ_SIZE;
                } else {
                    if self.line_used > 0 && self.line[self.line_used - 1] == CR && byte != 10 {
                        return error("HTTP chunk line needs CRLF");
                    }

                    if byte == 10 {
                        if self.line_used == 0 || self.line[self.line_used - 1] != CR {
                            return error("HTTP chunk line needs CRLF");
                        }

                        def line: string = strings.view_bytes(self.line[0..self.line_used - 1]);

                        if self.state == READ_SIZE {
                            def parsed: result<u64> = chunk_length(line);
                            if parsed.erroneous { return parsed.error; }

                            self.remaining = parsed.value;

                            if self.remaining > self.body_limit - self.body_used
                                || (self.code == 205 && self.remaining != 0) {
                                return error("HTTP chunked body exceeds limit");
                            }

                            self.state = READ_DATA;
                            if self.remaining == 0 { self.state = READ_TRAILERS; }
                        } else if strings.is_empty(line) {
                            self.state = READ_DONE;
                        } else {
                            def colon: strings.FindResult = strings.find(line, ":");
                            if !colon.found { return error("invalid HTTP trailer"); }

                            def name: string = slice_or_empty(line, 0, colon.offset);
                            def value: string = slice_or_empty(line, colon.offset + 1,
                                strings.byte_length(line) - colon.offset - 1);

                            if !token(name) || !header_value(value)
                                || equals_header_name(name, "Content-Length")
                                || equals_header_name(name, "Transfer-Encoding")
                                || equals_header_name(name, "Host") {
                                return error("invalid or forbidden HTTP trailer");
                            }
                        }

                        self.line_used = 0;
                    } else {
                        if self.line_used == 1023 { return error("HTTP chunk line exceeds 1024 bytes"); }
                        if byte != 13 && byte != 9 && (byte < 32 || byte == 127) {
                            return error("invalid HTTP chunk line byte");
                        }

                        self.line[self.line_used] = byte;
                        self.line_used            = self.line_used + 1;
                    }
                }
            }

            cursor = cursor + 1;
        }

        return StreamProgress {
            complete: self.state == READ_DONE,
            produced: produced,
            head_ready: self.code >= 200,
            consumed: cursor
        };
    }

    // Feed bytes in wire order. eof means clean transport EOF after these bytes.
    // EOF is applied only when all supplied bytes have been consumed. Output can
    // precede a later framing failure: completion alone makes the response valid.
    def pub feed(self: &ResponseDecoder, bytes: string, eof: bool, output: [u8]) -> result<StreamProgress> {
        if self.state == READ_FAILED { return error("HTTP response reader has failed"); }

        def consumed: result<StreamProgress> = self.consume(bytes, output);
        if consumed.erroneous {
            self.state = READ_FAILED;

            return consumed.error;
        }

        def progress: StreamProgress = consumed.value;
        if eof && progress.consumed == strings.byte_length(bytes) && self.state == READ_CLOSE { self.state = READ_DONE; }
        if eof && progress.consumed == strings.byte_length(bytes) && self.state != READ_DONE {
            self.state = READ_FAILED;

            return error("HTTP response ended before completion");
        }

        return StreamProgress {
            complete: self.state == READ_DONE,
            produced: progress.produced,
            head_ready: progress.head_ready,
            consumed: progress.consumed
        };
    }

    def pub head(self: &const ResponseDecoder) -> result<ResponseInfo> {
        if self.code < 200 || self.state == READ_FAILED { return error("HTTP final head is unavailable"); }

        return ResponseInfo {
            code: self.code,
            head: strings.view_bytes(self.head_storage[0..self.head_used])
        };
    }

}

// Whole-body convenience wrapper over the streaming decoder. Copies alias storage.
def pub struct ResponseReader {
    def mut decoder: ResponseDecoder,
    def body_storage: [u8],
    def mut body_used: u64,
    def mut complete: bool,

    def pub static create(head_storage: [u8], body_storage: [u8], method: string,
        max_metadata_bytes: u64) -> result<ResponseReader> {
        def made: result<ResponseDecoder> = ResponseDecoder.create(
            head_storage, body_storage.len, method, max_metadata_bytes);
        if made.erroneous { return made.error; }

        return ResponseReader {
            decoder: made.value,
            body_storage: body_storage,
            body_used: 0,
            complete: false
        };
    }

    def pub feed(self: &ResponseReader, bytes: string, eof: bool) -> result<ResponseProgress> {
        def mut cursor: u64 = 0;
        def mut again: bool = true;

        while again {
            def decoded: result<StreamProgress> = self.decoder.feed(
                slice_or_empty(bytes, cursor, strings.byte_length(bytes) - cursor),
                eof, self.body_storage[self.body_used..]);
            if decoded.erroneous { return decoded.error; }

            def step: StreamProgress = decoded.value;
            cursor = cursor + step.consumed;
            self.body_used = self.body_used + step.produced;
            self.complete  = step.complete;
            again = !step.complete && cursor < strings.byte_length(bytes);
        }

        return ResponseProgress {
            complete: self.complete,
            consumed: cursor
        };
    }

    def pub response(self: &const ResponseReader) -> result<Response> {
        if !self.complete { return error("HTTP response is incomplete"); }

        def head: result<ResponseInfo> = self.decoder.head();
        if head.erroneous { return head.error; }

        return Response {
            code: head.value.code,
            head: head.value.head,
            body: strings.view_bytes(self.body_storage[0..self.body_used])
        };
    }

}

// A failed range produces empty text under this caller's existing policy.
// The returned view still borrows the source bytes.
def slice_or_empty(text: string, start: u64, length: u64) -> string {
    def view: result<string> = strings.slice_bytes(text, start, length);
    if view.erroneous { return ""; }

    return view.value;
}

// Parser/lookahead policy: an out-of-range byte is the zero sentinel.
// Preserve this caller policy explicitly; public string access returns a result.
def byte_or_zero(text: string, index: u64) -> u8 {
    def byte: result<u8> = strings.byte_at(text, index);
    if byte.erroneous { return 0; }

    return byte.value;
}

// Keep append chains short-circuiting while explicitly handling every result.
def append_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}
