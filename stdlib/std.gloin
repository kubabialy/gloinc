// Example: format_f32(&memory, 1.25) -> success "1.25".
// Shortest round-trip decimal, preserves -0; locale-independent.
// Bounded O(1) byte work plus arena allocation; requests 32 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_f32(memory: &arena.GeneralArena, value: f32) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(32);
    if bytes == null {
        return error("f32 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_f32(value, &*bytes, &length);

    if code != status.OK {
        return error("f32 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Example: format_f64(&memory, 1.25) -> success "1.25".
// Shortest round-trip decimal, preserves -0; locale-independent.
// Bounded O(1) byte work plus arena allocation; requests 32 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_f64(memory: &arena.GeneralArena, value: f64) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(32);
    if bytes == null {
        return error("f64 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_f64(value, &*bytes, &length);

    if code != status.OK {
        return error("f64 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Example: format_f32_fixed(&memory, 1.25, 2) -> success "1.25".
// Fixed decimal, nearest/ties-even; precision 0..18, otherwise INVALID before allocation.
// Bounded O(1) byte work plus arena allocation; requests 64 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_f32_fixed(memory: &arena.GeneralArena, value: f32, precision: u32) -> result<string> {
    if precision > 18 {
        return error("precision exceeds 18 digits", status.INVALID, 0);
    }

    def bytes: *u8 = memory.try_alloc_bytes(64);
    if bytes == null {
        return error("f32_fixed formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_f32_fixed(value, precision, &*bytes, &length);

    if code != status.OK {
        return error("f32_fixed formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Example: format_f64_fixed(&memory, 1.25, 2) -> success "1.25".
// Fixed decimal, nearest/ties-even; precision 0..18, otherwise INVALID before allocation.
// Bounded O(1) byte work plus arena allocation; requests 352 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_f64_fixed(memory: &arena.GeneralArena, value: f64, precision: u32) -> result<string> {
    if precision > 18 {
        return error("precision exceeds 18 digits", status.INVALID, 0);
    }

    def bytes: *u8 = memory.try_alloc_bytes(352);
    if bytes == null {
        return error("f64_fixed formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_f64_fixed(value, precision, &*bytes, &length);

    if code != status.OK {
        return error("f64_fixed formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Example: i64_from_i32(42) -> success 42.
// Exact widening; returns plain i64 and cannot fail. Uses GloinIR exact widening.
// O(1), no allocation.
def pub i64_from_i32(value: i32) -> i64 {
    def mut output: i64 = 0;

    __std_i64_from_i32(value, &output);

    return output;
}

// Example: i32_from_i64(42) -> success 42.
// OVERFLOW outside i32 range; no wrapping.
// O(1), no allocation.
def pub i32_from_i64(value: i64) -> result<i32> {
    def mut output: i32 = 0;
    def code: i32       = __std_i32_from_i64(value, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: u64_from_i64(42) -> success 42.
// Negative input -> OVERFLOW; no wrapping.
// O(1), no allocation.
def pub u64_from_i64(value: i64) -> result<u64> {
    def mut output: u64 = 0;
    def code: i32       = __std_u64_from_i64(value, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: i64_from_u64(42) -> success 42.
// Input above i64 maximum -> OVERFLOW.
// O(1), no allocation.
def pub i64_from_u64(value: u64) -> result<i64> {
    def mut output: i64 = 0;
    def code: i32       = __std_i64_from_u64(value, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: f64_from_i64_exact(42) -> success 42.
// INEXACT if f64 cannot represent the integer exactly.
// O(1), no allocation.
def pub f64_from_i64_exact(value: i64) -> result<f64> {
    def mut output: f64 = 0.0;
    def code: i32       = __std_f64_from_i64(value, 0, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: f64_from_i64_rounded(42) -> success 42.
// Round nearest/ties-even; returns plain f64, may lose integer precision, cannot fail.
// O(1), no allocation.
def pub f64_from_i64_rounded(value: i64) -> f64 {
    def mut output: f64 = 0.0;

    __std_f64_from_i64(value, 1, &output);

    return output;
}

// Example: f64_from_u64_exact(42) -> success 42.
// INEXACT if f64 cannot represent the integer exactly.
// O(1), no allocation.
def pub f64_from_u64_exact(value: u64) -> result<f64> {
    def mut output: f64 = 0.0;
    def code: i32       = __std_f64_from_u64(value, 0, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: f64_from_u64_rounded(42) -> success 42.
// Round nearest/ties-even; returns plain f64, may lose integer precision, cannot fail.
// O(1), no allocation.
def pub f64_from_u64_rounded(value: u64) -> f64 {
    def mut output: f64 = 0.0;

    __std_f64_from_u64(value, 1, &output);

    return output;
}

// Example: i64_from_f64_exact(42.0) -> success 42.
// Fraction -> INEXACT; out-of-range truncated candidate -> OVERFLOW first.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub i64_from_f64_exact(value: f64) -> result<i64> {
    def mut output: i64 = 0;
    def code: i32       = __std_i64_from_f64(value, 0, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: i64_from_f64_trunc(42.9) -> success 42.
// Explicit truncation toward zero; out-of-range candidate -> OVERFLOW.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub i64_from_f64_trunc(value: f64) -> result<i64> {
    def mut output: i64 = 0;
    def code: i32       = __std_i64_from_f64(value, 1, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: u64_from_f64_exact(42.0) -> success 42.
// Fraction -> INEXACT; out-of-range truncated candidate -> OVERFLOW first.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub u64_from_f64_exact(value: f64) -> result<u64> {
    def mut output: u64 = 0;
    def code: i32       = __std_u64_from_f64(value, 0, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: u64_from_f64_trunc(42.9) -> success 42.
// Truncate toward zero; -0.5 becomes 0; out-of-range candidate -> OVERFLOW.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub u64_from_f64_trunc(value: f64) -> result<u64> {
    def mut output: u64 = 0;
    def code: i32       = __std_u64_from_f64(value, 1, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: f64_from_f32(1.25) -> success 1.25.
// Exact widening including subnormals and signed zero.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub f64_from_f32(value: f32) -> result<f64> {
    def mut output: f64 = 0.0;
    def code: i32       = __std_f64_from_f32(value, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: f32_from_f64_exact(1.25) -> success 1.25.
// OVERFLOW beyond f32 maximum, UNDERFLOW to zero, otherwise INEXACT on precision loss.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub f32_from_f64_exact(value: f64) -> result<f32> {
    def mut output: f32 = 0.0;
    def code: i32       = __std_f32_from_f64(value, 0, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Example: f32_from_f64_rounded(1.25) -> success 1.25.
// Nearest/ties-even, preserving -0; still reports OVERFLOW and nonzero UNDERFLOW.
// O(1), no allocation; failure has no readable payload. Native nonfinite input -> INVALID.
def pub f32_from_f64_rounded(value: f64) -> result<f32> {
    def mut output: f32 = 0.0;
    def code: i32       = __std_f32_from_f64(value, 1, &output);

    if code != status.OK { return conversion_error(code); }

    return output;
}

// Shared conversion categories; native primitives validate before writing output.
def conversion_error(code: i32) -> error {
    if code == status.INVALID { return error("numeric conversion requires a finite value", code, 0); }
    if code == status.OVERFLOW { return error("numeric conversion is out of range", code, 0); }
    if code == status.INEXACT { return error("numeric conversion loses precision", code, 0); }
    if code == status.UNDERFLOW { return error("numeric conversion underflows to zero", code, 0); }

    return error("numeric conversion failed", code, 0);
}
