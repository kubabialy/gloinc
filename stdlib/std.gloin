// Checked decimal conversion; returned text borrows memory.
def pub to_string_u32(memory: &arena.GeneralArena, value: u32) -> result<string> {
    def formatted: result<string> = format_u32(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
