import "@arena";
import "@status";

// Standard utility functions. __write_stdout is the native byte-output primitive.
// Example: std.print("hello"); exact counted bytes, no added newline.
// O(n) byte work plus blocking output/flush; no Gloin allocation. Output failure traps/reports a JIT error.
def pub print(value: string) -> void {
    __write_stdout(value);
}

// Example: std.println("hello"); writes text and LF with two print/flush calls.
// O(n) byte work plus blocking I/O; no Gloin allocation; same output failure policy.
def pub println(value: string) -> void {
    print(value);
    print("\n");
}

// Compatibility aliases for @status codes. Recoverable failures use built-in results.
def pub const OK: i32        = status.OK;
def pub const END: i32       = status.END;
def pub const INVALID: i32   = status.INVALID;
def pub const OVERFLOW: i32  = status.OVERFLOW;
def pub const IO_ERROR: i32  = status.IO_ERROR;
def pub const TOO_LONG: i32  = status.TOO_LONG;
def pub const NO_MEMORY: i32 = status.NO_MEMORY;

// Example: std.to_int("42") -> success 42. Strict signed decimal i32, O(n), no allocation.
// INVALID/OVERFLOW expose only an error. parse_i32 and parse_i32_checked are aliases.
def pub to_int(value: string) -> result<i32> {
    def mut number: i32 = 0;
    def code: i32       = __std_parse_i32(value, &number);

    if code == status.INVALID { return error("invalid signed decimal i32", code, 0); }
    if code != status.OK { return error("signed decimal i32 is out of range", code, 0); }

    return number;
}

// Example: std.to_string(&memory, 42) -> success "42". Bounded O(1) formatting plus arena allocation.
// Requests 12 bytes; allocation failure returns NO_MEMORY. Bytes expire on memory.reset/free.
def pub to_string(memory: &arena.GeneralArena, value: i32) -> result<string> {
    def formatted: result<string> = format_i32(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
}

// A successful input outcome. Empty lines have end=false; EOF has end=true.
// value borrows the input arena on a line, and is static empty text at EOF.
def pub struct InputLine {
    def pub end: bool,
    def pub value: string,
}

// Example: std.input(&memory, 128) reads one bounded line. Blocks for input; drains oversized lines.
// O(consumed bytes + max_bytes zeroing) plus arena allocation; reserves max_bytes+1 bytes,
// retained even on EOF/error. Check .erroneous, then .value.end; line bytes expire on reset/free.
def pub input(memory: &arena.GeneralArena, max_bytes: u64) -> result<InputLine> {
    // Validate before allocation or consuming stdin. Keep the existing size limit.
    if max_bytes > 9223372036854775806 {
        return error("input buffer size is not representable", status.NO_MEMORY, 0);
    }

    def bytes: *u8 = memory.try_alloc_bytes(max_bytes + 1);
    if bytes == null { return error("cannot allocate input buffer", status.NO_MEMORY, 0); }

    def mut length: u64 = 0;
    def code: i32       = __std_input(&*bytes, max_bytes, &length);

    if code == status.END { return InputLine { end: true, value: "" }; }
    if code == status.TOO_LONG { return error("input line exceeds byte limit", code, 0); }
    if code != status.OK { return error("cannot read standard input", code, 0); }

    return InputLine { end: false, value: __std_string_view(bytes, length) };
}

// Numeric errors carry @status categories and os_error = 0; no failure payload is readable.
// See docs/numbers.md for grammar, exact range/rounding rules, examples, and costs.
def pub const INEXACT: i32   = status.INEXACT;
def pub const UNDERFLOW: i32 = status.UNDERFLOW;

// Example: parse_i32("-42") -> success -42. O(n), no allocation; identical to to_int.
// Complete signed ASCII decimal; errors preserve INVALID/OVERFLOW codes.
def pub parse_i32(value: string) -> result<i32> {
    def parsed: result<i32> = to_int(value);
    if parsed.erroneous { return parsed.error; }

    return parsed.value;
}

// Example: parse_i32_checked("42") -> success 42. O(n), no allocation.
// Malformed text and overflow return distinct static error messages.
// The caller must inspect .erroneous before reading .value or .error.
def pub parse_i32_checked(value: string) -> result<i32> {
    def parsed: result<i32> = to_int(value);
    if parsed.erroneous { return parsed.error; }

    return parsed.value;
}

// Example: parse_i64("-9223372036854775808") succeeds with that value.
// Signed ASCII decimal; INVALID precedes OVERFLOW.
// O(n), bounded auxiliary storage, no allocation; complete input required, no trimming.
def pub parse_i64(text: string) -> result<i64> {
    def mut value: i64 = 0;
    def code: i32      = __std_parse_i64(text, &value);

    if code == status.INVALID { return error("invalid signed decimal i64", code, 0); }
    if code != status.OK { return error("signed decimal i64 is out of range", code, 0); }

    return value;
}

// Example: parse_u64("18446744073709551615") succeeds with that value.
// Unsigned ASCII decimal with optional +; any minus is INVALID.
// O(n), bounded auxiliary storage, no allocation; complete input required, no trimming.
def pub parse_u64(text: string) -> result<u64> {
    def mut value: u64 = 0;
    def code: i32      = __std_parse_u64(text, &value);

    if code == status.INVALID { return error("invalid unsigned decimal u64", code, 0); }
    if code != status.OK { return error("unsigned decimal u64 is out of range", code, 0); }

    return value;
}

// Example: parse_f32("1.25") succeeds with that value.
// Direct-width nearest/ties-even; INVALID, OVERFLOW, or nonzero UNDERFLOW.
// O(n), bounded auxiliary storage, no allocation; complete input required, no trimming.
def pub parse_f32(text: string) -> result<f32> {
    def mut value: f32 = 0.0;
    def code: i32      = __std_parse_f32(text, &value);

    if code == status.INVALID { return error("invalid decimal f32", code, 0); }
    if code == status.UNDERFLOW { return error("decimal f32 underflows to zero", code, 0); }
    if code != status.OK { return error("decimal f32 is out of range", code, 0); }

    return value;
}

// Example: parse_f64("1.25") succeeds with that value.
// Direct-width nearest/ties-even; INVALID, OVERFLOW, or nonzero UNDERFLOW.
// O(n), bounded auxiliary storage, no allocation; complete input required, no trimming.
def pub parse_f64(text: string) -> result<f64> {
    def mut value: f64 = 0.0;
    def code: i32      = __std_parse_f64(text, &value);

    if code == status.INVALID { return error("invalid decimal f64", code, 0); }
    if code == status.UNDERFLOW { return error("decimal f64 underflows to zero", code, 0); }
    if code != status.OK { return error("decimal f64 is out of range", code, 0); }

    return value;
}

// Example: parse_bool("true") -> success true; "TRUE" fails with INVALID.
// Accepts exactly true/false. O(1), no allocation or retained storage.
def pub parse_bool(text: string) -> result<bool> {
    def mut byte: u8 = 0;
    def code: i32    = __std_parse_bool(text, &byte);

    if code != status.OK { return error("invalid boolean", code, 0); }

    return byte != 0;
}

// Example: format_bool(false) -> "false". O(1), no allocation, cannot fail.
// Returns a static string valid for the program's lifetime; no arena required.
def pub format_bool(value: bool) -> string {
    if value { return "true"; } return "false";
}

// Example: format_i32(&memory, 42) -> success "42".
// Canonical decimal, no implicit printing.
// Bounded O(1) byte work plus arena allocation; requests 12 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_i32(memory: &arena.GeneralArena, value: i32) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(12);
    if bytes == null {
        return error("i32 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;

    __std_format_i32(value, &*bytes, &length);

    return __std_string_view(bytes, length);
}

// Example: format_i64(&memory, 42) -> success "42".
// Canonical decimal, no implicit printing.
// Bounded O(1) byte work plus arena allocation; requests 21 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_i64(memory: &arena.GeneralArena, value: i64) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(21);
    if bytes == null {
        return error("i64 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_i64(value, &*bytes, &length);

    if code != status.OK {
        return error("i64 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Example: format_u64(&memory, 42) -> success "42".
// Canonical decimal, no implicit printing.
// Bounded O(1) byte work plus arena allocation; requests 21 bytes including NUL.
// NO_MEMORY is recoverable; returned bytes expire on destination reset/free.
def pub format_u64(memory: &arena.GeneralArena, value: u64) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(21);
    if bytes == null {
        return error("u64 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_u64(value, &*bytes, &length);

    if code != status.OK {
        return error("u64 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Canonical decimal for a u16, including 0 and 65535. One arena allocation
// of six bytes including NUL; NO_MEMORY is recoverable.
def pub format_u16(memory: &arena.GeneralArena, value: u16) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(6);
    if bytes == null {
        return error("u16 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_u16(value, &*bytes, &length);

    if code != status.OK {
        return error("u16 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Checked convenience for callers using built-in result<T>.
def pub to_string_u16(memory: &arena.GeneralArena, value: u16) -> result<string> {
    def formatted: result<string> = format_u16(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
}

// Canonical decimal for i8; requests 5 arena bytes including NUL.
def pub format_i8(memory: &arena.GeneralArena, value: i8) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(5);
    if bytes == null {
        return error("i8 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_i8(value, &*bytes, &length);

    if code != status.OK {
        return error("i8 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Canonical decimal for i16; requests 7 arena bytes including NUL.
def pub format_i16(memory: &arena.GeneralArena, value: i16) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(7);
    if bytes == null {
        return error("i16 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_i16(value, &*bytes, &length);

    if code != status.OK {
        return error("i16 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Canonical decimal for u8; requests 4 arena bytes including NUL.
def pub format_u8(memory: &arena.GeneralArena, value: u8) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(4);
    if bytes == null {
        return error("u8 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_u8(value, &*bytes, &length);

    if code != status.OK {
        return error("u8 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Canonical decimal for u32; requests 11 arena bytes including NUL.
def pub format_u32(memory: &arena.GeneralArena, value: u32) -> result<string> {
    def bytes: *u8 = memory.try_alloc_bytes(11);
    if bytes == null {
        return error("u32 formatting failed", status.NO_MEMORY, 0);
    }

    def mut length: u64 = 0;
    def code: i32       = __std_format_u32(value, &*bytes, &length);

    if code != status.OK {
        return error("u32 formatting failed", code, 0);
    }

    return __std_string_view(bytes, length);
}

// Checked decimal conversion; returned text borrows memory.
def pub to_string_i8(memory: &arena.GeneralArena, value: i8) -> result<string> {
    def formatted: result<string> = format_i8(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
}

// Checked decimal conversion; returned text borrows memory.
def pub to_string_i16(memory: &arena.GeneralArena, value: i16) -> result<string> {
    def formatted: result<string> = format_i16(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
}

