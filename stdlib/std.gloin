def pub to_string_i32(memory: &arena.GeneralArena, value: i32) -> result<string> {
    def formatted: result<string> = format_i32(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
}

// Checked decimal conversion; returned text borrows memory.
def pub to_string_i64(memory: &arena.GeneralArena, value: i64) -> result<string> {
    def formatted: result<string> = format_i64(memory, value);
    if formatted.erroneous { return formatted.error; }

    return formatted.value;
}

// Checked decimal conversion; returned text borrows memory.
def pub to_string_u8(memory: &arena.GeneralArena, value: u8) -> result<string> {
    def formatted: result<string> = format_u8(memory, value);
    if formatted.erroneous { return formatted.error; }

