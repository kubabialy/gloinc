// Nonblocking IPv4 TCP and verified client TLS. Calls are single-attempt except
// readiness waits, which have explicit timeouts. See docs/networking.md.
import "@arena";
import "@status";
import "@strings";

def pub const READABLE: i32 = 1;
def pub const WRITABLE: i32 = 2;

// host is a host-order IPv4 integer; loopback is 0x7f000001.
def pub struct Address {
    def pub host: u32,
    def pub port: u16,

    def pub static loopback(port: u16) -> Address {
        return Address {
            host: 2130706433,
            port: port
        };
    }

    def pub static any(port: u16) -> Address {
        return Address {
            host: 0,
            port: port
        };
    }

    // Converts four IPv4 octets into a host-order address without allocation.
    def pub static ipv4(a: u32, b: u32, c: u32, d: u32,
        port: u16) -> result<Address> {
        if a > 255 || b > 255 || c > 255 || d > 255 {
            return error("IPv4 octet is out of range");
        }
        return Address {
            host: a * 16777216 + b * 65536 + c * 256 + d,
            port: port
        };
    }

}

// Expected states are values. Actual syscall failures are built-in errors.
def pub struct AcceptOutcome {
    def pub available: bool,
    def pub socket: Socket,
    def pub peer: Address,
}

def pub struct ReadOutcome {
    def pub state: i32, // OK, END, or WOULD_BLOCK
    def pub count: u64,
}

def pub struct WriteOutcome {
    def pub would_block: bool,
    def pub count: u64,
}

// TLS operations return one readiness bit to wait for, or 0 on progress.
def pub struct TlsReadOutcome {
    def pub state: i32, // OK, END, or WOULD_BLOCK
    def pub count: u64,
    def pub wait_for: i32,
}

def pub struct TlsWriteOutcome {
    def pub count: u64,
    def pub wait_for: i32,
}

def struct SocketState {
    def mut descriptor: i32,
    def mut connecting: bool,
    def mut connected: bool,
    def mut write_shutdown: bool,
    def mut tls_active: bool,
}

// Copies alias shared state. Close exactly once before the owner arena is reset
// or freed. No native handle is closed automatically by arena cleanup.
def pub struct Socket {
    def state: *SocketState,

    def pub static open(owner: &arena.GeneralArena) -> result<Socket> {
        def state: *SocketState = owner.try_alloc(SocketState {
            descriptor: -1,
            connecting: false,
            connected: false,
            write_shutdown: false,
            tls_active: false
        });
        if state == null { return error("socket metadata allocation failed"); }
        def mut descriptor: i32 = -1;
        def mut failure: i32 = 0;
        def code: i32 = __net_open(&descriptor, &failure);
        if code != status.OK { return error("TCP socket creation failed"); }
        state.descriptor = descriptor;
        return Socket {
            state: state
        };
    }

    def pub is_open(self: &const Socket) -> bool {
        return self.state != null && self.state.descriptor >= 0;
    }

    def descriptor(self: &const Socket) -> i32 {
        if self.state == null { return -1; }
        return self.state.descriptor;
    }

    // An unbound socket may bind to port 0 for a kernel-assigned port.
    def pub bind(self: &Socket, address: Address) -> result<void> {
        def mut failure: i32 = 0;
        def code: i32 = __net_bind(self.descriptor(), address.host, address.port, &failure);
        if code != status.OK { return error("TCP bind failed"); }
        return;
    }

    // Set before bind when a server may restart on the same local address.
    def pub set_reuse_address(self: &Socket, enabled: bool) -> result<void> {
        def mut flag: i32 = 0;
        if enabled { flag = 1; }
        def mut failure: i32 = 0;
        def code: i32 = __net_reuse_address(self.descriptor(), flag, &failure);
        if code != status.OK { return error("TCP reuse-address option failed"); }
        return;
    }

    def pub listen(self: &Socket, backlog: i32) -> result<void> {
        def mut failure: i32 = 0;
        def code: i32 = __net_listen(self.descriptor(), backlog, &failure);
        if code != status.OK { return error("TCP listen failed"); }
        return;
    }

    def pub local_address(self: &const Socket) -> result<Address> {
        def mut host: u32 = 0;
        def mut port: u16 = 0;
        def mut failure: i32 = 0;
        def code: i32 = __net_local(self.descriptor(), &host, &port, &failure);
        if code != status.OK { return error("TCP local address lookup failed"); }
        return Address {
            host: host,
            port: port
        };
    }

    // available=false means retry after readable readiness. On success the
    // returned socket owns its descriptor; close it before owner reset.
    def pub accept(self: &Socket, owner: &arena.GeneralArena) -> result<AcceptOutcome> {
        if !self.is_open() { return error("accept on closed TCP socket"); }
        def mut accepted: i32 = -1;
        def mut host: u32 = 0;
        def mut port: u16 = 0;
        def mut failure: i32 = 0;
        def code: i32 = __net_accept(self.descriptor(), &accepted, &host, &port, &failure);
        if code == status.WOULD_BLOCK {
            return AcceptOutcome {
                available: false,
                socket: Socket {
                    state: null
                },
                peer: Address.any(0)
            };
        }
        if code != status.OK { return error("TCP accept failed"); }
        def state: *SocketState = owner.try_alloc(SocketState {
            descriptor: -1,
            connecting: false,
            connected: true,
            write_shutdown: false,
            tls_active: false
        });
        if state == null {
            def mut close_error: i32 = 0;
            __net_close(accepted, &close_error);
            return error("accepted socket metadata allocation failed");
        }
        state.descriptor = accepted;
        return AcceptOutcome {
            available: true,
            socket: Socket {
                state: state
            },
            peer: Address {
                host: host,
                port: port
            }
        };
    }

    // false means wait(WRITABLE, ...) then finish_connect(). On failure close
    // this socket; POSIX does not define reuse after failed connect.
    def pub connect(self: &Socket, address: Address) -> result<bool> {
        if !self.is_open() { return error("connect on closed TCP socket"); }
        if self.state.tls_active || self.state.connected {
            return error("TCP socket is already connected");
        }
        if self.state.connecting { return error("TCP connection is already pending"); }
        def mut failure: i32 = 0;
        def code: i32 = __net_connect(self.descriptor(), address.host, address.port, &failure);
        if code == status.IN_PROGRESS {
            self.state.connecting = true;
            return false;
        }
        if code != status.OK { return error("TCP connect failed"); }
        self.state.connected = true;
        return true;
    }

    def pub finish_connect(self: &Socket) -> result<bool> {
        if !self.is_open() || !self.state.connecting {
            return error("no pending TCP connection");
        }
        def mut failure: i32 = 0;
        def code: i32 = __net_finish_connect(self.descriptor(), &failure);
        if code == status.IN_PROGRESS { return false; }
        self.state.connecting = false;
        if code != status.OK { return error("TCP connection failed"); }
        self.state.connected = true;
        return true;
    }

    // 0 means no readiness by the deadline. A zero timeout polls immediately;
    // positive timeout may block. Readiness is only a hint; retry may still block.
    def pub wait(self: &Socket, events: i32, timeout_ms: i32) -> result<i32> {
        def mut ready: i32 = 0;
        def mut failure: i32 = 0;
        def code: i32 = __net_wait(self.descriptor(), events, timeout_ms, &ready, &failure);
        if code == status.WOULD_BLOCK || code == status.TIMED_OUT { return 0; }
        if code != status.OK { return error("TCP readiness wait failed"); }
        return ready;
    }

    // Sends TCP FIN after queued bytes and keeps the read half open.
    def pub shutdown_write(self: &Socket) -> result<void> {
        if !self.is_open() { return error("shutdown on closed TCP socket"); }
        if self.state.tls_active { return error("TCP shutdown during TLS session"); }
        if self.state.write_shutdown { return error("TCP write half already shut down"); }
        def mut failure: i32 = 0;
        def code: i32 = __net_shutdown_write(self.descriptor(), &failure);
        if code != status.OK { return error("TCP write shutdown failed"); }
        self.state.write_shutdown = true;
        return;
    }

    // One recv. END means peer closed cleanly; WOULD_BLOCK means retry later.
    // No allocation; the destination must stay live during this call.
    def pub read(self: &Socket, destination: [u8]) -> result<ReadOutcome> {
        if !self.is_open() || self.state.tls_active {
            return error("TCP read is unavailable during TLS session");
        }
        def zero: u64 = 0;
        if destination.len == zero { return error("TCP read needs nonempty storage"); }
        def mut count: u64 = 0;
        def mut failure: i32 = 0;
        def code: i32 = __net_recv(self.descriptor(), &destination[0], destination.len,
            &count, &failure);
        if code != status.OK && code != status.END && code != status.WOULD_BLOCK {
            return error("TCP read failed");
        }
        return ReadOutcome {
            state: code,
            count: count
        };
    }

    // One send; count can be short. The caller advances and retries.
    def pub write(self: &Socket, bytes: [const u8]) -> result<WriteOutcome> {
        if !self.is_open() { return error("write on closed TCP socket"); }
        if self.state.tls_active { return error("TCP write during TLS session"); }
        if self.state.write_shutdown { return error("write after TCP shutdown"); }
        def zero: u64 = 0;
        if bytes.len == zero {
            return WriteOutcome {
                would_block: false,
                count: 0
            };
        }
        def mut count: u64 = 0;
        def mut failure: i32 = 0;
        def code: i32 = __net_send(self.descriptor(), &bytes[0], bytes.len,
            &count, &failure);
        if code == status.WOULD_BLOCK {
            return WriteOutcome {
                would_block: true,
                count: 0
            };
        }
        if code != status.OK { return error("TCP write failed"); }
        return WriteOutcome {
            would_block: false,
            count: count
        };
    }

    // Send a borrowed text byte sequence, including embedded NUL. No copy.
    def pub write_text(self: &Socket, text: string) -> result<WriteOutcome> {
        if !self.is_open() { return error("write on closed TCP socket"); }
        if self.state.tls_active { return error("TCP text write during TLS session"); }
        if self.state.write_shutdown { return error("write after TCP shutdown"); }
        if strings.is_empty(text) {
            return WriteOutcome {
                would_block: false,
                count: 0
            };
        }
        def mut count: u64 = 0;
        def mut failure: i32 = 0;
        def code: i32 = __net_send_text(self.descriptor(), text, &count, &failure);
        if code == status.WOULD_BLOCK {
            return WriteOutcome {
                would_block: true,
                count: 0
            };
        }
        if code != status.OK { return error("TCP text write failed"); }
        return WriteOutcome {
            would_block: false,
            count: count
        };
    }

    // Start verified client TLS on a connected socket. Empty trust_file uses
    // system trust; a path to a PEM CA file supports private test/deploy CAs.
    // The host must match the certificate, including when it is an IP address.
    def pub start_tls_client(self: &Socket, owner: &arena.GeneralArena,
        hostname: string, trust_file: string) -> result<TlsClient> {
        if !self.is_open() || !self.state.connected || self.state.connecting ||
            self.state.write_shutdown ||
            self.state.tls_active {
            return error("TLS requires an idle connected TCP socket");
        }
        def state: *TlsClientState = owner.try_alloc(TlsClientState {
            native: null,
            socket: self.state,
            ready: false
        });
        if state == null { return error("TLS metadata allocation failed"); }
        def mut native: *u8 = null;
        def mut detail: i32 = 0;
        def code: i32 = __net_tls_create(self.descriptor(), hostname, trust_file,
            &native, &detail);
        if code != status.OK { return error("TLS client setup failed"); }
        state.native = native;
        self.state.tls_active = true;
        return TlsClient {
            state: state
        };
    }

    // Invalidates every alias before closing. A failed close still consumes it.
    def pub close(self: &Socket) -> result<void> {
        if !self.is_open() { return error("TCP socket already closed"); }
        if self.state.tls_active { return error("close TLS session before TCP socket"); }
        def descriptor: i32 = self.state.descriptor;
        self.state.descriptor = -1;
        def mut failure: i32 = 0;
        def code: i32 = __net_close(descriptor, &failure);
        if code != status.OK { return error("TCP socket close failed"); }
        return;
    }

}

def struct TlsClientState {
    def mut native: *u8,
    def socket: *SocketState,
    def mut ready: bool,
}

// Copies alias one native TLS session. Close TLS before closing its Socket;
// both must be closed before the owner arena is reset or freed.
def pub struct TlsClient {
    def state: *TlsClientState,

    def pub handshake(self: &TlsClient) -> result<i32> {
        if self.state == null || self.state.native == null {
            return error("TLS session is closed");
        }
        def mut wait_for: i32 = 0;
        def mut detail: i32 = 0;
        def code: i32 = __net_tls_handshake(self.state.native, &wait_for, &detail);
        if code == status.WOULD_BLOCK { return wait_for; }
        if code != status.OK { return error("TLS handshake or verification failed"); }
        self.state.ready = true;
        return 0;
    }

    def pub read(self: &TlsClient, destination: [u8]) -> result<TlsReadOutcome> {
        def zero: u64 = 0;
        if self.state == null || self.state.native == null || !self.state.ready ||
            destination.len == zero {
            return error("TLS read requires an open session and nonempty storage");
        }
        def mut count: u64 = 0;
        def mut wait_for: i32 = 0;
        def mut detail: i32 = 0;
        def code: i32 = __net_tls_read(self.state.native, &destination[0],
            destination.len, &count, &wait_for, &detail);
        if code != status.OK && code != status.END && code != status.WOULD_BLOCK {
            return error("TLS read failed");
        }
        return TlsReadOutcome {
            state: code,
            count: count,
            wait_for: wait_for
        };
    }

    def pub write(self: &TlsClient, bytes: [const u8]) -> result<TlsWriteOutcome> {
        def zero: u64 = 0;
        if self.state == null || self.state.native == null || !self.state.ready {
            return error("TLS write requires an open session");
        }
        if bytes.len == zero {
            return TlsWriteOutcome {
                count: 0,
                wait_for: 0
            };
        }
        def mut count: u64 = 0;
        def mut wait_for: i32 = 0;
        def mut detail: i32 = 0;
        def code: i32 = __net_tls_write(self.state.native, &bytes[0], bytes.len,
            &count, &wait_for, &detail);
        if code != status.OK && code != status.WOULD_BLOCK {
            return error("TLS write failed");
        }
        return TlsWriteOutcome {
            count: count,
            wait_for: wait_for
        };
    }

    def pub close(self: &TlsClient) -> result<void> {
        if self.state == null || self.state.native == null {
            return error("TLS session already closed");
        }
        def native: *u8 = self.state.native;
        self.state.native = null;
        self.state.socket.tls_active = false;
        def code: i32 = __net_tls_close(native);
        if code != status.OK { return error("TLS cleanup failed"); }
        return;
    }

}

// Wait once for several sockets. All four slices have equal, nonzero length.
// `descriptors` is caller-owned scratch, `ready` receives READABLE/WRITABLE bits.
// A zero result is a timeout or an interrupted wait; retry with a deadline.
def pub wait_many(sockets: [const Socket], requested: [const i32], ready: [i32],
    descriptors: [i32], timeout_ms: i32) -> result<u64> {
    def zero: u64 = 0;
    if sockets.len == zero || sockets.len != requested.len || sockets.len != ready.len ||
        sockets.len != descriptors.len || timeout_ms < 0 {
        return error("invalid TCP wait set");
    }
    for def mut index: u64 = 0; index < sockets.len; index = index + 1 {
        if !sockets[index].is_open() { return error("closed socket in TCP wait set"); }
        if requested[index] < 1 || requested[index] > 3 {
            return error("invalid TCP wait event mask");
        }
        descriptors[index] = sockets[index].descriptor();
        ready[index] = 0;
    }
    def mut count: u64 = 0;
    def mut failure: i32 = 0;
    def code: i32 = __net_wait_many(&descriptors[0], &requested[0], &ready[0],
        sockets.len, timeout_ms, &count, &failure);
    if code == status.WOULD_BLOCK || code == status.TIMED_OUT { return 0; }
    if code != status.OK { return error("TCP multi-socket wait failed"); }
    return count;
}

// Blocking IPv4-only name lookup. The caller owns `hosts`; entries are in
// resolver order and can be used as Address.host. No partial output on failure.
def pub resolve_ipv4(host: string, hosts: [u32]) -> result<u64> {
    def zero: u64 = 0;
    if strings.is_empty(host) || hosts.len == zero {
        return error("IPv4 lookup needs a host and output storage");
    }
    def mut count: u64 = 0;
    def mut failure: i32 = 0;
    def code: i32 = __net_resolve_ipv4(host, &hosts[0], hosts.len, &count, &failure);
    if code == status.TOO_LONG { return error("IPv4 lookup output is too small"); }
    if code == status.NOT_FOUND { return error("IPv4 host was not found"); }
    if code != status.OK { return error("IPv4 hostname lookup failed"); }
    return count;
}
