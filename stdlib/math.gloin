// Example: math.abs_i32(-42) -> success/42. Minimum signed value returns an overflow error; never negate it.
// O(1), no allocation; all other inputs succeed.
def pub abs_i32(value: i32) -> result<i32> {
    if value == -2147483648 {
        return error("math absolute value overflow");
    }
    if value < 0 {
        return -value;
    }

    return value;
}

// Example: math.abs_i64(-42) -> success/42. Minimum signed value returns an overflow error; never negate it.
// O(1), no allocation; all other inputs succeed.
def pub abs_i64(value: i64) -> result<i64> {
    if value == -9223372036854775808 {
        return error("math absolute value overflow");
    }
    if value < 0 {
        return -value;
    }

    return value;
}

// Example: math.abs_f32(-2.0) -> success/2; -0 becomes +0.
// No allocation/retained storage; fixed dispatch plus host f32 libm cost (not a latency/ULP promise).
// Finite inputs only. Domain, overflow and nonzero-rounded-to-zero failures return errors.
// Nonzero subnormals succeed; other signed zeros follow docs/math.md. Rounding returns f32.
def pub abs_f32(value: f32) -> result<f32> {
    def mut outcome: f32 = 0.0;
    def code: i32        = __math_unary_f32(0, value, &outcome);

    if code != status.OK { return native_failure(code); }

    return outcome;
}

// Example: math.floor_f32(-1.25) -> success/-2; toward negative infinity.
// No allocation/retained storage; fixed dispatch plus host f32 libm cost (not a latency/ULP promise).
// Finite inputs only. Domain, overflow and nonzero-rounded-to-zero failures return errors.
// Nonzero subnormals succeed; other signed zeros follow docs/math.md. Rounding returns f32.
def pub floor_f32(value: f32) -> result<f32> {
    def mut outcome: f32 = 0.0;
    def code: i32        = __math_unary_f32(1, value, &outcome);

    if code != status.OK { return native_failure(code); }

    return outcome;
}

