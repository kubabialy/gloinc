// Concrete finite numerical utilities. See docs/math.md for domains and accuracy.
import "@status";
// Every checked failure has value +0 (integer zero); successful signed zero is preserved.
def pub struct I32Result { def pub status: i32, def pub value: i32, }
def pub struct I64Result { def pub status: i32, def pub value: i64, }
def pub struct U64Result { def pub status: i32, def pub value: u64, }
def pub struct F32Result { def pub status: i32, def pub value: f32, }
def pub struct F64Result { def pub status: i32, def pub value: f64, }
// Nearest f32 constants; scalar loads, no allocation; angles are radians.
def pub const PI_F32: f32 = 3.14159265358979323846264338327950288;
def pub const TAU_F32: f32 = 6.28318530717958647692528676655900576;
// Nearest f64 constants; scalar loads, no allocation; angles are radians.
def pub const PI_F64: f64 = 3.14159265358979323846264338327950288;
def pub const TAU_F64: f64 = 6.28318530717958647692528676655900576;

// Example: math.min_i32(2, 3) selects the minimum.
// O(1), no allocation/failure. Equal operands select FIRST, including signed zeros.
def pub min_i32(a: i32, b: i32) -> i32 { if b < a { return b; } return a; }

// Example: math.max_i32(2, 3) selects the maximum.
// O(1), no allocation/failure. Equal operands select FIRST, including signed zeros.
def pub max_i32(a: i32, b: i32) -> i32 { if b > a { return b; } return a; }

// Example: math.clamp_i32(value, low, high). Inclusive bounds; INVALID/+0 if low > high.
// O(1), no allocation. In-range values keep their sign, including zero; no implicit conversion.
def pub clamp_i32(value: i32, low: i32, high: i32) -> I32Result {
    if low > high { return I32Result { status: status.INVALID, value: 0 }; }
    if value < low { return I32Result { status: status.OK, value: low }; }
    if value > high { return I32Result { status: status.OK, value: high }; }
    return I32Result { status: status.OK, value: value };
}

// Example: math.min_i64(2, 3) selects the minimum.
// O(1), no allocation/failure. Equal operands select FIRST, including signed zeros.
def pub min_i64(a: i64, b: i64) -> i64 { if b < a { return b; } return a; }

// Example: math.max_i64(2, 3) selects the maximum.
// O(1), no allocation/failure. Equal operands select FIRST, including signed zeros.
def pub max_i64(a: i64, b: i64) -> i64 { if b > a { return b; } return a; }

// Example: math.clamp_i64(value, low, high). Inclusive bounds; INVALID/+0 if low > high.
// O(1), no allocation. In-range values keep their sign, including zero; no implicit conversion.
def pub clamp_i64(value: i64, low: i64, high: i64) -> I64Result {
    if low > high { return I64Result { status: status.INVALID, value: 0 }; }
    if value < low { return I64Result { status: status.OK, value: low }; }
    if value > high { return I64Result { status: status.OK, value: high }; }
    return I64Result { status: status.OK, value: value };
}

