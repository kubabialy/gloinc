def pub max_f64(a: f64, b: f64) -> f64 { if b > a { return b; } return a; }

// Example: math.clamp_f64(value, low, high). Inclusive bounds; INVALID/+0 if low > high.
// O(1), no allocation. In-range values keep their sign, including zero; no implicit conversion.
def pub clamp_f64(value: f64, low: f64, high: f64) -> F64Result {
