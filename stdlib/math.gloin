    if value < low { return F64Result { status: status.OK, value: low }; }
    if value > high { return F64Result { status: status.OK, value: high }; }
    return F64Result { status: status.OK, value: value };
}

// Example: math.abs_i32(-42) -> OK/42. Minimum signed value -> OVERFLOW/0, never negate it.
// O(1), no allocation; all other inputs succeed.
def pub abs_i32(value: i32) -> I32Result {
    if value == -2147483648 { return I32Result { status: status.OVERFLOW, value: 0 }; }
    if value < 0 { return I32Result { status: status.OK, value: -value }; }
    return I32Result { status: status.OK, value: value };
}

// Example: math.abs_i64(-42) -> OK/42. Minimum signed value -> OVERFLOW/0, never negate it.
// O(1), no allocation; all other inputs succeed.
def pub abs_i64(value: i64) -> I64Result {
    if value == -9223372036854775808 { return I64Result { status: status.OVERFLOW, value: 0 }; }
    if value < 0 { return I64Result { status: status.OK, value: -value }; }
    return I64Result { status: status.OK, value: value };
}

// Example: math.abs_f32(-2.0) -> OK/2; -0 becomes +0.
// No allocation/retained storage; fixed dispatch plus host f32 libm cost (not a latency/ULP promise).
// Finite inputs only. INVALID/domain, OVERFLOW/range, UNDERFLOW/nonzero rounded to zero -> +0.
// Nonzero subnormals succeed; other signed zeros follow docs/math.md. Rounding returns f32.
def pub abs_f32(value: f32) -> F32Result {
    def mut result: f32 = 0.0;
    def code: i32 = __math_unary_f32(0, value, &result);
    return F32Result { status: code, value: result };
}

// Example: math.floor_f32(-1.25) -> OK/-2; toward negative infinity.
// No allocation/retained storage; fixed dispatch plus host f32 libm cost (not a latency/ULP promise).
// Finite inputs only. INVALID/domain, OVERFLOW/range, UNDERFLOW/nonzero rounded to zero -> +0.
// Nonzero subnormals succeed; other signed zeros follow docs/math.md. Rounding returns f32.
def pub floor_f32(value: f32) -> F32Result {
    def mut result: f32 = 0.0;
    def code: i32 = __math_unary_f32(1, value, &result);
    return F32Result { status: code, value: result };
}

// Example: math.ceil_f32(-1.25) -> OK/-1; toward positive infinity.
// No allocation/retained storage; fixed dispatch plus host f32 libm cost (not a latency/ULP promise).
// Finite inputs only. INVALID/domain, OVERFLOW/range, UNDERFLOW/nonzero rounded to zero -> +0.
