// Example: math.hypot_f64(3.0, 4.0) -> OK/5; scaled host hypot avoids intermediate squared overflow; zeros give +0.
// No allocation/retained storage; fixed dispatch plus host f64 libm cost (not a latency/ULP promise).
// Finite inputs only. INVALID/domain, OVERFLOW/range, UNDERFLOW/nonzero rounded to zero -> +0.
// Nonzero subnormals succeed; other signed zeros follow docs/math.md. Rounding returns f64.
def pub hypot_f64(x: f64, y: f64) -> F64Result {
    def mut result: f64 = 0.0;
    def code: i32 = __math_binary_f64(2, x, y, &result);
    return F64Result { status: code, value: result };
}
