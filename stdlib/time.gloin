// Monotonic instants and durations, not calendar timestamps. See docs/time-random.md.
import "@status";
import "@std";

// Raw ticks are meaningful only within one clock domain/epoch. Zero is valid.
def pub struct Instant {
    def pub ticks_ns: u64,
}

def pub struct Duration {
    def pub nanoseconds: u64,

    // Example: time.Duration.from_milliseconds(1500) -> success 1500000000 ns.
    // O(1), no allocation; overflow -> OVERFLOW before multiplication; failure exposes no duration.
    def pub static from_milliseconds(value: u64) -> result<Duration> {
        if value > 18446744073709 {
            return error("millisecond duration is out of range", status.OVERFLOW, 0);
        }

        return Duration { nanoseconds: value * 1000000 };
    }

    // Example: time.Duration.from_seconds(2) -> success 2000000000 ns.
    // O(1), no allocation; overflow -> OVERFLOW before multiplication; failure exposes no duration.
    def pub static from_seconds(value: u64) -> result<Duration> {
        if value > 18446744073 {
            return error("second duration is out of range", status.OVERFLOW, 0);
        }

        return Duration { nanoseconds: value * 1000000000 };
    }

    // Example: Duration { nanoseconds: 1500999 }.whole_microseconds() -> 1500.
    // O(1), no allocation/failure; floors fractional microseconds explicitly.
    def pub whole_microseconds(self: &const Duration) -> u64 {
        return self.nanoseconds / 1000;
    }

    // Example: Duration { nanoseconds: 1500999 }.whole_milliseconds() -> 1.
    // O(1), no allocation/failure; floors fractional milliseconds explicitly.
    def pub whole_milliseconds(self: &const Duration) -> u64 {
        return self.nanoseconds / 1000000;
    }

    // Example: Duration { nanoseconds: 1500000000 }.seconds_f64_rounded() -> 1.5.
    // O(1), no allocation/failure; rounded u64->f64 then divide by 1e9; large values lose ns precision.
    def pub seconds_f64_rounded(self: &const Duration) -> f64 {
        return std.f64_from_u64_rounded(self.nanoseconds) / 1000000000.0;
    }

    // Example: a.checked_add(b); both operands are durations in ns.
    // O(1), no allocation; unrepresentable sum -> OVERFLOW, no mutation or readable failure payload.
    def pub checked_add(self: &const Duration, other: Duration) -> result<Duration> {
        if other.nanoseconds > 18446744073709551615 - self.nanoseconds {
            return error("duration addition is out of range", status.OVERFLOW, 0);
        }

        return Duration { nanoseconds: self.nanoseconds + other.nanoseconds };
    }

    // Example: a.checked_sub(b); equal durations succeed with zero nanoseconds.
    // O(1), no allocation; negative result -> OVERFLOW, no mutation or readable failure payload.
    def pub checked_sub(self: &const Duration, other: Duration) -> result<Duration> {
        if other.nanoseconds > self.nanoseconds {
            return error("duration subtraction would be negative", status.OVERFLOW, 0);
        }

        return Duration { nanoseconds: self.nanoseconds - other.nanoseconds };
    }

}

// Example: start = time.monotonic_now(); check .erroneous before using start.value.
// O(1) host clock read, no allocation; an injected host callback supplies its own cost.
// Failure exposes only an error: IO_ERROR preserves errno; OVERFLOW/INVALID have os_error=0.
// Nanoseconds are storage units, not a guarantee of nanosecond clock resolution.
def pub monotonic_now() -> result<Instant> {
    def mut ticks: u64        = 0;
    def mut failure_code: i32 = 0;
    def code: i32             = __time_monotonic(&ticks, &failure_code);

    if code == status.IO_ERROR { return error("cannot read monotonic clock", code, failure_code); }
    if code == status.OVERFLOW { return error("monotonic clock reading is out of range", code, 0); }
    if code != status.OK { return error("invalid monotonic clock reading", code, 0); }

    return Instant { ticks_ns: ticks };
}

// Example: time.elapsed(start.value, end.value). Both must belong to the SAME clock domain.
// O(1), no allocation; backwards ticks -> INVALID, with no duration payload. Equal instants succeed with zero.
// Explicit inputs permit deterministic arithmetic tests; no hidden read or clock identity inference.
def pub elapsed(start: Instant, end: Instant) -> result<Duration> {
    if end.ticks_ns < start.ticks_ns {
        return error("monotonic clock moved backwards", status.INVALID, 0);
    }

    return Duration { nanoseconds: end.ticks_ns - start.ticks_ns };
}
