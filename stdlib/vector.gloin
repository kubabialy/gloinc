import "@arena";
import "@memory";
import "@status";

// Validate before the internal reservation bridge can trap on size overflow.
def try_storage<T>(owner: &arena.GeneralArena, capacity: i64) -> result<*T> {
    if capacity < 0 { return error("negative vector capacity", status.INVALID, 0); }

    def size: i64 = memory.size_of<T>();
    if size > 0 && capacity > 9223372036854775807 / size {
        return error("vector storage size overflow", status.OVERFLOW, 0);
    }

    def storage: *T = owner.try_reserve_typed<T>(capacity);
    if storage == null { return error("cannot allocate vector storage", status.NO_MEMORY, 0); }

    return storage;
}

// A growable sequence backed by GeneralArena allocations.
// Copying this value aliases its current elements but copies its length/capacity counters.
def pub struct Vector<T> {
    def mut data: *T,
    def mut length: i64,
    def mut capacity: i64,
    def memory: &arena.GeneralArena,

    // O(1) initialization, no fill value; the arena owns the reserved storage.
    def pub static try_empty(memory: &arena.GeneralArena, capacity: i64) -> result<Vector<T>> {
        def reserved: result<*T> = try_storage<T>(memory, capacity);
        if reserved.erroneous { return reserved.error; }

        return Vector<T> { data: reserved.value, length: 0, capacity: capacity, memory: memory };
    }

    // No allocation within capacity. Failure leaves storage, counters and views unchanged.
    def pub try_reserve(self: &Vector<T>, requested: i64) -> result<void> {
        if requested < 0 { return error("negative vector capacity", status.INVALID, 0); }
        if requested <= self.capacity { return; }

        def reserved: result<*T> = try_storage<T>(self.memory, requested);
        if reserved.erroneous { return reserved.error; }

        def storage: *T = reserved.value;

        for def mut index: i64 = 0; index < self.length; index = index + 1 {
            *(storage + index) = *(self.data + index);
        }

        self.data     = storage;
        self.capacity = requested;

        return;
    }

    // Geometric growth capped by the element's representable storage extent.
    def try_grow(self: &Vector<T>, needed: i64) -> result<void> {
        if needed <= self.capacity { return; }

        def size: i64      = memory.size_of<T>();
        def mut limit: i64 = 9223372036854775807;

        if size > 0 { limit = limit / size; }
        if needed > limit { return error("vector storage size overflow", status.OVERFLOW, 0); }

        def mut next: i64 = needed;

        if self.capacity > limit / 2 {
            next = limit;
        } else if self.capacity * 2 > needed {
            next = self.capacity * 2;
        }

        def grown: result<void> = self.try_reserve(next);
        if grown.erroneous { return grown.error; }

        return;
    }

    // Captures value before growth. Allocation/extent failure publishes no mutation.
    def pub try_push(self: &Vector<T>, value: T) -> result<void> {
        def inserted: result<void> = self.try_insert(self.length, value);
        if inserted.erroneous { return inserted.error; }

        return;
    }

    def pub try_insert(self: &Vector<T>, index: i64, value: T) -> result<void> {
        if index < 0 || index > self.length {
            return error("vector insertion index is out of range", status.OUT_OF_RANGE, 0);
        }
        if self.length == 9223372036854775807 {
            return error("vector length overflow", status.OVERFLOW, 0);
        }

        def grown: result<void> = self.try_grow(self.length + 1);
        if grown.erroneous { return grown.error; }

        def mut cursor: i64 = self.length;

        while cursor > index {
            *(self.data + cursor) = *(self.data + (cursor - 1));
            cursor = cursor - 1;
        }

        *(self.data + index) = value;
        self.length = self.length + 1;

        return;
    }

    // Reserve once before writing. Overlapping sources behave as a value snapshot.
    def pub try_append_from(self: &Vector<T>, source: [const T]) -> result<void> {
        def converted: result<i64> = i64(source.len);
        if converted.erroneous { return error("vector length overflow", status.OVERFLOW, 0); }

        def count: i64 = converted.value;
        if count > 9223372036854775807 - self.length {
            return error("vector length overflow", status.OVERFLOW, 0);
        }
        if count == 0 { return; }

        def grown: result<void> = self.try_grow(self.length + count);
        if grown.erroneous { return grown.error; }

        // Pointer equality detects a destination starting inside source without
        // pointer ordering/casts. The scan is linear, reads no element values,
        // and needs no temporary allocation. Growth retains the old source block.
        def destination: *const T = self.data + self.length;
        def mut backward: bool    = false;

        for def mut index: i64 = 0; index < count; index = index + 1 {
            if &source[index] == destination { backward = true; }
        }

        def mut remaining: i64 = count;

        while remaining > 0 {
            def mut index: i64 = count - remaining;
            if backward { index = remaining - 1; }

            *(self.data + (self.length + index)) = source[index];
            remaining = remaining - 1;
        }

        self.length = self.length + count;

        return;
    }

    // Only the live prefix is initialized. A zero capacity is valid.
    def pub static empty(memory: &arena.GeneralArena, capacity: i64) -> Vector<T> {
        def storage: *T = memory.reserve_typed<T>(capacity);

        return Vector<T> {
            data: storage,
            length: 0,
            capacity: capacity,
            memory: memory
        };
    }

    // fill is a type witness retained for source compatibility. Only pushed
    // elements are initialized; spare capacity must never be read.
    def pub static create(memory: &arena.GeneralArena, capacity: i64, fill: T) -> Vector<T> {
        def storage: *T = memory.alloc_reserved_many(fill, capacity);

        return Vector<T> {
            data: storage,
            length: 0,
            capacity: capacity,
            memory: memory
        };
    }

    def pub len(self: &const Vector<T>) -> i64 {
        return self.length;
    }

    def pub cap(self: &const Vector<T>) -> i64 {
        return self.capacity;
    }

    def pub as_slice(self: &Vector<T>) -> [T] {
        return self.data[0..self.length];
    }

    def pub as_const_slice(self: &const Vector<T>) -> [const T] {
        def data: *const T = self.data;

        return data[0..self.length];
    }

    // Allocates a new buffer when requested capacity exceeds the current one.
    // The old buffer remains allocated until the arena is reset or freed.
    def pub reserve(self: &Vector<T>, requested: i64) -> bool {
        if requested < 0 { return false; }
        if requested <= self.capacity { return true; }

        def storage: *T    = self.memory.reserve_typed<T>(requested);
        def mut index: i64 = 0;

        while index < self.length {
            *(storage + index) = *(self.data + index);
            index = index + 1;
        }

        self.data     = storage;
        self.capacity = requested;

        return true;
    }

    def pub push(self: &Vector<T>, value: T) -> bool {
        if self.length >= self.capacity {
            def mut next: i64 = 1;

            if self.capacity > 0 {
                if self.capacity == 9223372036854775807 { return false; }

                if self.capacity > 4611686018427387903 {
                    next = self.capacity + 1;
                } else {
                    next = self.capacity * 2;
                }
            }

            if !self.reserve(next) { return false; }
        }

        *(self.data + self.length) = value;
        self.length = self.length + 1;

        return true;
    }

    // Source may be a view of this vector: arena growth retains the old block.
    // A capacity overflow returns false before any elements are appended.
    def pub append_from(self: &Vector<T>, source: [const T]) -> bool {
        def mut remaining: i64 = 9223372036854775807 - self.length;
        def mut index: u64     = 0;

        while index < source.len {
            if remaining == 0 { return false; }

            remaining = remaining - 1;
            index     = index + 1;
        }

        index = 0;

        while index < source.len {
            if !self.push(source[index]) { return false; }

            index = index + 1;
        }

        return true;
    }

    def pub get(self: &const Vector<T>, index: i64) -> *const T {
        if index < 0 || index >= self.length { return null; }

        return self.data + index;
    }

    def pub get_mut(self: &Vector<T>, index: i64) -> *T {
        if index < 0 || index >= self.length { return null; }

        return self.data + index;
    }

    // The returned pointer borrows the removed slot until the next mutation.
    def pub pop(self: &Vector<T>) -> *T {
        if self.length == 0 { return null; }

        self.length = self.length - 1;

        return self.data + self.length;
    }

    def pub truncate(self: &Vector<T>, length: i64) -> bool {
        if length < 0 || length > self.length { return false; }

        self.length = length;

        return true;
    }

    def pub insert(self: &Vector<T>, index: i64, value: T) -> bool {
        if index < 0 || index > self.length { return false; }

        if self.length >= self.capacity {
            def mut next: i64 = 1;

            if self.capacity > 0 {
                if self.capacity == 9223372036854775807 { return false; }

                if self.capacity > 4611686018427387903 {
                    next = self.capacity + 1;
                } else {
                    next = self.capacity * 2;
                }
            }

            if !self.reserve(next) { return false; }
        }

        def mut cursor: i64 = self.length;

        while cursor > index {
            *(self.data + cursor) = *(self.data + (cursor - 1));
            cursor = cursor - 1;
        }

        *(self.data + index) = value;
        self.length = self.length + 1;

        return true;
    }

    def pub remove(self: &Vector<T>, index: i64) -> bool {
        if index < 0 || index >= self.length { return false; }

        def mut cursor: i64 = index;

        while cursor + 1 < self.length {
            *(self.data + cursor) = *(self.data + (cursor + 1));
            cursor = cursor + 1;
        }

        self.length = self.length - 1;

        return true;
    }

    def pub clear(self: &Vector<T>) -> void {
        self.length = 0;
    }

}

// Fixed capacity and inline storage. No arena is needed and push never grows.
def pub struct Vector<T;
const N: usize> {
    def mut data: [T; N],
    def mut length: i64,

    def pub static create(fill: T) -> Vector<T;
    N> {
        return Vector<T;
        N> {
            data: {fill; N},
            length: 0
        };
    }

    def pub len(self: &const Vector<T;
        N>) -> i64 {
        return self.length;
    }

    def pub cap(self: &const Vector<T;
        N>) -> i64 {
        return N;
    }

    def pub as_slice(self: &Vector<T;
        N>) -> [T] {
        return self.data[0..self.length];
    }

    def pub as_const_slice(self: &const Vector<T;
        N>) -> [const T] {
        return self.data[0..self.length];
    }

    def pub push(self: &Vector<T;
        N>, value: T) -> bool {
        if self.length >= N { return false; }

        self.data[self.length] = value;
        self.length            = self.length + 1;

        return true;
    }

    // Check all required capacity first so a full fixed vector stays unchanged.
    def pub append_from(self: &Vector<T;
        N>, source: [const T]) -> bool {
        def mut remaining: i64 = N - self.length;
        def mut index: u64     = 0;

        while index < source.len {
            if remaining == 0 { return false; }

            remaining = remaining - 1;
            index     = index + 1;
        }

        index = 0;

        while index < source.len {
            if !self.push(source[index]) { return false; }

            index = index + 1;
        }

        return true;
    }

    def pub get(self: &const Vector<T;
        N>, index: i64) -> *const T {
        if index < 0 || index >= self.length { return null; }

        return &self.data[index];
    }

    def pub get_mut(self: &Vector<T;
        N>, index: i64) -> *T {
        if index < 0 || index >= self.length { return null; }

        return &self.data[index];
    }

    def pub pop(self: &Vector<T;
        N>) -> *T {
        if self.length == 0 { return null; }

        self.length = self.length - 1;

        return &self.data[self.length];
    }

    def pub truncate(self: &Vector<T;
        N>, length: i64) -> bool {
        if length < 0 || length > self.length { return false; }

        self.length = length;

        return true;
    }

    def pub insert(self: &Vector<T;
        N>, index: i64, value: T) -> bool {
        if index < 0 || index > self.length || self.length >= N { return false; }

        def mut cursor: i64 = self.length;

        while cursor > index {
            self.data[cursor] = self.data[cursor - 1];
            cursor = cursor - 1;
        }

        self.data[index] = value;
        self.length      = self.length + 1;

        return true;
    }

    def pub remove(self: &Vector<T;
        N>, index: i64) -> bool {
        if index < 0 || index >= self.length { return false; }

        def mut cursor: i64 = index;

        while cursor + 1 < self.length {
            self.data[cursor] = self.data[cursor + 1];
            cursor = cursor + 1;
        }

        self.length = self.length - 1;

        return true;
    }

    def pub clear(self: &Vector<T;
        N>) -> void {
        self.length = 0;
    }
}
