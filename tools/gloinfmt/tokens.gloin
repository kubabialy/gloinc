// Independent streaming token comparison for formatter safety checks.
// This does not import or reuse the formatter's scanner or delimiter links.
import "@strings";

def struct Cursor {
    def text: string,
    def mut offset: u64,

    def next(self: &Cursor) -> string {
        def size: u64 = strings.byte_length(self.text);

        while self.offset < size && whitespace(byte(self.text, self.offset)) {
            self.offset = self.offset + 1;
        }

        if self.offset == size { return ""; }

        def start: u64 = self.offset;
        def first: u8  = byte(self.text, start);
        self.offset = self.offset + 1;

        if first == 47 && self.offset < size && byte(self.text, self.offset) == 47 {
            while self.offset < size && byte(self.text, self.offset) != 10
                && byte(self.text, self.offset) != 13 {
                self.offset = self.offset + 1;
            }
        } else if first == 34 || first == 39 {
            def mut quoted: bool = true;

            while quoted && self.offset < size {
                def current: u8 = byte(self.text, self.offset);

                if current == 10 || current == 13 {
                    quoted = false;
                } else {
                    self.offset = self.offset + 1;

                    if current == 92 && self.offset < size {
                        self.offset = self.offset + 1;
                    } else if current == first {
                        quoted = false;
                    }
                }
            }
        } else if word(first) {
            while self.offset < size && word(byte(self.text, self.offset)) {
                self.offset = self.offset + 1;
            }
        } else if self.offset < size {
            def pair: string = strings.slice_bytes(self.text, start, 2).value;
            if paired_operator(pair) { self.offset = self.offset + 1; }
        }

        return strings.slice_bytes(self.text, start, self.offset - start).value;
    }
}

def byte(text: string, offset: u64) -> u8 {
    return strings.byte_at(text, offset).value;
}

def whitespace(value: u8) -> bool {
    return value == 32 || (value >= 9 && value <= 13);
}

def word(value: u8) -> bool {
    return (value >= 48 && value <= 57) || (value >= 65 && value <= 90)
        || (value >= 97 && value <= 122) || value == 95 || value >= 128;
}

def paired_operator(value: string) -> bool {
    return strings.equal(value, "->") || strings.equal(value, "==")
        || strings.equal(value, "!=") || strings.equal(value, "<=")
        || strings.equal(value, ">=") || strings.equal(value, "&&")
        || strings.equal(value, "||") || strings.equal(value, "::")
        || strings.equal(value, "+=") || strings.equal(value, "-=")
        || strings.equal(value, "*=") || strings.equal(value, "/=")
        || strings.equal(value, "<<") || strings.equal(value, ">>");
}

def pub same(before: string, after: string) -> bool {
    def mut left: Cursor = Cursor {
        text: before,
        offset: 0
    };
    def mut right: Cursor = Cursor {
        text: after,
        offset: 0
    };
    def mut scanning: bool = true;

    while scanning {
        def a: string = left.next();
        def b: string = right.next();

        if !strings.equal(a, b) { return false; }

        if strings.is_empty(a) { scanning = false; }
    }

    return true;
}
