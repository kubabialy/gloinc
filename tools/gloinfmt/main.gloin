// Gloin source formatter, checker and checked in-place writer.
import "@std";
import "./format";
import "./tokens";
import "./git";
import "@arena";
import "@fs";
import "@io";
import "@process";
import "@status";
import "@strings";
import "@vector";

def struct Counts {
    def mut changed: i32,
}

def report(message: string) -> void {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut output: io.Stream = io.stderr();

    report_io_failure(output.write_line(message, &io_progress));
}

def close_file(file: &io.File) -> void {
    if file.is_open() { report_io_failure(file.close()); }
}

def close_directory(directory: &fs.Directory) -> void {
    if directory.is_open() {
        def closed: result<void> = directory.close();
        if closed.erroneous { report(closed.error.message); }
    }
}

def read_source(memory: &arena.GeneralArena, path: string) -> result<string> {
    def opened: result<io.File> = io.File.open_read(memory, path);
    if opened.erroneous { return error("cannot open source file"); }

    def mut file: io.File = opened.value;
    defer close_file(&file);

    def mut read: io.ReadState    = io.ReadState.empty();
    def read_result: result<void> = file.read_all(memory, 8388608, &read);

    if read_result.erroneous { return error("cannot read source file or it exceeds 8 MiB"); }

    def closed: result<void> = file.close();
    if closed.erroneous { return error("cannot close source file"); }

    return read.value;
}

def format_file(path: string, changes: &Counts, print_text: bool, write: bool) -> result<void> {
    def mut memory: arena.GeneralArena = arena.GeneralArena.create();
    defer memory.free();

    def read: result<string> = read_source(&memory, path);
    if read.erroneous { return read.error; }

    def formatted: result<string> = format.format_text(&memory, read.value);
    if formatted.erroneous { return formatted.error; }

    if !tokens.same(read.value, formatted.value) { return error("formatting changed source tokens"); }

    def repeated: result<string> = format.format_text(&memory, formatted.value);
    if repeated.erroneous { return repeated.error; }
    if !strings.equal(formatted.value, repeated.value) { return error("formatting is not idempotent"); }

    if print_text {
        def mut output: io.Stream        = io.stdout();
        def mut written: io.WriteState   = io.WriteState.empty();
        def written_result: result<void> = output.write_all(formatted.value, &written);

        if written_result.erroneous { return error("cannot write formatted source"); }
        if !io_succeeded(output.flush()) { return error("cannot flush formatted source"); }
    } else if !strings.equal(read.value, formatted.value) {
        if write {
            def replaced: result<void> = fs.replace_file(path, read.value, formatted.value);
            if replaced.erroneous { report(path); return replaced.error; }
        }

        def mut output: io.Stream        = io.stdout();
        def mut written: io.WriteState   = io.WriteState.empty();
        def written_result: result<void> = output.write_line(path, &written);

        if written_result.erroneous { return error("cannot print changed path"); }
        if !io_succeeded(output.flush()) { return error("cannot flush changed path"); }

        changes.changed = changes.changed + 1;
    }

    return;
}

def skip_directory(name: string) -> bool {
    return strings.equal(name, ".git") || strings.equal(name, ".idea") ||
        strings.equal(name, "node_modules") || strings.equal(name, ".cache") ||
        strings.equal(name, "build") || strings.starts_with(name, "build-");
}

def sort_names(names: &vector.Vector<string>) -> void {
    for def mut index: i64 = 1; index < names.len(); index = index + 1 {
        def mut cursor: i64    = index;
        def mut swapping: bool = true;

        while cursor > 0 && swapping {
            def left: *string  = names.get_mut(cursor - 1);
            def right: *string = names.get_mut(cursor);

            if strings.compare(*left, *right) > 0 {
                def old: string = *left;
                *left  = *right;
                *right = old;
                cursor = cursor - 1;
            } else {
                swapping = false;
            }
        }
    }
}

def visit_path(path: string, changes: &Counts, explicit: bool, write: bool, depth: u64) -> result<void> {
    if depth == 0 { return error("directory traversal exceeds 64 levels"); }

    def metadata: result<fs.Metadata> = fs.metadata(path);
    if metadata.erroneous {
        return error("cannot inspect input path", metadata.error.code, metadata.error.os_error);
    }

    if metadata.value.kind == fs.FILE {
        if explicit || strings.ends_with(path, ".gloin") {
            def checked: result<void> = format_file(path, changes, false, write);
            if checked.erroneous { return checked.error; }
        }

        return;
    }

    if metadata.value.kind != fs.DIRECTORY {
        if explicit { return error("input is not a regular file or directory"); }

        return;
    }

    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    def opened: result<fs.Directory> = fs.Directory.open(&owner, path);
    if opened.erroneous { return opened.error; }

    def mut directory: fs.Directory = opened.value;
    defer close_directory(&directory);

    def mut names: vector.Vector<string> = vector.Vector<string>.empty(&owner, 0);
    def mut scanning: bool               = true;

    while scanning {
        scratch.reset();
        def entry: result<fs.DirectoryRead> = directory.next(&scratch);

        if entry.erroneous {
            return entry.error;
        }

        if entry.value.end {
            scanning = false;
        } else if !skip_directory(entry.value.name) {
            def copied: result<string> = strings.copy(&owner, entry.value.name);
            if copied.erroneous {
                return error("cannot retain directory entry name");
            }
            if !names.push(copied.value) {
                return error("cannot retain directory entry name");
            }
        }
    }

    def closed: result<void> = directory.close();
    if closed.erroneous { return closed.error; }

    sort_names(&names);

    for def mut index: i64 = 0; index < names.len(); index = index + 1 {
        scratch.reset();
        def name: *string         = names.get_mut(index);
        def child: result<string> = fs.join(&scratch, path, *name, 65536);

        if child.erroneous { return child.error; }

        def visited: result<void> = visit_path(child.value, changes, false, write, depth - 1);
        if visited.erroneous { return visited.error; }
    }

    return;
}

def main() -> i32 {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def count: u64 = process.arg_count();
    if count < 2 {
        report("usage: gloinfmt FILE | gloinfmt --check|--write [PATH ... | --git]");
        return 2;
    }

    def first: result<string> = process.arg(&owner, 1);
    if first.erroneous { return 2; }

    def mut changes: Counts = Counts { changed: 0 };

    def write: bool = strings.equal(first.value, "--write");

    if strings.equal(first.value, "--check") || write {
        for def mut index: u64 = 2; index < count; index = index + 1 {
            def argument: result<string> = process.arg(&owner, index);
            if argument.erroneous { return 2; }
            if strings.equal(argument.value, "--git") && count != 3 {
                report("--git cannot be combined with paths"); return 2;
            }
        }

        if count == 2 {
            def checked: result<void> = visit_path(".", &changes, true, write, 64);
            if checked.erroneous { report(checked.error.message); return 2; }
        } else {
            for def mut index: u64 = 2; index < count; index = index + 1 {
                def path: result<string> = process.arg(&owner, index);
                if path.erroneous { return 2; }

                if strings.equal(path.value, "--git") {
                    if count != 3 { report("--git cannot be combined with paths"); return 2; }

                    def discovered: result<vector.Vector<string>> = git.files(&owner);
                    if discovered.erroneous { report(discovered.error.message); return 2; }

                    def mut names: vector.Vector<string> = discovered.value;

                    sort_names(&names);

                    def mut previous: string = "";

                    for def mut item: i64 = 0; item < names.len(); item = item + 1 {
                        def name: string              = *names.get_mut(item);
                        def info: result<fs.Metadata> = fs.metadata(name);

                        if info.erroneous {
                            if info.error.code != status.NOT_FOUND {
                                report(name); report(info.error.message); return 2;
                            }
                        } else if info.value.kind == fs.FILE && !strings.equal(name, previous) {
                            def checked: result<void> = format_file(name, &changes, false, write);
                            if checked.erroneous { report(checked.error.message); return 2; }
                        }

                        previous = name;
                    }
                } else {
                    def checked: result<void> = visit_path(path.value, &changes, true, write, 64);
                    if checked.erroneous { report(path.value); report(checked.error.message); return 2; }
                }
            }
        }

        if !write && changes.changed > 0 { return 1; }

        return 0;
    }

    if count != 2 {
        report("usage: gloinfmt FILE | gloinfmt --check|--write [PATH ... | --git]");
        return 2;
    }

    def printed: result<void> = format_file(first.value, &changes, true, false);
    if printed.erroneous { report(printed.error.message); return 2; }

    return 0;
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}

// Report cleanup/diagnostic failures without recursively writing to a failed stream.
def report_io_failure(outcome: result<void>) -> void {
    if outcome.erroneous { std.println(outcome.error.message); }
}
