    def mut position: u64 = 0;

    while position < strings.byte_length(data) {
        def start: u64 = position;

        while common.byte(data, position) != 61 { position = position + 1; }

        def key: string = common.part(data, start, position);
        position = position + 1;

        def value: u64 = position;

        while common.byte(data, position) != 0 { position = position + 1; }
