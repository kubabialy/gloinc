// Bounded streaming unquoted comma-delimited statistics, not CSV.
// build/gloinc --jit examples/statistics_tool.gloin -- INPUT NEW_OUTPUT 1,2
import "@arena";
import "@io";
import "@process";
import "@std";
import "@strings";
import "@math";
import "@status";

def struct Column {
    def mut next: *Column,
    def index: u64,
    def mut count: u64,
    def mut minimum: f64,
    def mut maximum: f64,
    def mut mean: f64,

    // O(1), no allocation. Caller enforces <=1M rows and finite |value|<=1e12.
    def add(self: &Column, value: f64) -> void {
        if self.count == 0 {
            self.minimum = value;
            self.maximum = value;
        }

        self.minimum = math.min_f64(self.minimum, value);
        self.maximum = math.max_f64(self.maximum, value);
        self.count   = self.count + 1;

        // The caller limits count to one million, so rounded conversion is exact.
        def n: f64 = std.f64_from_u64_rounded(self.count);
        self.mean = self.mean + (value - self.mean) / n;
    }

}

def report_error(message: string, code: i32) -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut errors: io.Stream = io.stderr();

    report_io_failure(errors.write_line(message, &io_progress));
    report_io_failure(errors.flush());

    return code;
}

// O(decimal output bytes), arena-backed conversion. Every write's status is checked.
def integer(out: &io.File, scratch: &arena.GeneralArena, value: u64) -> bool {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def text: result<string> = std.format_u64(scratch, value);

    if text.erroneous { return false; }

    return io_succeeded(out.write_all(text.value, &io_progress));
}

def decimal(out: &io.File, scratch: &arena.GeneralArena, value: f64) -> bool {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def text: result<string> = std.format_f64_fixed(scratch, value, 6);

    if text.erroneous { return false; }

    return io_succeeded(out.write_all(text.value, &io_progress));
}

// Example: execute("points.txt","new-report.txt","1,2"). One pass over input.
// 1..16 distinct zero-based column indices <=63, <=64 fields, <=4096 bytes/line, <=1M rows.
// No header, quoting, escaping, blank rows or NUL; every row has the same width.
// Selected fields are trimmed finite numbers with |value|<=1e12; other fields are opaque bytes.
// O(input bytes * selected columns), O(selected columns + max line bytes) retained memory.
// Output is exclusively created AFTER valid input/close. On write/close failure a partial new file may remain.
// Return 0 success, 2 arguments/input, 3 allocation/report I/O. Existing destinations stay untouched.
def pub execute(input_path: string, output_path: string, columns: string) -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    def selection: result<strings.SplitCursor> = strings.SplitCursor.create(columns, ",");

    if selection.erroneous { return report_error("statistics: invalid columns", 2); }

    def mut choices: strings.SplitCursor = selection.value;
    def mut head: *Column                = null;
    def mut tail: *Column                = null;
    def mut selected: u64                = 0;
    def mut selecting: bool              = true;

    while selecting {
        def part: strings.TextItem = choices.next();

        if part.end {
            selecting = false;
        } else {
            def number: result<u64> = std.parse_u64(strings.trim_ascii(part.value));

            if number.erroneous { return report_error("statistics: invalid columns", 2); }

            def selected_index: u64 = number.value;
            if selected_index > 63
                || selected == 16 {
                return report_error("statistics: invalid columns", 2);
            }

            def mut prior: *Column = head;

            while prior != null {
                if prior.index == selected_index {
                    return report_error("statistics: duplicate column", 2);
                }

                prior = prior.next;
            }

            def node: *Column = owner.try_alloc(Column {
                next: null,
                index: selected_index,
                count: 0,
                minimum: 0.0,
                maximum: 0.0,
                mean: 0.0
            });

            if node == null { return report_error("statistics: allocation failed", 3); }

            if tail == null {
                head = node;
            } else {
                tail.next = node;
            }

            tail     = node;
            selected = selected + 1;
        }
    }

    if selected == 0 { return report_error("statistics: invalid columns", 2); }

    def opened: result<io.File> = io.File.open_read(&owner, input_path);
    if opened.erroneous { return report_error("statistics: cannot open input", 2); }

    def mut input: io.File = opened.value;
    defer close_file(&input);

    def mut rows: u64     = 0;
    def mut width: u64    = 0;
    def mut reading: bool = true;

    while reading {
        scratch.reset();
        def mut line: io.ReadState    = io.ReadState.empty();
        def line_result: result<void> = input.read_line(&scratch, 4096, &line);

        if line_result.erroneous {
            return report_error("statistics: read failed or line too long", 2);
        }

        if line.end {
            reading = false;
        } else {

            if rows == 1000000 { return report_error("statistics: row limit exceeded", 2); }

            if strings.is_empty(line.value)
                || strings.contains(line.value, "\"")
                || strings.contains(line.value, "\0") {
                return report_error("statistics: invalid row", 2);
            }

            def split: result<strings.SplitCursor> = strings.SplitCursor.create(line.value, ",");
            if split.erroneous { return report_error("statistics: invalid row", 2); }

            def mut fields: strings.SplitCursor = split.value;
            def mut index: u64                  = 0;
            def mut scanning: bool              = true;

            while scanning {
                def field: strings.TextItem = fields.next();

                if field.end {
                    scanning = false;
                } else {
                    if field.end || index == 64 {
                        return report_error("statistics: too many fields", 2);
                    }

                    def mut node: *Column = head;

                    while node != null {
                        if node.index == index {
                            def value: result<f64> = std.parse_f64(strings.trim_ascii(field.value));
                            if value.erroneous { return report_error("statistics: invalid number", 2); }
                            if value.value < -1000000000000.0
                                || value.value > 1000000000000.0 {
                                return report_error("statistics: invalid number", 2);
                            }

                            (&*node).add(value.value);
                        }

                        node = node.next;
                    }

                    index = index + 1;
                }
            }

            if rows == 0 { width = index; }
            if index != width { return report_error("statistics: inconsistent row width", 2); }

            def mut node: *Column = head;

            while node != null {
                if node.index >= width {
                    return report_error("statistics: missing column", 2);
                }

                node = node.next;
            }

            rows = rows + 1;
        }
    }

    if rows == 0 {
        return report_error("statistics: empty input", 2);
    }

    if !io_succeeded(input.close()) {
        return report_error("statistics: input close failed", 2);
    }

    def made: result<io.File> = io.File.create_new(&owner, output_path);

    if made.erroneous {
        return report_error("statistics: cannot create new output", 3);
    }

    def mut output: io.File = made.value;
    defer close_file(&output);

    if !io_succeeded(output.write_line("column,count,min,max,mean", &io_progress)) {
        return report_error("statistics: report write failed", 3);
    }

    def mut node: *Column = head;

    while node != null {
        scratch.reset();

        if !integer(&output, &scratch, node.index) || !io_succeeded(output.write_all(",", &io_progress))
            || !integer(&output, &scratch, node.count) || !io_succeeded(output.write_all(",", &io_progress))
            || !decimal(&output, &scratch, node.minimum) || !io_succeeded(output.write_all(",", &io_progress))
            || !decimal(&output, &scratch, node.maximum) || !io_succeeded(output.write_all(",", &io_progress))
            || !decimal(&output, &scratch, node.mean) || !io_succeeded(output.write_line("", &io_progress)) {
            return report_error("statistics: report write failed", 3);
        }

        node = node.next;
    }

    if !io_succeeded(output.flush()) {
        return report_error("statistics: report flush failed", 3);
    }
    if !io_succeeded(output.close()) {
        return report_error("statistics: report close failed", 3);
    }

    return 0;
}

def main() -> i32 {
    if process.arg_count() != 4 {
        return report_error("usage: statistics_tool INPUT NEW_OUTPUT COLUMNS", 2);
    }

    def mut arguments: arena.GeneralArena = arena.GeneralArena.create();
    defer arguments.free();

    def input: result<string> = process.arg(&arguments, 1);
    if input.erroneous {
        return report_error("statistics: arguments unavailable", 2);
    }

    def output: result<string> = process.arg(&arguments, 2);
    if output.erroneous {
        return report_error("statistics: arguments unavailable", 2);
    }

    def columns: result<string> = process.arg(&arguments, 3);

    if columns.erroneous {
        return report_error("statistics: arguments unavailable", 2);
    }

    return execute(input.value, output.value, columns.value);
}

// The owner must remain live until deferred cleanup has run.
def close_file(file: &io.File) -> void {
    if file.is_open() {
        def closed: result<void> = file.close();
        if closed.erroneous { std.println(closed.error.message); }
    }
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}

// Report cleanup/diagnostic failures without recursively writing to a failed stream.
def report_io_failure(outcome: result<void>) -> void {
    if outcome.erroneous { std.println(outcome.error.message); }
}
