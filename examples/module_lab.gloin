import "@arena";
import "@std";
import "./modules/world";
import "./modules/settings";

def const EXPECTED: i64 = settings.COUNT * (settings.COUNT - 1) / 2
+ settings.COUNT * settings.STEP;

def main() -> i32 {
    def mut memory: arena.GeneralArena = arena.GeneralArena.create();
    defer memory.free();
    for def mut round: i32 = 0; round < 3; round = round + 1 {
        if world.simulate(&memory) != EXPECTED { return 1; }
        memory.reset();
    }
    std.println("module lab: ok");
    return 0;
}
