import "@arena";
import "@std";
import "@status";
import "@strings";

// A configuration line is inspected without allocation. Only retaining its
// value in another arena allocates; parse_count never owns its borrowed input.
def parse_count(line: string) -> result<i32> {
    def text: string                  = strings.trim_ascii(line);
    def separator: strings.FindResult = strings.find(text, "=");

    if !separator.found {
        return error("invalid count configuration", status.INVALID, 0);
    }

    def left: result<string> = strings.slice_bytes(text, 0, separator.offset);
    if left.erroneous { return error("invalid count configuration", status.INVALID, 0); }

    def start: u64            = separator.offset + 1;
    def right: result<string> = strings.slice_bytes(text, start, strings.byte_length(text) - start);

    if right.erroneous {
        return error("invalid count configuration", status.INVALID, 0);
    }
    if !strings.equal(strings.trim_ascii(left.value), "count") {
        return error("invalid count configuration", status.INVALID, 0);
    }

    def number: result<i32> = std.to_int(strings.trim_ascii(right.value));
    if number.erroneous { return number.error; }

    return number.value;
}

def main() -> i32 {
    def mut input: arena.GeneralArena = arena.GeneralArena.create();
    defer input.free();

    def mut retained: arena.GeneralArena = arena.GeneralArena.create();
    defer retained.free();

    def line: result<string> = strings.copy(&input, " \tcount = 42\r\n");
    if line.erroneous { return 1; }

    def count: result<i32> = parse_count(line.value);
    if count.erroneous { return 2; }

    def expected: i32 = count.value;
    if expected != 42 { return 2; }

    def saved: result<string> = strings.copy(&retained, strings.trim_ascii(line.value));
    if saved.erroneous { return 3; }

    def retained_text: string = saved.value;

    input.reset(); // saved lives in retained; line and every view of it are now invalid.

    if !strings.equal(saved.value, "count = 42") { return 4; }

    // Exercise counted bytes and explicit failures: NUL is data, not the end.
    def nul: result<u8> = strings.byte_at_checked("a\0b", 1);
    if nul.erroneous { return 5; }

    def beyond: result<string> = strings.slice_bytes_checked("abc", 2, 18446744073709551615);
    if !beyond.erroneous { return 5; }

    def zero_byte: u8 = 0;
    if nul.value != zero_byte || !strings.equal(beyond.error.message, "string byte range is out of bounds") {
        return 5;
    }
    if strings.byte_length("café") != 5 || strings.is_empty(saved.value) { return 6; }
    if !strings.starts_with(saved.value, "count") || !strings.ends_with(saved.value, "42") {
        return 7;
    }
    if !strings.contains(saved.value, "=") || strings.compare("a", "ab") != -1 { return 8; }
    if !strings.equal(strings.trim_start_ascii(" x "), "x ") { return 9; }
    if !strings.equal(strings.trim_end_ascii(" x "), " x") { return 10; }

    def invalid: result<i32> = parse_count("missing separator");
    if !invalid.erroneous { return 11; }
    if invalid.error.code != status.INVALID { return 11; }

    // Reuse scratch storage over a long run; do not retain its borrowed views.
    for def mut i: i32 = 0; i < 10000; i = i + 1 {
        def scratch: result<string> = strings.copy(&input, " count = 42 ");
        if scratch.erroneous { return 12; }

        def parsed: result<i32> = parse_count(scratch.value);
        if parsed.erroneous { return 13; }
        if parsed.value != expected { return 13; }

        input.reset();
    }

    std.println(retained_text);
    std.println("strings lab: ok");

    return 0;
}
