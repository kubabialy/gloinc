// Reproducible Monte Carlo inputs and dice checksum; elapsed time measures the loop only.
// build/gloinc --jit examples/simulation_lab.gloin -- 42 10000
import "@random";
import "@time";
import "@math";
import "@std";
import "@arena";
import "@process";
import "@io";
import "@status";

def report_error(message: string) -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut errors: io.Stream = io.stderr();

    report_io_failure(errors.write_line(message, &io_progress));
    report_io_failure(errors.flush());

    return 2;
}

// O(decimal bytes), explicit arena-backed formatting; allocation/I/O failure is checked.
def integer(out: &io.Stream, scratch: &arena.GeneralArena, label: string, value: u64) -> bool {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def text: result<string> = std.format_u64(scratch, value);

    if text.erroneous { return false; }

    return io_succeeded(out.write_all(label, &io_progress)) && io_succeeded(out.write_line(text.value, &io_progress));
}

def decimal(out: &io.Stream, scratch: &arena.GeneralArena, label: string, value: f64) -> bool {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def text: result<string> = std.format_f64_fixed(scratch, value, 6);

    if text.erroneous { return false; }

    return io_succeeded(out.write_all(label, &io_progress)) && io_succeeded(out.write_line(text.value, &io_progress));
}

// Explicit seed/count entry for embedding or local-module composition. Same bounds and output as CLI.
// O(samples) expected work, constant storage; allocation belongs to report formatting only.
def pub simulate(seed: u64, samples: u64) -> i32 {
    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    if samples == 0 || samples > 1000000 { return report_error("samples must be in 1..1000000"); }

    def mut rng: random.SplitMix64  = random.SplitMix64.seeded(seed);
    def mut inside: u64             = 0;
    def mut dice_sum: u64           = 0;
    def start: result<time.Instant> = time.monotonic_now();

    if start.erroneous { return report_error("clock read failed"); }

    def started: time.Instant = start.value;

    for def mut i: u64 = 0; i < samples; i = i + 1 {
        def x: f64 = rng.unit_f64();
        def y: f64 = rng.unit_f64();

        if x*x + y*y <= 1.0 { inside = inside + 1; }

        def die: result<u64> = rng.below(6);
        if die.erroneous { return report_error(die.error.message); }

        dice_sum = dice_sum + die.value + 1;
    }

    def end: result<time.Instant> = time.monotonic_now();
    if end.erroneous { return report_error("clock read failed"); }

    def elapsed: result<time.Duration> = time.elapsed(started, end.value);
    if elapsed.erroneous { return report_error("clock moved backwards"); }

    def count: result<f64> = std.f64_from_u64_exact(samples);
    if count.erroneous { return report_error("count conversion failed"); }

    def hits: result<f64> = std.f64_from_u64_exact(inside);

    if hits.erroneous { return report_error("count conversion failed"); }

    def estimate: f64           = 4.0 * hits.value / count.value;
    def difference: result<f64> = math.abs_f64(estimate - math.PI_F64);

    if difference.erroneous { return report_error(difference.error.message); }

    def mut out: io.Stream = io.stdout();
    if !integer(&out, &scratch, "seed=", seed) || !integer(&out, &scratch, "samples=", samples)
        || !integer(&out, &scratch, "inside=", inside) || !integer(&out, &scratch, "dice_sum=", dice_sum)
        || !decimal(&out, &scratch, "pi=", estimate) || !decimal(&out, &scratch, "abs_error=", difference.value)
        || !integer(&out, &scratch, "elapsed_ns=", elapsed.value.nanoseconds) {
        return 3;
    }
    if !io_succeeded(out.flush()) { return 3; }

    return 0;
}

def main() -> i32 {
    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    def mut seed: u64    = 42;
    def mut samples: u64 = 10000;

    if process.arg_count() != 1 && process.arg_count() != 3 {
        return report_error("usage: [SEED SAMPLES], samples in 1..1000000");
    }

    if process.arg_count() == 3 {
        def first: result<string> = process.arg(&scratch, 1);
        if first.erroneous {
            return report_error("cannot read arguments");
        }

        def second: result<string> = process.arg(&scratch, 2);

        if second.erroneous {
            return report_error("cannot read arguments");
        }

        def parsed_seed: result<u64> = std.parse_u64(first.value);
        if parsed_seed.erroneous { return report_error("invalid seed or sample count"); }

        def parsed_samples: result<u64> = std.parse_u64(second.value);

        if parsed_samples.erroneous { return report_error("invalid seed or sample count"); }

        seed    = parsed_seed.value;
        samples = parsed_samples.value;
    }

    return simulate(seed, samples);
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}

// Report cleanup/diagnostic failures without recursively writing to a failed stream.
def report_io_failure(outcome: result<void>) -> void {
    if outcome.erroneous { std.println(outcome.error.message); }
}
