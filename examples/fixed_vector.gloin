import "@vector";

def main() -> i32 {
    def mut values: vector.Vector<i32;
    3> = vector.Vector<i32;
    3>.create(0);
    if !values.push(10) || !values.push(20) || !values.push(12) { return 1; }
    if values.push(99) { return 2; }
    if values.cap() != 3 || values.len() != 3 { return 3; }
    def second: *i32 = values.get_mut(1);
    if second == null { return 4; }
    *second = *second + 0;
    def first: *const i32 = values.get(0);
    def third: *const i32 = values.get(2);
    if first == null || third == null { return 5; }
    def live: [const i32] = values.as_const_slice();
    return live[0] + live[1] + live[2];
}
