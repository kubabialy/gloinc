// Trim ASCII whitespace, omit empty/comment lines, uppercase the rest.
// printf '  hello\r\n# comment\n world \n' | build/gloinc --jit examples/io_filter.gloin
// Lines are limited to 256 bytes; output and stderr are separate borrowed streams.
import "@std";
import "@io";
import "@arena";
import "@status";
import "@strings";

def main() -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    def mut input: io.Stream  = io.stdin();
    def mut output: io.Stream = io.stdout();
    def mut errors: io.Stream = io.stderr();
    def mut reading: bool     = true;

    while reading {
        scratch.reset();
        def mut line: io.ReadState    = io.ReadState.empty();
        def line_result: result<void> = input.read_line(&scratch, 256, &line);

        if line_result.erroneous {
            report_io_failure(errors.write_line("line read failed", &io_progress));
            report_io_failure(errors.flush());

            return 2;
        }

        if line.end {
            reading = false;
        } else {

            def trimmed: string = strings.trim_ascii(line.value);

            if !strings.is_empty(trimmed) && !strings.starts_with(trimmed, "#") {
                def upper: result<string> = strings.upper_ascii(&scratch, trimmed, 256);
                if upper.erroneous { return 3; }
                if !io_succeeded(output.write_line(upper.value, &io_progress)) { return 4; }
            }
        }
    }

    if !io_succeeded(output.flush()) { return 1; }

    return 0;
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}

// Report cleanup/diagnostic failures without recursively writing to a failed stream.
def report_io_failure(outcome: result<void>) -> void {
    if outcome.erroneous { std.println(outcome.error.message); }
}
