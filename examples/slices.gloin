def sum(values: [const i32]) -> i32 {
    def mut total: i32 = 0;
    def mut index: u64 = 0;
    while index < values.len {
        total = total + values[index];
        index = index + 1;
    }
    return total;
}

def main() -> i32 {
    def mut values: [i32; 4] = {1, 2, 3, 4};
    def middle: [i32] = values[1..3];
    middle[0] = 20;
    def tail: [const i32] = middle[1..];
    def one: u64 = 1;
    if tail.len != one { return 1; }
    return sum(values[..]);
}
