import "@arena";
import "./model";
import "./physics";
import "./settings";

def pub simulate(memory: &arena.GeneralArena) -> i64 {
    def mut head: *model.Particle = null;
    for def mut i: i64 = 0; i < settings.COUNT; i = i + 1 {
        head = memory.alloc(model.Particle {
            position: i,
            next: head
        });
    }
    def mut sum: i64 = 0;
    while head != null {
        physics.advance(&*head);
        sum = sum + head.position;
        head = head.next;
    }
    return sum;
}
