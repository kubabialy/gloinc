// Print the immediate names of a directory in host iteration order.
// build/gloinc --jit examples/directory_walk.gloin -- .
import "@arena";
import "@fs";
import "@process";
import "@status";
import "@std";

def close_if_open(directory: &fs.Directory) -> void {
    if directory.is_open() {
        def closed: result<void> = directory.close();
        if closed.erroneous { std.println(closed.error.message); }
    }
}

def main() -> i32 {
    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    if process.arg_count() != 2 {
        std.println("usage: directory_walk DIRECTORY");
        return 2;
    }

    def path: result<string> = process.arg(&owner, 1);
    if path.erroneous { return 1; }

    def opened: result<fs.Directory> = fs.Directory.open(&owner, path.value);
    if opened.erroneous {
        std.println("cannot open directory");
        return 1;
    }

    def mut directory: fs.Directory = opened.value;
    defer close_if_open(&directory);

    def mut scanning: bool = true;

    while scanning {
        scratch.reset();
        def entry: result<fs.DirectoryRead> = directory.next(&scratch);

        if entry.erroneous {
            std.println("directory read failed");
            return 1;
        }

        if entry.value.end {
            scanning = false;
        } else {
            std.println(entry.value.name);
        }
    }

    def closed: result<void> = directory.close();
    if closed.erroneous { std.println(closed.error.message); return 1; }

    return 0;
}
