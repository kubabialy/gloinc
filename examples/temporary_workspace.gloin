// Run with an EXISTING parent directory, for example: -- ./build
import "@arena";
import "@fs";
import "@io";
import "@process";
import "@status";
import "@std";

def remove_file(path: string) -> void {
    def removed: result<void> = fs.remove_file(path);
    if removed.erroneous { std.println(removed.error.message); }
}

def remove_directory(path: string) -> void {
    def removed: result<void> = fs.remove_dir(path);
    if removed.erroneous { std.println(removed.error.message); }
}

def close_file(file: &io.File) -> void {
    if file.is_open() { report_io_failure(file.close()); }
}

def main() -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    if process.arg_count() != 2 { std.println("Usage: temporary_workspace EXISTING_PARENT"); return 2; }

    def mut memory: arena.GeneralArena = arena.GeneralArena.create();
    defer memory.free();

    def parent: result<string> = process.arg(&memory, 1);
    if parent.erroneous { return 1; }

    def canonical: result<string> = fs.canonical_path(&memory, parent.value, 65536);
    if canonical.erroneous { std.println(canonical.error.message); return 1; }

    def made: result<string> = fs.temp_dir(&memory, canonical.value, "gloin-work", 65536);
    if made.erroneous { std.println(made.error.message); return 1; }
    // Defer runs in reverse order: close the file, unlink it, remove the empty
    // directory, then free the arena that owns all those path strings.
    defer remove_directory(made.value);

    std.println(made.value);

    def path: result<string> = fs.join(&memory, made.value, "message.txt", 65536);
    if path.erroneous { return 1; }

    def opened: result<io.File> = io.File.create_new(&memory, path.value);
    if opened.erroneous { return 1; }
    defer remove_file(path.value);

    def mut file: io.File = opened.value;
    defer close_file(&file);

    if !io_succeeded(file.write_all("Temporary work, explicitly cleaned up.\n", &io_progress)) { return 1; }
    if !io_succeeded(file.close()) { return 1; }

    return 0;
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}

// Report cleanup/diagnostic failures without recursively writing to a failed stream.
def report_io_failure(outcome: result<void>) -> void {
    if outcome.erroneous { std.println(outcome.error.message); }
}
