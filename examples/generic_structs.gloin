def struct Box<T> {
    def pub mut value: T,
}

def struct Pair<A, B> {
    def pub first: A,
    def pub second: B,
}

def main() -> i32 {
    def mut grid: [[i32; 100]; 100] = zeroed;
    grid[99][99] = 40;

    def boxed: Box<i32> = Box<i32> {
        value: grid[99][99]
    };
    def pair: Pair<Box<i32>,
    i32> = Pair<Box<i32>,
    i32> {
        first: boxed,
        second: 2,
    };
    return pair.first.value + pair.second;
}
