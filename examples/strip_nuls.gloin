// Copy a binary file to a NEW destination, removing NUL bytes.
// build/gloinc --jit examples/strip_nuls.gloin -- input.bin output.bin
// The destination may remain partial if a later read, write, or close fails.
import "@std";
import "@arena";
import "@io";
import "@process";
import "@status";
import "@vector";

def main() -> i32 {
    if process.arg_count() != 3 { return 1; }

    def mut owner: arena.GeneralArena = arena.GeneralArena.create();
    defer owner.free();

    def source: result<string> = process.arg(&owner, 1);
    if source.erroneous { return 2; }

    def target: result<string> = process.arg(&owner, 2);

    if target.erroneous { return 2; }

    def opened: result<io.File> = io.File.open_read(&owner, source.value);
    if opened.erroneous { return 3; }

    def mut reader: io.File = opened.value;
    defer close_file(&reader);

    def created: result<io.File> = io.File.create_new(&owner, target.value);
    if created.erroneous { return 4; }

    def mut writer: io.File = created.value;
    defer close_file(&writer);

    def mut input: [u8; 4096]           = zeroed;
    def mut filtered: vector.Vector<u8> = vector.Vector<u8>.empty(&owner, 4096);
    def zero: u8                        = 0;
    def mut reading: bool               = true;

    while reading {
        def mut chunk: io.ByteReadState = io.ByteReadState.empty();
        def chunk_result: result<void>  = reader.read_into(input[..], &chunk);

        if chunk_result.erroneous { return 5; }

        if chunk.end {
            reading = false;
        } else {

            filtered.clear();

            def mut index: u64 = 0;

            while index < chunk.read {
                if input[index] != zero && !filtered.push(input[index]) { return 6; }

                index = index + 1;
            }

            def mut written: io.WriteState   = io.WriteState.empty();
            def written_result: result<void> = writer.write_all_bytes(filtered.as_const_slice(), &written);

            if written_result.erroneous { return 7; }
        }
    }

    if !io_succeeded(writer.flush()) { return 8; }

    def output_close: result<void> = writer.close();
    if output_close.erroneous { return 9; }

    def input_close: result<void> = reader.close();

    if input_close.erroneous { return 9; }

    return 0;
}

// The owner must remain live until deferred cleanup has run.
def close_file(file: &io.File) -> void {
    if file.is_open() {
        def closed: result<void> = file.close();
        if closed.erroneous { std.println(closed.error.message); }
    }
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}
