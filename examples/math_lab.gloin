// Streaming radial statistics. Input: one bounded x,y pair per line, |x|,|y| <= 1e6.
// printf '3,4\n0,0\n6,8\n' | build/gloinc --jit examples/math_lab.gloin
import "@math";
import "@std";
import "@strings";
import "@arena";
import "@io";
import "@status";

def struct Statistics {
    def mut count: u64,
    def mut mean: f64,
    def mut m2: f64,
    def mut minimum: f64,
    def mut maximum: f64,

    // O(1), no allocation. Welford's population variance, at most one million samples.
    def add(self: &Statistics, value: f64) -> i32 {
        if self.count == 1000000 { return status.TOO_LONG; }

        def n: result<f64> = std.f64_from_u64_exact(self.count + 1);
        if n.erroneous { return n.error.code; }

        if self.count == 0 {
            self.minimum = value;
            self.maximum = value;
        }

        self.minimum = math.min_f64(self.minimum, value);
        self.maximum = math.max_f64(self.maximum, value);

        def delta: f64 = value - self.mean;
        self.mean  = self.mean + delta / n.value;
        self.m2    = self.m2 + delta * (value - self.mean);
        self.count = self.count + 1;

        return status.OK;
    }

}

def report_error(message: string) -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut stream: io.Stream = io.stderr();

    report_io_failure(stream.write_line(message, &io_progress));
    report_io_failure(stream.flush());

    return 2;
}

// Fixed precision is explicit; each result belongs to the supplied scratch arena.
def emit(output: &io.Stream, memory: &arena.GeneralArena, key: string, value: f64) -> bool {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def text: result<string> = std.format_f64_fixed(memory, value, 3);
    if text.erroneous { return false; }

    return io_succeeded(output.write_all(key, &io_progress)) && io_succeeded(output.write_line(text.value, &io_progress));
}

def main() -> i32 {
    def mut io_progress: io.WriteState = io.WriteState.empty();

    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    def mut input: io.Stream  = io.stdin();
    def mut output: io.Stream = io.stdout();
    def mut stats: Statistics = Statistics {
        count: 0,
        mean: 0.0,
        m2: 0.0,
        minimum: 0.0,
        maximum: 0.0
    };
    def mut last_angle: f64 = 0.0;
    def mut reading: bool   = true;

    while reading {
        scratch.reset();
        def mut line: io.ReadState    = io.ReadState.empty();
        def line_result: result<void> = input.read_line(&scratch, 256, &line);

        if line_result.erroneous {
            return report_error("input read failed or line exceeds 256 bytes");
        }

        if line.end {
            reading = false;
        } else {

            def split: result<strings.SplitCursor> = strings.SplitCursor.create(line.value, ",");
            if split.erroneous { return report_error("invalid point"); }

            def mut fields: strings.SplitCursor = split.value;
            def first: strings.TextItem         = fields.next();
            def second: strings.TextItem        = fields.next();

            if first.end
                || second.end
                || !fields.next().end {
                return report_error("invalid point");
            }

            def x: result<f64> = std.parse_f64(strings.trim_ascii(first.value));
            if x.erroneous { return report_error("invalid point"); }

            def y: result<f64> = std.parse_f64(strings.trim_ascii(second.value));

            if y.erroneous { return report_error("invalid point"); }

            def ax: result<f64> = math.abs_f64(x.value);
            if ax.erroneous { return report_error(ax.error.message); }

            def ay: result<f64> = math.abs_f64(y.value);
            if ay.erroneous { return report_error(ay.error.message); }
            if ax.value > 1000000.0 || ay.value > 1000000.0 {
                return report_error("invalid point");
            }

            def radius: result<f64> = math.hypot_f64(x.value, y.value);
            if radius.erroneous { return report_error(radius.error.message); }

            def angle: result<f64> = math.atan2_f64(y.value, x.value);
            if angle.erroneous { return report_error(angle.error.message); }
            if stats.add(radius.value) != status.OK {
                return report_error("statistics limit exceeded");
            }

            last_angle = angle.value;
        }
    }

    if stats.count == 0 { return report_error("expected x,y records"); }

    def n: result<f64> = std.f64_from_u64_exact(stats.count);
    if n.erroneous { return report_error("count conversion failed"); }

    // Roundoff can make accumulated variance slightly negative; explicitly clamp to zero.
    def spread: result<f64> = math.sqrt_f64(math.max_f64(0.0, stats.m2 / n.value));
    if spread.erroneous { return report_error(spread.error.message); }

    scratch.reset();
    def count: result<string> = std.format_u64(&scratch, stats.count);
    if count.erroneous { return 3; }
    if !io_succeeded(output.write_all("count=", &io_progress))
        || !io_succeeded(output.write_line(count.value, &io_progress)) {
        return 3;
    }
    if !emit(&output, &scratch, "min=", stats.minimum)
        || !emit(&output, &scratch, "max=", stats.maximum)
        || !emit(&output, &scratch, "mean=", stats.mean)
        || !emit(&output, &scratch, "stddev=", spread.value)
        || !emit(&output, &scratch, "last_angle=", last_angle) {
        return 3;
    }
    if !io_succeeded(output.flush()) { return 3; }

    return 0;
}

// These callers need success/failure only; transfer state retains partial progress.
def io_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}

// Report cleanup/diagnostic failures without recursively writing to a failed stream.
def report_io_failure(outcome: result<void>) -> void {
    if outcome.erroneous { std.println(outcome.error.message); }
}
