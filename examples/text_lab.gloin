import "@strings";
import "@status";
import "@arena";
import "@std";

// Turn borrowed configuration lines into a bounded escaped report. Scratch
// transformations expire each iteration; append copies them into the builder.
def main() -> i32 {
    def mut scratch: arena.GeneralArena = arena.GeneralArena.create();
    defer scratch.free();

    def mut storage: arena.GeneralArena = arena.GeneralArena.create();
    defer storage.free();

    def mut retained: arena.GeneralArena = arena.GeneralArena.create();
    defer retained.free();

    def made: result<strings.StringBuilder> = strings.StringBuilder.create(&storage, 128);
    if made.erroneous { return 1; }

    def mut report: strings.StringBuilder = made.value;
    def mut alias: strings.StringBuilder  = report;
    def mut lines: strings.LineCursor = strings.LineCursor.create(
        " name = Gloin & friends \r\n# ignored\n empty = \n count = 42\n");
    def mut line: strings.TextItem = lines.next();

    while !line.end {
        def text: string = strings.trim_ascii(line.value);

        if !strings.is_empty(text) && !strings.starts_with(text, "#") {
            def split: result<strings.SplitCursor> = strings.SplitCursor.create(text, "=");
            if split.erroneous { return 2; }

            def mut fields: strings.SplitCursor = split.value;
            def key: strings.TextItem           = fields.next();
            def value: strings.TextItem         = fields.next();
            def end: strings.TextItem           = fields.next();

            if key.end || value.end || !end.end {
                return 3;
            }

            def name: result<string> = strings.upper_ascii(&scratch, strings.trim_ascii(key.value), 32);
            if name.erroneous { return 4; }

            def escaped: result<string> = strings.replace_all(&scratch,
                strings.trim_ascii(value.value), "&", "&amp;", 64);
            if escaped.erroneous { return 4; }

            if !append_succeeded(alias.append(name.value)) || !append_succeeded(report.append("="))
                || !append_succeeded(report.append(escaped.value)) || !append_succeeded(alias.append_byte(10)) {
                return 5;
            }

            scratch.reset(); // Builder owns copies, so its report remains valid.
        }

        line = lines.next();
    }

    if !line.end { return 6; }

    def divider: result<string> = strings.repeat(&scratch, "-", 3, 3);
    if divider.erroneous { return 7; }

    def label: result<string> = strings.lower_ascii(&scratch, "DONE", 4);
    if label.erroneous { return 7; }

    def footer: result<string> = strings.concat(&scratch, divider.value, label.value, 7);
    if footer.erroneous { return 8; }
    if !append_succeeded(report.append(footer.value)) { return 8; }
    if report.byte_length() != alias.byte_length() || report.capacity() != 128 { return 9; }

    def saved: result<string> = report.to_string(&retained);
    if saved.erroneous { return 10; }

    alias.clear();

    if report.byte_length() != 0 || !append_succeeded(report.append("discarded")) { return 11; }

    storage.free(); // report and alias are invalid; saved lives in retained.
    std.println(saved.value);

    return 0;
}

// Keep append chains short-circuiting while explicitly handling every result.
def append_succeeded(outcome: result<void>) -> bool {
    if outcome.erroneous { return false; }

    return true;
}
