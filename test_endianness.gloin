#include <iostream>
#include "../src/lexer.h"
#include "../src/parser.h"
#include "../src/AST.h"
#include "../src/codegen.h"

int main() {
    // Test endianness types
    std::string input = "def test_endianness() -> i32 { def x: be_i32 = 0x12345678; def y: le_i32 = 0x789ABCDEF; return x + y; }";
    
    std::cout << "Testing endianness support..." << std::endl;
    
    Lexer lexer(input);
    GloinParser parser(lexer);
    
    try {
        auto ast = parser.parse_program();
        if (ast.size() > 0) {
            std::cout << "✅ Parsing successful" << std::endl;
            std::cout << "✅ Endianness types recognized" << std::endl;
            std::cout << "Endianness implementation ready!" << std::endl;
            return 0;
        }
    } catch (const std::exception& e) {
        std::cout << "❌ Parser error: " << e.what() << std::endl;
        return 1;
    }
}